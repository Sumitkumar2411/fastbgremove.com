---
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-zinc-200 dark:border-[#232326] bg-white dark:bg-[#0A0A0B] mt-24 sm:mt-32 transition-colors">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Col 1: Brand info -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2.5">
          <img src="/logo.svg" alt="fastbgremove.com Logo" class="h-6 w-auto object-contain" />
          <span class="font-bold text-base tracking-tight text-zinc-900 dark:text-white">fastbgremove.com</span>
        </div>
        <p class="text-sm text-zinc-500 dark:text-[#A7A7A7] leading-relaxed max-w-md">
          High-performance, 100% in-browser background removal. All neural segmentation models run directly on your device via WebAssembly. Your photos are never uploaded or stored on any server.
        </p>
      </div>

      <!-- Col 2: Utilities -->
      <div class="space-y-3">
        <h4 class="text-sm font-semibold text-zinc-900 dark:text-white">Tools</h4>
        <ul class="space-y-2 text-sm text-zinc-500 dark:text-[#A7A7A7]">
          <li>
            <a href="/passport-photo-white-background" class="hover:text-[#76B900] dark:hover:text-white transition-colors">
              Passport Photo Background
            </a>
          </li>
          <li>
            <a href="/transparent-signature-maker" class="hover:text-[#76B900] dark:hover:text-white transition-colors">
              Signature Maker
            </a>
          </li>
          <li>
            <a href="/remove-bg-alternative" class="hover:text-[#76B900] dark:hover:text-white transition-colors">
              Free Remove.bg Alternative
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Legal & Trust -->
      <div class="space-y-3">
        <h4 class="text-sm font-semibold text-zinc-900 dark:text-white">Privacy & Legal</h4>
        <ul class="space-y-2 text-sm text-zinc-500 dark:text-[#A7A7A7]">
          <li>
            <a href="/privacy" class="hover:text-[#76B900] dark:hover:text-white transition-colors">
              Privacy Guarantee
            </a>
          </li>
          <li>
            <a href="/terms" class="hover:text-[#76B900] dark:hover:text-white transition-colors">
              Terms of Service
            </a>
          </li>
          <li>
            <span class="text-[#76B900] font-semibold flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-[1px] bg-[#76B900]"></span>
              <span>100% Client-Side Private</span>
            </span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom line -->
    <div class="pt-8 border-t border-zinc-200 dark:border-[#232326] flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-zinc-500 dark:text-[#757575]">
      <p>© {currentYear} fastbgremove.com. Free Full HD background remover without watermarks.</p>
      <div class="flex items-center gap-4 text-xs font-medium text-zinc-400 dark:text-[#5E5E5E]">
        <span>WebAssembly Neural Engine</span>
        <span>•</span>
        <span>Zero Cloud Latency</span>
      </div>
    </div>
  </div>
</footer>
