---
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-[#e6e5e0] dark:border-[#2e2e33] bg-[#f7f7f4] dark:bg-[#121212] mt-20 sm:mt-32 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12 mb-12">
      <!-- Col 1: Brand & Isolation Tag -->
      <div class="space-y-4">
        <a href="/" class="flex items-center gap-2.5">
          <img 
            src="/logo.png" 
            alt="fastbgremove.com logo" 
            class="h-[38px] w-auto object-contain shrink-0" 
            style="height: 38px; width: auto; object-fit: contain;"
          />
          <span class="font-bold text-lg text-zinc-900 dark:text-white tracking-tight">fastbgremove.com</span>
        </a>
        <p class="text-sm text-[#5a5852] dark:text-[#a09c92] leading-relaxed">
          100% in-browser, zero-server image background removal. Privacy by isolation.
        </p>
        <div class="pt-1">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium bg-[#E5A93C]/10 text-[#b47818] dark:text-[#E5A93C] border border-[#E5A93C]/20 font-mono">
            <span class="w-1.5 h-1.5 rounded-full bg-[#E5A93C]"></span>
            <span>Client-Side WASM Isolation</span>
          </span>
        </div>
      </div>

      <!-- Col 2: Core Utilities -->
      <div class="space-y-3.5">
        <h4 class="text-sm font-semibold text-[#26251e] dark:text-white tracking-tight">Core Utilities</h4>
        <ul class="space-y-2.5 text-sm text-[#5a5852] dark:text-[#a09c92]">
          <li>
            <a href="/passport-photo-white-background" class="hover:text-[#b47818] dark:hover:text-[#E5A93C] transition-colors">
              Passport Photo Background Maker
            </a>
          </li>
          <li>
            <a href="/transparent-signature-maker" class="hover:text-[#b47818] dark:hover:text-[#E5A93C] transition-colors">
              Transparent Signature Maker
            </a>
          </li>
          <li>
            <a href="/remove-bg-alternative" class="hover:text-[#b47818] dark:hover:text-[#E5A93C] transition-colors">
              Remove.bg Migration Alternative
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Ecosystem / Media Utilities -->
      <div class="space-y-3.5">
        <h4 class="text-sm font-semibold text-[#26251e] dark:text-white tracking-tight">Ecosystem Utilities</h4>
        <ul class="space-y-2.5 text-sm text-[#5a5852] dark:text-[#a09c92]">
          <li>
            <a
              href="https://setimgkb.com"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 hover:text-[#b47818] dark:hover:text-[#E5A93C] transition-colors group"
            >
              <span>SetImgKB</span>
              <span class="text-xs text-[#807d72] dark:text-[#706e68]">(Image Compressor)</span>
              <svg class="w-3.5 h-3.5 opacity-50 group-hover:opacity-100 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </li>

        </ul>
      </div>

      <!-- Col 4: Legal & Support -->
      <div class="space-y-3.5">
        <h4 class="text-sm font-semibold text-[#26251e] dark:text-white tracking-tight">Legal & Support</h4>
        <ul class="space-y-2.5 text-sm text-[#5a5852] dark:text-[#a09c92]">
          <li>
            <a href="/about" class="hover:text-[#b47818] dark:hover:text-[#E5A93C] transition-colors">
              About Us
            </a>
          </li>
          <li>
            <a href="/contact" class="hover:text-[#b47818] dark:hover:text-[#E5A93C] transition-colors">
              Contact Support
            </a>
          </li>
          <li>
            <a href="/privacy" class="hover:text-[#b47818] dark:hover:text-[#E5A93C] transition-colors">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms" class="hover:text-[#b47818] dark:hover:text-[#E5A93C] transition-colors">
              Terms of Service
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-[#e6e5e0] dark:border-[#2e2e33] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#807d72] dark:text-[#706e68]">
      <p class="font-medium text-[#26251e] dark:text-[#ededed] text-center sm:text-left">
        © {currentYear} fastbgremove.com. Free in-browser utility. No accounts, zero tracking.
      </p>
      <div class="flex items-center gap-3 font-mono text-[11px] text-[#807d72] dark:text-[#706e68]">
        <span>WebAssembly Neural Engine</span>
        <span>•</span>
        <span>Zero Server Uploads</span>
      </div>
    </div>
  </div>
</footer>
