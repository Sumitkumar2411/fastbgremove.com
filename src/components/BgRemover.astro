---
interface Props {
  heading?: string;
  subheading?: string;
  defaultBg?: 'transparent' | 'white' | 'passport-blue';
}

const {
  heading = "Remove Background from Image",
  subheading = "100% automatic, in-browser background removal. No sign-up, no compression, and no watermarks.",
  defaultBg = "transparent"
} = Astro.props;
---

<section class="w-full flex flex-col items-center justify-center pt-2 sm:pt-4 pb-6" data-default-bg={defaultBg}>
  <!-- Desktop Hero Heading (Clean & Bold Nvidia Typography) -->
  <div class="text-center max-w-3xl mx-auto mb-6 sm:mb-8 space-y-2">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
      {heading}
    </h1>
    <p class="text-base sm:text-lg text-zinc-600 dark:text-[#A7A7A7] max-w-2xl mx-auto leading-relaxed">
      {subheading}
    </p>
  </div>

  <!-- Main Workspace (Desktop Grade Utility Card with 2px Angular Geometry) -->
  <div id="workspace-card" class="w-full max-w-5xl bg-white dark:bg-[#121214] border border-zinc-200 dark:border-[#232326] rounded-[2px] shadow-sm p-5 sm:p-7 relative transition-all">
    <!-- Nvidia Signature 12px Corner Square Motif -->
    <div class="absolute -top-[1px] -left-[1px] w-3 h-3 bg-[#76B900] z-20 pointer-events-none"></div>

    <!-- STATE 1: UPLOAD DROPZONE VIEW (HERO ELEMENT) -->
    <div id="upload-view" class="flex flex-col items-center justify-center">
      <div
        id="drop-zone"
        tabindex="0"
        role="button"
        aria-label="Upload image for background removal"
        class="w-full min-h-[440px] sm:min-h-[480px] border-2 border-dashed border-zinc-300 dark:border-[#2E2E32] hover:border-[#76B900] dark:hover:border-[#76B900] hover:bg-zinc-50/90 dark:hover:bg-[#1A1A1D] focus:border-[#76B900] focus:outline-none rounded-[2px] p-8 sm:p-14 flex flex-col items-center justify-center text-center cursor-pointer transition-all group shadow-xs relative"
      >
        <input type="file" id="file-input" accept="image/png, image/jpeg, image/webp" class="hidden" />

        <!-- Large Upload Icon with Nvidia Green Accent -->
        <div class="w-16 h-16 rounded-[2px] bg-[#76B900]/10 border border-[#76B900]/30 flex items-center justify-center text-[#76B900] group-hover:scale-105 transition-transform mb-6 shadow-xs">
          <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
        </div>

        <!-- Prominent Primary Callout -->
        <div class="space-y-2 mb-4">
          <p class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white">
            Drop your image here, or <span class="text-[#76B900] underline decoration-2 underline-offset-4 group-hover:text-[#5A8D00]">Browse</span>
          </p>
          <p class="text-sm sm:text-base text-zinc-500 dark:text-[#A7A7A7]">
            Supports PNG, JPG, WebP up to 25MB • Or paste directly with <kbd class="px-2 py-1 rounded-[2px] bg-zinc-100 dark:bg-[#1A1A1D] border border-zinc-200 dark:border-[#232326] text-xs font-mono text-zinc-700 dark:text-zinc-300 font-semibold">Ctrl+V</kbd>
          </p>
        </div>

        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-[2px] bg-[#76B900]/10 border border-[#76B900]/30 text-xs font-semibold text-[#76B900]">
          <span class="w-2 h-2 rounded-[1px] bg-[#76B900]"></span>
          <span>100% In-Browser & Private • Free Full Resolution</span>
        </div>
      </div>

      <!-- Sample Cards Row (Clickable 2px Angular Thumbnail Cards) -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3.5">
        <span class="text-sm font-medium text-zinc-500 dark:text-[#A7A7A7]">Try with a sample:</span>

        <button
          type="button"
          data-sample="/samples/portrait.jpg"
          class="sample-btn flex items-center gap-3 p-2 pr-4 rounded-[2px] bg-zinc-50 dark:bg-[#1A1A1D] border border-zinc-200 dark:border-[#232326] hover:border-[#76B900] hover:shadow-xs transition-all cursor-pointer group/card"
        >
          <img src="/samples/portrait.jpg" alt="Portrait Photo sample" class="w-10 h-10 rounded-[2px] object-cover group-hover/card:scale-105 transition-transform" />
          <div class="text-left">
            <div class="text-sm font-semibold text-zinc-800 dark:text-zinc-200 group-hover/card:text-[#76B900]">Portrait</div>
            <div class="text-xs text-zinc-500 dark:text-zinc-400">Headshot & People</div>
          </div>
        </button>

        <button
          type="button"
          data-sample="/samples/signature.jpg"
          class="sample-btn flex items-center gap-3 p-2 pr-4 rounded-[2px] bg-zinc-50 dark:bg-[#1A1A1D] border border-zinc-200 dark:border-[#232326] hover:border-[#76B900] hover:shadow-xs transition-all cursor-pointer group/card"
        >
          <img src="/samples/signature.jpg" alt="Signature sample" class="w-10 h-10 rounded-[2px] object-cover bg-white group-hover/card:scale-105 transition-transform" />
          <div class="text-left">
            <div class="text-sm font-semibold text-zinc-800 dark:text-zinc-200 group-hover/card:text-[#76B900]">Signature</div>
            <div class="text-xs text-zinc-500 dark:text-zinc-400">Ink & Documents</div>
          </div>
        </button>

        <button
          type="button"
          data-sample="/samples/product.jpg"
          class="sample-btn flex items-center gap-3 p-2 pr-4 rounded-[2px] bg-zinc-50 dark:bg-[#1A1A1D] border border-zinc-200 dark:border-[#232326] hover:border-[#76B900] hover:shadow-xs transition-all cursor-pointer group/card"
        >
          <img src="/samples/product.jpg" alt="Product sample" class="w-10 h-10 rounded-[2px] object-cover group-hover/card:scale-105 transition-transform" />
          <div class="text-left">
            <div class="text-sm font-semibold text-zinc-800 dark:text-zinc-200 group-hover/card:text-[#76B900]">Product</div>
            <div class="text-xs text-zinc-500 dark:text-zinc-400">Commercial Object</div>
          </div>
        </button>
      </div>
    </div>

    <!-- STATE 2: PROCESSING VIEW -->
    <div id="processing-view" class="hidden flex flex-col items-center justify-center min-h-[420px] p-8 text-center">
      <div class="w-12 h-12 rounded-full border-3 border-[#76B900]/20 border-t-[#76B900] animate-spin mb-5"></div>

      <div class="space-y-2 max-w-md w-full">
        <h3 id="processing-title" class="text-lg font-bold text-zinc-900 dark:text-white">
          Removing background locally...
        </h3>
        <p id="processing-subtitle" class="text-sm text-zinc-500 dark:text-[#A7A7A7]">
          Running in-browser WebAssembly neural engine...
        </p>

        <!-- Progress Bar with Nvidia Green Fill -->
        <div class="w-full bg-zinc-100 dark:bg-[#1A1A1D] border border-zinc-200 dark:border-[#232326] rounded-[2px] h-2 mt-4 overflow-hidden">
          <div id="progress-bar-fill" class="bg-[#76B900] h-full w-12 transition-all duration-200 rounded-[2px]"></div>
        </div>

        <p class="text-xs text-zinc-400 dark:text-[#757575] pt-2">
          Model weights are cached locally. Your image is never uploaded to any server.
        </p>
      </div>

      <button
        id="cancel-processing-btn"
        type="button"
        class="mt-6 text-sm font-medium text-zinc-500 hover:text-zinc-800 dark:text-zinc-400 dark:hover:text-white underline underline-offset-4 cursor-pointer"
      >
        Cancel
      </button>
    </div>

    <!-- STATE 3: RESULT VIEW (LARGE IMMERSIVE PREVIEW) -->
    <div id="result-view" class="hidden flex flex-col space-y-4">
      <!-- Toolbar Header: Tactile Desktop Controls -->
      <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-zinc-200 dark:border-[#232326]">
        <!-- Left: Image Resolution Badge -->
        <div class="flex items-center gap-2.5">
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-[2px] bg-[#76B900]/10 border border-[#76B900]/30 text-xs font-semibold text-[#76B900]">
            <span class="w-2 h-2 rounded-[1px] bg-[#76B900]"></span>
            <span id="meta-res-badge">HD READY</span>
          </span>
          <span id="meta-size-badge" class="text-xs font-medium text-zinc-500 dark:text-[#A7A7A7] hidden sm:inline-block"></span>
        </div>

        <!-- Right: Background Color Controls & Mode Toggles -->
        <div class="flex flex-wrap items-center gap-2.5">
          <!-- Background Color Segmented Pill -->
          <div class="flex items-center p-1 rounded-[2px] border border-zinc-200 dark:border-[#232326] bg-zinc-100 dark:bg-[#1A1A1D] gap-1 shadow-xs">
            <!-- Transparent Toggle -->
            <button
              id="bg-btn-transparent"
              type="button"
              title="Transparent Alpha Background"
              class="bg-color-btn active py-2 px-3.5 rounded-[2px] text-sm font-medium flex items-center gap-2 transition-all text-zinc-900 dark:text-white bg-white dark:bg-[#232326] shadow-xs cursor-pointer"
              data-bg="transparent"
            >
              <div class="w-4 h-4 rounded-[1px] bg-checkerboard-dense border border-zinc-300 dark:border-zinc-600"></div>
              <span>Transparent</span>
            </button>

            <!-- Pure White (#FFFFFF) -->
            <button
              id="bg-btn-white"
              type="button"
              title="Pure White (#FFFFFF)"
              class="bg-color-btn py-2 px-3.5 rounded-[2px] text-sm font-medium flex items-center gap-2 transition-all text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white cursor-pointer"
              data-bg="#FFFFFF"
            >
              <div class="w-4 h-4 rounded-[1px] bg-white border border-zinc-300"></div>
              <span>White</span>
            </button>

            <!-- Passport Blue (#0055A5) -->
            <button
              id="bg-btn-blue"
              type="button"
              title="Passport Blue (#0055A5)"
              class="bg-color-btn py-2 px-3.5 rounded-[2px] text-sm font-medium flex items-center gap-2 transition-all text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white cursor-pointer"
              data-bg="#0055A5"
            >
              <div class="w-4 h-4 rounded-[1px] bg-[#0055A5] border border-blue-400/40"></div>
              <span>Passport Blue</span>
            </button>

            <!-- Custom Color Picker -->
            <label
              title="Custom Color"
              class="relative flex items-center gap-2 py-2 px-3 rounded-[2px] text-sm font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white cursor-pointer"
            >
              <input type="color" id="custom-color-picker" value="#000000" class="sr-only" />
              <div id="custom-color-swatch" class="w-4 h-4 rounded-[1px] border border-zinc-300 dark:border-zinc-600 bg-black"></div>
              <span>Custom</span>
            </label>
          </div>

          <!-- View Mode Toggle: Layered vs Side-by-Side -->
          <div class="flex items-center p-1 rounded-[2px] border border-zinc-200 dark:border-[#232326] bg-zinc-100 dark:bg-[#1A1A1D] gap-1 shadow-xs">
            <button
              id="mode-layered-btn"
              type="button"
              class="py-2 px-3.5 rounded-[2px] bg-white dark:bg-[#232326] text-zinc-900 dark:text-white font-medium text-sm shadow-xs cursor-pointer"
            >
              Layered
            </button>
            <button
              id="mode-split-btn"
              type="button"
              class="py-2 px-3.5 rounded-[2px] text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white text-sm font-medium cursor-pointer"
            >
              Side-by-Side
            </button>
          </div>

          <!-- Hold for Original Compare Button -->
          <button
            id="compare-btn"
            type="button"
            title="Press and hold to view original image"
            class="py-2 px-3.5 rounded-[2px] border border-zinc-200 dark:border-[#232326] bg-white dark:bg-[#1A1A1D] text-sm font-medium text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white hover:border-[#76B900] active:bg-zinc-100 dark:active:bg-[#202025] select-none transition-all flex items-center gap-2 cursor-pointer shadow-xs"
          >
            <svg class="w-4 h-4 text-[#76B900]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
            <span>Hold for Original</span>
          </button>
        </div>
      </div>

      <!-- Large Immersive Preview Viewport -->
      <div
        id="preview-container"
        class="w-full relative min-h-[440px] sm:min-h-[500px] rounded-[2px] border border-zinc-200 dark:border-[#232326] flex items-center justify-center overflow-hidden bg-checkerboard transition-colors select-none p-4"
      >
        <!-- LAYERED VIEW STAGE -->
        <div id="layered-stage" class="w-full h-full relative flex items-center justify-center">
          <img
            id="preview-cutout-img"
            alt="Cutout preview"
            class="max-h-[420px] sm:max-h-[480px] w-auto max-w-full object-contain relative z-10 transition-opacity duration-100 drop-shadow-md"
          />
          <img
            id="preview-original-img"
            alt="Original uploaded image"
            class="max-h-[420px] sm:max-h-[480px] w-auto max-w-full object-contain absolute inset-0 m-auto z-10 opacity-0 pointer-events-none transition-opacity duration-100"
          />
        </div>

        <!-- SPLIT (SIDE-BY-SIDE) STAGE (Initially hidden) -->
        <div id="split-stage" class="hidden w-full h-full min-h-[440px] grid grid-cols-2 divide-x divide-zinc-200 dark:divide-[#232326]">
          <div class="relative flex flex-col items-center justify-center p-4 bg-zinc-50 dark:bg-[#0A0A0B]">
            <span class="absolute top-3 left-3 text-xs font-semibold text-zinc-600 dark:text-zinc-400 bg-white dark:bg-[#121214] px-2 py-1 rounded-[2px] border border-zinc-200 dark:border-[#232326] shadow-xs">ORIGINAL</span>
            <img
              id="split-original-img"
              alt="Original side preview"
              class="max-h-[400px] w-auto max-w-full object-contain"
            />
          </div>
          <div id="split-cutout-box" class="relative flex flex-col items-center justify-center p-4 bg-checkerboard transition-colors">
            <span class="absolute top-3 left-3 text-xs font-semibold text-[#76B900] bg-white dark:bg-[#121214] px-2 py-1 rounded-[2px] border border-zinc-200 dark:border-[#232326] shadow-xs">CUTOUT</span>
            <img
              id="split-cutout-img"
              alt="Cutout side preview"
              class="max-h-[400px] w-auto max-w-full object-contain"
            />
          </div>
        </div>
      </div>

      <!-- Action Bar: Prominent Primary Button & Secondary Actions -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-2">
        <!-- Left: Upload Another -->
        <button
          id="upload-another-btn"
          type="button"
          class="w-full sm:w-auto h-11 px-5 rounded-[2px] bg-zinc-100 dark:bg-[#1A1A1D] border border-zinc-200 dark:border-[#232326] hover:border-zinc-300 dark:hover:border-[#36363B] text-sm font-semibold text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white transition-all flex items-center justify-center gap-2 cursor-pointer shadow-xs"
        >
          <svg class="w-4 h-4 text-zinc-500 dark:text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
          <span>Select New Image</span>
        </button>

        <!-- Right: Copy & Primary Download HD -->
        <div class="w-full sm:w-auto flex items-center gap-3">
          <!-- Copy to Clipboard Button -->
          <button
            id="copy-clipboard-btn"
            type="button"
            class="flex-1 sm:flex-none h-11 px-5 rounded-[2px] bg-white dark:bg-[#1A1A1D] border border-zinc-200 dark:border-[#232326] hover:border-[#76B900] dark:hover:border-[#76B900] text-sm font-semibold text-zinc-800 dark:text-zinc-200 hover:bg-zinc-50 dark:hover:bg-[#202025] transition-all flex items-center justify-center gap-2 cursor-pointer shadow-xs"
            title="Copy cutout image to clipboard"
          >
            <svg class="w-4 h-4 text-[#76B900]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            <span id="copy-btn-text">Copy PNG</span>
          </button>

          <!-- Primary Hero Button: Download Full HD PNG (Nvidia Green CTA with Black Bold Text) -->
          <button
            id="download-hd-btn"
            type="button"
            class="flex-2 sm:flex-none h-11 px-8 rounded-[2px] bg-[#76B900] hover:bg-[#5A8D00] active:bg-[#4B7500] text-black text-base font-bold transition-all flex items-center justify-center gap-2.5 shadow-sm hover:shadow cursor-pointer active:scale-[0.99]"
          >
            <svg class="w-5 h-5 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <span>Download Full HD PNG</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Error Toast Box -->
    <div id="error-box" class="hidden mt-4 p-3 rounded-[2px] bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800/60 text-red-700 dark:text-red-200 text-sm font-medium flex items-center justify-between">
      <span id="error-message">Processing error.</span>
      <button id="close-error-btn" type="button" class="text-red-500 hover:text-red-700 dark:hover:text-red-200 ml-3">✕</button>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="paste-toast" class="fixed bottom-6 right-6 z-50 transform translate-y-12 opacity-0 pointer-events-none transition-all duration-200 bg-white dark:bg-[#1A1A1D] border border-zinc-200 dark:border-[#232326] text-zinc-900 dark:text-white px-4 py-2.5 rounded-[2px] shadow-xl flex items-center gap-2.5 text-sm font-medium">
    <span class="w-2 h-2 rounded-[1px] bg-[#76B900]"></span>
    <span id="paste-toast-text">Pasted image from clipboard</span>
  </div>
</section>

<script>
  import { createHdExportBlob, triggerDownload, copyImageToClipboard } from '../lib/canvasExport';

  // Global state
  let currentFile: File | Blob | null = null;
  let originalImageUrl: string | null = null;
  let cutoutBlob: Blob | null = null;
  let cutoutUrl: string | null = null;
  let currentBgColor: string = 'transparent';
  let imageNaturalWidth: number = 0;
  let imageNaturalHeight: number = 0;
  let isCancelled: boolean = false;
  let viewMode: 'layered' | 'split' = 'layered';

  // DOM Elements
  const sectionRoot = document.querySelector('section[data-default-bg]') as HTMLElement;
  const initialDefaultBg = sectionRoot?.dataset.defaultBg || 'transparent';

  const dropZone = document.getElementById('drop-zone') as HTMLElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const uploadView = document.getElementById('upload-view') as HTMLElement;
  const processingView = document.getElementById('processing-view') as HTMLElement;
  const resultView = document.getElementById('result-view') as HTMLElement;
  const errorBox = document.getElementById('error-box') as HTMLElement;
  const errorMessage = document.getElementById('error-message') as HTMLElement;
  const closeErrorBtn = document.getElementById('close-error-btn') as HTMLElement;
  const pasteToast = document.getElementById('paste-toast') as HTMLElement;
  const pasteToastText = document.getElementById('paste-toast-text') as HTMLElement;

  const processingTitle = document.getElementById('processing-title') as HTMLElement;
  const processingSubtitle = document.getElementById('processing-subtitle') as HTMLElement;
  const progressBarFill = document.getElementById('progress-bar-fill') as HTMLElement;
  const cancelProcessingBtn = document.getElementById('cancel-processing-btn') as HTMLElement;

  const previewContainer = document.getElementById('preview-container') as HTMLElement;
  const layeredStage = document.getElementById('layered-stage') as HTMLElement;
  const splitStage = document.getElementById('split-stage') as HTMLElement;
  const splitCutoutBox = document.getElementById('split-cutout-box') as HTMLElement;

  const previewCutoutImg = document.getElementById('preview-cutout-img') as HTMLImageElement;
  const previewOriginalImg = document.getElementById('preview-original-img') as HTMLImageElement;
  const splitOriginalImg = document.getElementById('split-original-img') as HTMLImageElement;
  const splitCutoutImg = document.getElementById('split-cutout-img') as HTMLImageElement;

  const metaResBadge = document.getElementById('meta-res-badge') as HTMLElement;
  const metaSizeBadge = document.getElementById('meta-size-badge') as HTMLElement;

  const bgBtnTransparent = document.getElementById('bg-btn-transparent') as HTMLButtonElement;
  const bgBtnWhite = document.getElementById('bg-btn-white') as HTMLButtonElement;
  const bgBtnBlue = document.getElementById('bg-btn-blue') as HTMLButtonElement;
  const customColorPicker = document.getElementById('custom-color-picker') as HTMLInputElement;
  const customColorSwatch = document.getElementById('custom-color-swatch') as HTMLElement;

  const modeLayeredBtn = document.getElementById('mode-layered-btn') as HTMLButtonElement;
  const modeSplitBtn = document.getElementById('mode-split-btn') as HTMLButtonElement;
  const compareBtn = document.getElementById('compare-btn') as HTMLButtonElement;

  const uploadAnotherBtn = document.getElementById('upload-another-btn') as HTMLButtonElement;
  const copyClipboardBtn = document.getElementById('copy-clipboard-btn') as HTMLButtonElement;
  const copyBtnText = document.getElementById('copy-btn-text') as HTMLElement;
  const downloadHdBtn = document.getElementById('download-hd-btn') as HTMLButtonElement;

  // Setup initial color mode based on page prop
  if (initialDefaultBg === 'white') {
    currentBgColor = '#FFFFFF';
  } else if (initialDefaultBg === 'passport-blue') {
    currentBgColor = '#0055A5';
  } else {
    currentBgColor = 'transparent';
  }

  function applyBgToElements(color: string) {
    const isTrans = color === 'transparent';
    const isWhite = color.toUpperCase() === '#FFFFFF';
    const isBlue = color.toUpperCase() === '#0055A5';

    // Update buttons
    const activeClasses = ['active', 'bg-white', 'dark:bg-[#232326]', 'text-zinc-900', 'dark:text-white', 'shadow-xs'];
    const inactiveClasses = ['text-zinc-600', 'dark:text-zinc-400'];

    [bgBtnTransparent, bgBtnWhite, bgBtnBlue].forEach(b => {
      b.classList.remove(...activeClasses);
      b.classList.add(...inactiveClasses);
    });

    if (isTrans) {
      bgBtnTransparent.classList.add(...activeClasses);
      bgBtnTransparent.classList.remove(...inactiveClasses);
    } else if (isWhite) {
      bgBtnWhite.classList.add(...activeClasses);
      bgBtnWhite.classList.remove(...inactiveClasses);
    } else if (isBlue) {
      bgBtnBlue.classList.add(...activeClasses);
      bgBtnBlue.classList.remove(...inactiveClasses);
    }

    // Apply background to preview containers
    if (isTrans) {
      previewContainer.className = 'w-full relative min-h-[440px] sm:min-h-[500px] rounded-[2px] border border-zinc-200 dark:border-[#232326] flex items-center justify-center overflow-hidden bg-checkerboard transition-colors select-none p-4';
      previewContainer.style.backgroundColor = '';
      if (splitCutoutBox) {
        splitCutoutBox.className = 'relative flex flex-col items-center justify-center p-4 bg-checkerboard transition-colors';
        splitCutoutBox.style.backgroundColor = '';
      }
    } else {
      previewContainer.className = 'w-full relative min-h-[440px] sm:min-h-[500px] rounded-[2px] border border-zinc-200 dark:border-[#232326] flex items-center justify-center overflow-hidden transition-colors select-none p-4';
      previewContainer.style.backgroundColor = color;
      if (splitCutoutBox) {
        splitCutoutBox.className = 'relative flex flex-col items-center justify-center p-4 transition-colors';
        splitCutoutBox.style.backgroundColor = color;
      }
      customColorSwatch.style.backgroundColor = color;
    }
  }

  function setViewMode(mode: 'layered' | 'split') {
    viewMode = mode;
    const activeClasses = ['bg-white', 'dark:bg-[#232326]', 'text-zinc-900', 'dark:text-white', 'shadow-xs'];
    const inactiveClasses = ['text-zinc-600', 'dark:text-zinc-400'];

    if (mode === 'layered') {
      modeLayeredBtn.classList.add(...activeClasses);
      modeLayeredBtn.classList.remove(...inactiveClasses);
      modeSplitBtn.classList.remove(...activeClasses);
      modeSplitBtn.classList.add(...inactiveClasses);
      layeredStage.classList.remove('hidden');
      splitStage.classList.add('hidden');
      compareBtn.classList.remove('hidden');
    } else {
      modeSplitBtn.classList.add(...activeClasses);
      modeSplitBtn.classList.remove(...inactiveClasses);
      modeLayeredBtn.classList.remove(...activeClasses);
      modeLayeredBtn.classList.add(...inactiveClasses);
      layeredStage.classList.add('hidden');
      splitStage.classList.remove('hidden');
      compareBtn.classList.add('hidden');
    }
  }

  modeLayeredBtn.addEventListener('click', () => setViewMode('layered'));
  modeSplitBtn.addEventListener('click', () => setViewMode('split'));

  function showToast(text: string) {
    if (!pasteToast) return;
    pasteToastText.textContent = text;
    pasteToast.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
    pasteToast.classList.add('translate-y-0', 'opacity-100');
    setTimeout(() => {
      pasteToast.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
      pasteToast.classList.remove('translate-y-0', 'opacity-100');
    }, 2500);
  }

  function showError(msg: string) {
    if (errorBox && errorMessage) {
      errorMessage.textContent = msg;
      errorBox.classList.remove('hidden');
    }
  }

  function clearError() {
    if (errorBox) {
      errorBox.classList.add('hidden');
    }
  }

  if (closeErrorBtn) {
    closeErrorBtn.addEventListener('click', clearError);
  }

  function switchView(view: 'upload' | 'processing' | 'result') {
    clearError();
    uploadView.classList.add('hidden');
    processingView.classList.add('hidden');
    resultView.classList.add('hidden');

    if (view === 'upload') {
      uploadView.classList.remove('hidden');
    } else if (view === 'processing') {
      processingView.classList.remove('hidden');
    } else if (view === 'result') {
      resultView.classList.remove('hidden');
    }
  }

  function resetAll() {
    isCancelled = true;
    currentFile = null;
    if (originalImageUrl) {
      URL.revokeObjectURL(originalImageUrl);
      originalImageUrl = null;
    }
    if (cutoutUrl) {
      URL.revokeObjectURL(cutoutUrl);
      cutoutUrl = null;
    }
    cutoutBlob = null;
    fileInput.value = '';
    switchView('upload');
  }

  uploadAnotherBtn.addEventListener('click', resetAll);
  cancelProcessingBtn.addEventListener('click', resetAll);

  // Background toggle clicks
  bgBtnTransparent.addEventListener('click', () => {
    currentBgColor = 'transparent';
    applyBgToElements(currentBgColor);
  });

  bgBtnWhite.addEventListener('click', () => {
    currentBgColor = '#FFFFFF';
    applyBgToElements(currentBgColor);
  });

  bgBtnBlue.addEventListener('click', () => {
    currentBgColor = '#0055A5';
    applyBgToElements(currentBgColor);
  });

  customColorPicker.addEventListener('input', (e) => {
    const val = (e.target as HTMLInputElement).value;
    currentBgColor = val;
    applyBgToElements(currentBgColor);
  });

  // Compare mode: Hold for original
  function showOriginal() {
    previewOriginalImg.classList.remove('opacity-0', 'pointer-events-none');
    previewOriginalImg.classList.add('opacity-100');
    previewCutoutImg.classList.add('opacity-0');
  }

  function showCutout() {
    previewOriginalImg.classList.add('opacity-0', 'pointer-events-none');
    previewOriginalImg.classList.remove('opacity-100');
    previewCutoutImg.classList.remove('opacity-0');
  }

  compareBtn.addEventListener('mousedown', showOriginal);
  compareBtn.addEventListener('mouseup', showCutout);
  compareBtn.addEventListener('mouseleave', showCutout);
  compareBtn.addEventListener('touchstart', (e) => { e.preventDefault(); showOriginal(); });
  compareBtn.addEventListener('touchend', (e) => { e.preventDefault(); showCutout(); });

  // Core Processing Routine
  async function processImage(file: File | Blob) {
    try {
      isCancelled = false;
      currentFile = file;
      clearError();

      if (file.size > 25 * 1024 * 1024) {
        showError('Image exceeds 25MB limit. Please choose a smaller file.');
        return;
      }

      if (originalImageUrl) URL.revokeObjectURL(originalImageUrl);
      originalImageUrl = URL.createObjectURL(file);
      previewOriginalImg.src = originalImageUrl;
      splitOriginalImg.src = originalImageUrl;

      const imgProbe = new Image();
      imgProbe.src = originalImageUrl;
      await new Promise((resolve) => {
        imgProbe.onload = () => {
          imageNaturalWidth = imgProbe.naturalWidth;
          imageNaturalHeight = imgProbe.naturalHeight;
          resolve(null);
        };
        imgProbe.onerror = () => resolve(null);
      });

      switchView('processing');
      progressBarFill.style.width = '15%';
      processingTitle.textContent = 'Initializing in-browser neural engine...';
      processingSubtitle.textContent = 'Loading WebAssembly runtime...';

      const { removeBackground } = await import('@imgly/background-removal');

      if (isCancelled) return;

      progressBarFill.style.width = '35%';
      processingTitle.textContent = 'Segmenting foreground...';
      processingSubtitle.textContent = 'Calculating pixel contours in browser RAM...';

      const resultBlob = await removeBackground(file, {
        progress: (key: string, current: number, total: number) => {
          if (isCancelled) return;
          if (total > 0) {
            const pct = Math.min(95, Math.round((current / total) * 100));
            progressBarFill.style.width = `${Math.max(35, pct)}%`;
          }
          if (key.includes('fetch')) {
            processingSubtitle.textContent = 'Caching model weights locally in browser (~20MB)...';
          } else if (key.includes('compute')) {
            processingSubtitle.textContent = 'Executing inference via WebAssembly...';
          }
        },
        model: 'medium',
        output: {
          format: 'image/png',
          quality: 1.0,
          type: 'foreground'
        }
      });

      if (isCancelled) return;

      progressBarFill.style.width = '100%';
      processingTitle.textContent = 'Compositing full HD PNG...';

      cutoutBlob = resultBlob;
      if (cutoutUrl) URL.revokeObjectURL(cutoutUrl);
      cutoutUrl = URL.createObjectURL(resultBlob);

      previewCutoutImg.src = cutoutUrl;
      splitCutoutImg.src = cutoutUrl;

      if (imageNaturalWidth && imageNaturalHeight) {
        metaResBadge.textContent = `${imageNaturalWidth} × ${imageNaturalHeight} PX HD`;
      } else {
        metaResBadge.textContent = 'FULL RESOLUTION HD';
      }

      const mbSize = (resultBlob.size / (1024 * 1024)).toFixed(2);
      metaSizeBadge.textContent = `${mbSize} MB PNG`;

      applyBgToElements(currentBgColor);

      setTimeout(() => {
        if (!isCancelled) {
          switchView('result');
        }
      }, 200);

    } catch (err: any) {
      console.error('Background removal error:', err);
      if (!isCancelled) {
        switchView('upload');
        showError(err?.message || 'Processing failed. Please check your image format.');
      }
    }
  }

  dropZone.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput.click();
    }
  });

  fileInput.addEventListener('change', () => {
    if (fileInput.files && fileInput.files[0]) {
      processImage(fileInput.files[0]);
    }
  });

  ['dragenter', 'dragover'].forEach(eventName => {
    dropZone.addEventListener(eventName, (e) => {
      e.preventDefault();
      e.stopPropagation();
      dropZone.classList.add('border-[#76B900]', 'bg-[#76B900]/5', 'dark:bg-[#76B900]/10');
    }, false);
  });

  ['dragleave', 'drop'].forEach(eventName => {
    dropZone.addEventListener(eventName, (e) => {
      e.preventDefault();
      e.stopPropagation();
      dropZone.classList.remove('border-[#76B900]', 'bg-[#76B900]/5', 'dark:bg-[#76B900]/10');
    }, false);
  });

  dropZone.addEventListener('drop', (e) => {
    const dt = e.dataTransfer;
    if (dt && dt.files && dt.files[0]) {
      const file = dt.files[0];
      if (file.type.startsWith('image/')) {
        processImage(file);
      } else {
        showError('Please drop a valid image (PNG, JPG, or WebP).');
      }
    }
  });

  window.addEventListener('paste', (e) => {
    const clipboardData = e.clipboardData;
    if (!clipboardData) return;

    const items = clipboardData.items;
    for (let i = 0; i < items.length; i++) {
      if (items[i].type.indexOf('image') !== -1) {
        const file = items[i].getAsFile();
        if (file) {
          showToast('Image pasted from clipboard');
          processImage(file);
          break;
        }
      }
    }
  });

  const sampleButtons = document.querySelectorAll('.sample-btn');
  sampleButtons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const sampleUrl = btn.getAttribute('data-sample');
      if (!sampleUrl) return;

      try {
        switchView('processing');
        processingTitle.textContent = 'Loading sample image...';
        progressBarFill.style.width = '10%';

        const response = await fetch(sampleUrl);
        if (!response.ok) throw new Error('Could not load sample');
        const blob = await response.blob();
        await processImage(blob);
      } catch (err: any) {
        switchView('upload');
        showError('Failed to load sample: ' + err.message);
      }
    });
  });

  downloadHdBtn.addEventListener('click', async () => {
    if (!cutoutBlob) return;
    try {
      downloadHdBtn.disabled = true;
      downloadHdBtn.classList.add('opacity-75');

      const originalName = currentFile instanceof File ? currentFile.name.replace(/\.[^/.]+$/, "") : 'cutout';
      const filename = `${originalName}-fastbgremove-hd.png`;

      const finalBlob = await createHdExportBlob(cutoutBlob, currentBgColor);
      triggerDownload(finalBlob, filename);
      showToast('Download started');
    } catch (err) {
      console.error('Export download error:', err);
      showError('Failed to export HD PNG.');
    } finally {
      downloadHdBtn.disabled = false;
      downloadHdBtn.classList.remove('opacity-75');
    }
  });

  copyClipboardBtn.addEventListener('click', async () => {
    if (!cutoutBlob) return;
    try {
      copyClipboardBtn.disabled = true;
      const originalText = copyBtnText.textContent;
      copyBtnText.textContent = 'Copying...';

      const finalBlob = await createHdExportBlob(cutoutBlob, currentBgColor);
      const success = await copyImageToClipboard(finalBlob);

      if (success) {
        copyBtnText.textContent = 'Copied!';
        showToast('Cutout copied to clipboard');
        setTimeout(() => {
          copyBtnText.textContent = originalText;
          copyClipboardBtn.disabled = false;
        }, 2000);
      } else {
        copyBtnText.textContent = 'Failed';
        showError('Clipboard copy is not supported in this browser.');
        setTimeout(() => {
          copyBtnText.textContent = originalText;
          copyClipboardBtn.disabled = false;
        }, 2000);
      }
    } catch (err) {
      console.error('Clipboard copy error:', err);
      copyClipboardBtn.disabled = false;
    }
  });
</script>
