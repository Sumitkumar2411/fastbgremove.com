  // 60FPS Interactive Before/After Split Slider Drag Logic (Pointer Events API)
  let isDraggingSlider = false;
  let pendingSliderPos: number | null = null;
  let rafId: number | null = null;

  function updateSliderFromClientX(clientX: number) {
    if (!stageBox) return;
    const rect = stageBox.getBoundingClientRect();
    if (rect.width <= 0) return;
    const rawPct = ((clientX - rect.left) / rect.width) * 100;
    pendingSliderPos = Math.max(0, Math.min(100, rawPct));

    if (rafId === null) {
      rafId = requestAnimationFrame(() => {
        if (pendingSliderPos !== null && stageBox) {
          stageBox.style.setProperty('--slider-pos', `${pendingSliderPos.toFixed(2)}%`);
        }
        rafId = null;
      });
    }
  }

  function updateStickerTextFromClient(clientX: number, clientY: number) {
    const targetElement = stickerCanvas && !stickerCanvas.classList.contains('hidden') ? stickerCanvas : stageBox;
    if (!targetElement) return;
    const rect = targetElement.getBoundingClientRect();
    if (rect.width <= 0 || rect.height <= 0) return;

    const rawX = (clientX - rect.left) / rect.width;
    const rawY = (clientY - rect.top) / rect.height;

    stickerTextNormX = Math.max(0.06, Math.min(0.94, rawX));
    stickerTextNormY = Math.max(0.06, Math.min(0.96, rawY));
    scheduleStickerRender();
  }

  function getNormalizedPointerCoords(clientX: number, clientY: number): { normX: number; normY: number } | null {
    const targetElement = stickerCanvas && !stickerCanvas.classList.contains('hidden') ? stickerCanvas : stageBox;
    if (!targetElement) return null;
    const rect = targetElement.getBoundingClientRect();
    if (rect.width <= 0 || rect.height <= 0) return null;
    return {
      normX: (clientX - rect.left) / rect.width,
      normY: (clientY - rect.top) / rect.height
    };
  }

  function checkPointerOverStickerText(clientX: number, clientY: number): boolean {
    if (!isStickerCaptionActive || !stickerCaptionText.trim() || !imageNaturalWidth || !imageNaturalHeight) {
      return false;
    }
    const coords = getNormalizedPointerCoords(clientX, clientY);
    if (!coords) return false;
    return computeTextHitTest(imageNaturalWidth, imageNaturalHeight, coords.normX, coords.normY, {
      text: stickerCaptionText,
      normX: stickerTextNormX,
      normY: stickerTextNormY,
      fontSize: stickerFontSize,
      isBold: stickerIsBold
    });
  }

  function onPointerDown(e: PointerEvent) {
    if (isBrushModeActive) return;
    if (currentBgTab === 'sticker') {
      if (isStickerCaptionActive && stickerCaptionText.trim()) {
        const isOver = checkPointerOverStickerText(e.clientX, e.clientY);
        if (isOver) {
          isDraggingStickerText = true;
          if (stageBox) stageBox.style.cursor = 'move';
          if (stickerCanvas) stickerCanvas.style.cursor = 'move';
          try {
            (e.currentTarget as HTMLElement)?.setPointerCapture?.(e.pointerId);
          } catch (_) {}
          updateStickerTextFromClient(e.clientX, e.clientY);
          scheduleStickerRender();
          return;
        }
      }

      if (currentStickerShape !== 'die-cut') {
        isPanning = true;
        startX = e.clientX - panX;
        startY = e.clientY - panY;
        if (stageBox) stageBox.style.cursor = 'grabbing';
        if (stickerCanvas) stickerCanvas.style.cursor = 'grabbing';
        try {
          (e.currentTarget as HTMLElement)?.setPointerCapture?.(e.pointerId);
        } catch (_) {}
      }
      return;
    }
    isDraggingSlider = true;
    try {
      (e.currentTarget as HTMLElement)?.setPointerCapture?.(e.pointerId);
    } catch (_) {}
    updateSliderFromClientX(e.clientX);
  }

  function onPointerMove(e: PointerEvent) {
    if (isBrushModeActive) return;
    if (currentBgTab === 'sticker') {
      if (isDraggingStickerText && isStickerCaptionActive) {
        if (stageBox) stageBox.style.cursor = 'move';
        if (stickerCanvas) stickerCanvas.style.cursor = 'move';
        updateStickerTextFromClient(e.clientX, e.clientY);
        return;
      }
      if (isPanning && currentStickerShape !== 'die-cut') {
        panX = e.clientX - startX;
        panY = e.clientY - startY;
        if (stageBox) stageBox.style.cursor = 'grabbing';
        if (stickerCanvas) stickerCanvas.style.cursor = 'grabbing';
        scheduleStickerRender();
        return;
      }
      if (isStickerCaptionActive && stickerCaptionText.trim()) {
        const isOver = checkPointerOverStickerText(e.clientX, e.clientY);
        if (isOver !== isPointerOverStickerText) {
          isPointerOverStickerText = isOver;
          updateCanvasCursor();
          scheduleStickerRender();
        }
      } else {
        if (isPointerOverStickerText) {
          isPointerOverStickerText = false;
          updateCanvasCursor();
          scheduleStickerRender();
        } else {
          updateCanvasCursor();
        }
      }
      return;
    }
    if (!isDraggingSlider) return;
    updateSliderFromClientX(e.clientX);
  }

  function onPointerUp(e: PointerEvent) {
    if (isDraggingStickerText) {
      isDraggingStickerText = false;
      try {
        (e.currentTarget as HTMLElement)?.releasePointerCapture?.(e.pointerId);
      } catch (_) {}
      updateCanvasCursor();
      scheduleStickerRender();
    }
    if (isPanning) {
      isPanning = false;
      try {
        (e.currentTarget as HTMLElement)?.releasePointerCapture?.(e.pointerId);
      } catch (_) {}
      updateCanvasCursor();
      scheduleStickerRender();
    }
    if (isDraggingSlider) {
      isDraggingSlider = false;
      try {
        (e.currentTarget as HTMLElement)?.releasePointerCapture?.(e.pointerId);
      } catch (_) {}
    }
  }

  // Touch Event Handlers for Thumb Dragging on Mobile Devices
  function onTouchStart(e: TouchEvent) {
    if (isBrushModeActive) return;
    if (e.touches && e.touches.length > 0) {
      if (currentBgTab === 'sticker') {
        const touch = e.touches[0];
        if (isStickerCaptionActive && stickerCaptionText.trim()) {
          const isOver = checkPointerOverStickerText(touch.clientX, touch.clientY);
          if (isOver) {
            isDraggingStickerText = true;
            if (e.cancelable) e.preventDefault();
            updateStickerTextFromClient(touch.clientX, touch.clientY);
            scheduleStickerRender();
            return;
          }
        }
        if (currentStickerShape !== 'die-cut') {
          isPanning = true;
          startX = touch.clientX - panX;
          startY = touch.clientY - panY;
          if (e.cancelable) e.preventDefault();
        }
        return;
      }
      isDraggingSlider = true;
      updateSliderFromClientX(e.touches[0].clientX);
    }
  }

  function onTouchMove(e: TouchEvent) {
    if (isBrushModeActive) return;
    if (e.touches && e.touches.length > 0) {
      if (currentBgTab === 'sticker') {
        const touch = e.touches[0];
        if (isDraggingStickerText && isStickerCaptionActive) {
          if (e.cancelable) e.preventDefault();
          updateStickerTextFromClient(touch.clientX, touch.clientY);
          return;
        }
        if (isPanning && currentStickerShape !== 'die-cut') {
          if (e.cancelable) e.preventDefault();
          panX = touch.clientX - startX;
          panY = touch.clientY - startY;
          scheduleStickerRender();
          return;
        }
        return;
      }
      if (!isDraggingSlider) return;
      if (e.cancelable) e.preventDefault();
      updateSliderFromClientX(e.touches[0].clientX);
    }
  }

  function onTouchEnd() {
    if (isDraggingStickerText) {
      isDraggingStickerText = false;
      scheduleStickerRender();
    }
    if (isPanning) {
      isPanning = false;
      scheduleStickerRender();
    }
    if (isDraggingSlider) {
      isDraggingSlider = false;
    }
  }

  // Mouse fallback handlers
  function onMouseDown(e: MouseEvent) {
    if (isBrushModeActive) return;
    if (currentBgTab === 'sticker') {
      if (isStickerCaptionActive && stickerCaptionText.trim()) {
        const isOver = checkPointerOverStickerText(e.clientX, e.clientY);
        if (isOver) {
          isDraggingStickerText = true;
          updateStickerTextFromClient(e.clientX, e.clientY);
          scheduleStickerRender();
          return;
        }
      }
      if (currentStickerShape !== 'die-cut') {
        isPanning = true;
        startX = e.clientX - panX;
        startY = e.clientY - panY;
        if (stageBox) stageBox.style.cursor = 'grabbing';
        if (stickerCanvas) stickerCanvas.style.cursor = 'grabbing';
      }
      return;
    }
    isDraggingSlider = true;
    updateSliderFromClientX(e.clientX);
  }

  function onMouseMove(e: MouseEvent) {
    if (currentBgTab === 'sticker') {
      if (isDraggingStickerText && isStickerCaptionActive) {
        updateStickerTextFromClient(e.clientX, e.clientY);
      } else if (isPanning && currentStickerShape !== 'die-cut') {
        panX = e.clientX - startX;
        panY = e.clientY - startY;
        scheduleStickerRender();
      }
      return;
    }
    if (!isDraggingSlider) return;
    updateSliderFromClientX(e.clientX);
  }

  function onMouseUp() {
    if (isDraggingStickerText) {
      isDraggingStickerText = false;
      updateCanvasCursor();
      scheduleStickerRender();
    }
    if (isPanning) {
      isPanning = false;
      updateCanvasCursor();
      scheduleStickerRender();
    }
    if (isDraggingSlider) isDraggingSlider = false;
  }

  if (stageBox) {
    // Pointer Events API
    stageBox.addEventListener('pointerdown', onPointerDown);
    stageBox.addEventListener('pointermove', onPointerMove);
    stageBox.addEventListener('pointerup', onPointerUp);
    stageBox.addEventListener('pointercancel', onPointerUp);
    stageBox.addEventListener('pointerleave', () => {
      if (!isDraggingStickerText && isPointerOverStickerText) {
        isPointerOverStickerText = false;
        updateCanvasCursor();
        scheduleStickerRender();
      }
    });

    // Explicit Touch Events with passive: false for smooth non-scrolling thumb drag
    stageBox.addEventListener('touchstart', onTouchStart, { passive: false });
    stageBox.addEventListener('touchmove', onTouchMove, { passive: false });
    stageBox.addEventListener('touchend', onTouchEnd);
    stageBox.addEventListener('touchcancel', onTouchEnd);

    // Mouse fallback
    stageBox.addEventListener('mousedown', onMouseDown);
  }

  if (stickerCanvas) {
    stickerCanvas.addEventListener('pointerdown', onPointerDown);
    stickerCanvas.addEventListener('pointermove', onPointerMove);
    stickerCanvas.addEventListener('pointerup', onPointerUp);
    stickerCanvas.addEventListener('pointercancel', onPointerUp);
    stickerCanvas.addEventListener('pointerleave', () => {
      if (!isDraggingStickerText && isPointerOverStickerText) {
        isPointerOverStickerText = false;
        updateCanvasCursor();
        scheduleStickerRender();
      }
    });
  }

  // Global window listeners for drag continuation outside container
  window.addEventListener('pointermove', (e: PointerEvent) => {
    if (isDraggingStickerText && isStickerCaptionActive) {
      updateStickerTextFromClient(e.clientX, e.clientY);
    } else if (isPanning && currentStickerShape !== 'die-cut') {
      panX = e.clientX - startX;
      panY = e.clientY - startY;
      scheduleStickerRender();
    } else if (isDraggingSlider) {
      updateSliderFromClientX(e.clientX);
    }
  });
  window.addEventListener('pointerup', () => {
    if (isPanning) {
      isPanning = false;
      updateCanvasCursor();
      scheduleStickerRender();
    }
    if (isDraggingStickerText) {
      isDraggingStickerText = false;
      updateCanvasCursor();
      scheduleStickerRender();
    }
    if (isDraggingSlider) isDraggingSlider = false;
  });
  window.addEventListener('pointercancel', () => {
    if (isPanning) {
      isPanning = false;
      updateCanvasCursor();
      scheduleStickerRender();
    }
    if (isDraggingStickerText) {
      isDraggingStickerText = false;
      updateCanvasCursor();
      scheduleStickerRender();
    }
    if (isDraggingSlider) isDraggingSlider = false;
  });

  window.addEventListener('touchmove', (e: TouchEvent) => {
    if (isDraggingStickerText && isStickerCaptionActive && e.touches && e.touches.length > 0) {
      if (e.cancelable) e.preventDefault();
      updateStickerTextFromClient(e.touches[0].clientX, e.touches[0].clientY);
    } else if (isPanning && currentStickerShape !== 'die-cut' && e.touches && e.touches.length > 0) {
      if (e.cancelable) e.preventDefault();
      panX = e.touches[0].clientX - startX;
      panY = e.touches[0].clientY - startY;
      scheduleStickerRender();
    } else if (isDraggingSlider && e.touches && e.touches.length > 0) {
      if (e.cancelable) e.preventDefault();
      updateSliderFromClientX(e.touches[0].clientX);
    }
  }, { passive: false });
  window.addEventListener('touchend', onTouchEnd);
  window.addEventListener('touchcancel', onTouchEnd);

  window.addEventListener('mousemove', onMouseMove);
  window.addEventListener('mouseup', onMouseUp);

  if (resetSliderBtn) {
    resetSliderBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      setSliderPercentage(50);
    });
  }

  // Converts image/avif, image/svg+xml or any unsupported format to standard PNG blob via offscreen canvas
  async function convertAvifOrSvgToPng(input: File | Blob): Promise<File | Blob> {
    const type = (input.type || '').toLowerCase();
    const name = (input instanceof File ? input.name : '').toLowerCase();
    const isAvifOrSvg =
      type.includes('avif') ||
      type.includes('svg') ||
      name.endsWith('.avif') ||
      name.endsWith('.svg');

    if (!isAvifOrSvg) {
      return input;
    }

    try {
      return await new Promise<File | Blob>((resolve) => {
        const objectUrl = URL.createObjectURL(input);
        const img = new Image();
        img.onload = () => {
          try {
            const width = img.naturalWidth || 1024;
            const height = img.naturalHeight || 1024;
            const canvas = document.createElement('canvas');
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            if (!ctx) {
              URL.revokeObjectURL(objectUrl);
              return resolve(input);
            }
            ctx.clearRect(0, 0, width, height);
            ctx.drawImage(img, 0, 0, width, height);
            canvas.toBlob((pngBlob) => {
              URL.revokeObjectURL(objectUrl);
              if (pngBlob && pngBlob.size > 0) {
                const newName = input instanceof File
                  ? input.name.replace(/\.(avif|svg)$/i, '') + '.png'
                  : 'imported.png';
                const convertedFile = new File([pngBlob], newName, { type: 'image/png' });
                resolve(convertedFile);
              } else {
                resolve(input);
              }
            }, 'image/png');
          } catch {
            URL.revokeObjectURL(objectUrl);
            resolve(input);
          }
        };
        img.onerror = () => {
          URL.revokeObjectURL(objectUrl);
          resolve(input);
        };
        img.src = objectUrl;
      });
    } catch {
      return input;
    }
  }

  // Fallback helper to convert any image to PNG via canvas if neural engine throws an error
  async function convertToPngViaCanvas(input: File | Blob): Promise<File | Blob> {
    return new Promise((resolve, reject) => {
      const url = URL.createObjectURL(input);
      const img = new Image();
      img.onload = () => {
        try {
          const w = img.naturalWidth || 800;
          const h = img.naturalHeight || 600;
          const canvas = document.createElement('canvas');
          canvas.width = w;
          canvas.height = h;
          const ctx = canvas.getContext('2d');
          if (!ctx) {
            URL.revokeObjectURL(url);
            return reject(new Error('Failed to obtain canvas 2D context'));
          }
          ctx.clearRect(0, 0, w, h);
          ctx.drawImage(img, 0, 0, w, h);
          canvas.toBlob((b) => {
            URL.revokeObjectURL(url);
            if (b) {
              const f = new File([b], 'converted.png', { type: 'image/png' });
              resolve(f);
            } else {
              reject(new Error('Canvas toBlob returned null'));
            }
          }, 'image/png');
        } catch (err) {
          URL.revokeObjectURL(url);
          reject(err);
        }
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        reject(new Error('Image failed to decode in browser'));
      };
      img.src = url;
    });
  }

  // Core Processing Routine
  async function processImage(inputFile: File | Blob) {
    try {
      isCancelled = false;
      clearError();

      if (inputFile.size > 25 * 1024 * 1024) {
        showError('Image exceeds 25MB limit. Please choose a smaller file.');
        return;
      }

      // Convert AVIF / SVG to PNG buffer via offscreen canvas to prevent [object Object] decode errors
      const file = await convertAvifOrSvgToPng(inputFile);
      currentFile = file;

      if (originalImageUrl) URL.revokeObjectURL(originalImageUrl);
      originalImageUrl = URL.createObjectURL(file);
      previewOriginalImg.src = originalImageUrl;
      if (blurredOriginalBgImg) {
        blurredOriginalBgImg.src = originalImageUrl;
      }

      const imgProbe = new Image();
      imgProbe.src = originalImageUrl;
      await new Promise((resolve) => {
        imgProbe.onload = () => {
          imageNaturalWidth = imgProbe.naturalWidth;
          imageNaturalHeight = imgProbe.naturalHeight;
          originalImageObj = imgProbe;
          resolve(null);
        };
        imgProbe.onerror = () => resolve(null);
      });

      switchView('processing');
      progressBarFill.style.width = '15%';
      processingTitle.textContent = 'Initializing in-browser neural engine...';
      processingSubtitle.textContent = 'Loading WebAssembly runtime...';

      const { removeBackground } = await import('@imgly/background-removal');

      if (isCancelled) return;

      progressBarFill.style.width = '35%';
      processingTitle.textContent = 'Segmenting foreground...';
      processingSubtitle.textContent = 'Calculating pixel contours in browser RAM...';

      let rawBlob: Blob;
      try {
        rawBlob = await removeBackground(file, {
          progress: (key: string, current: number, total: number) => {
            if (isCancelled) return;
            if (total > 0) {
              const pct = Math.min(94, Math.round((current / total) * 100));
              progressBarFill.style.width = `${Math.max(35, pct)}%`;
            }
            if (key.includes('fetch')) {
              processingSubtitle.textContent = 'Caching model weights locally in browser (~20MB)...';
            } else if (key.includes('compute')) {
              processingSubtitle.textContent = 'Executing inference via WebAssembly...';
            }
          },
          model: 'medium',
          output: {
            format: 'image/png',
            quality: 1.0,
            type: 'foreground'
          }
        });
      } catch (firstErr: any) {
        console.warn('Direct background removal failed, retrying via offscreen canvas PNG conversion...', firstErr);
        // Retry with offscreen canvas conversion to PNG
        const fallbackPng = await convertToPngViaCanvas(file);
        rawBlob = await removeBackground(fallbackPng, {
          model: 'medium',
          output: {
            format: 'image/png',
            quality: 1.0,
            type: 'foreground'
          }
        });
      }

      if (isCancelled) return;

      progressBarFill.style.width = '97%';
      processingTitle.textContent = 'Refining alpha contours & edge feathering...';
      processingSubtitle.textContent = 'Applying PhotoRoom-grade trimap thresholding & perimeter erosion...';

      const resultBlob = await refineAlphaMask(rawBlob, file);

      if (isCancelled) return;

      progressBarFill.style.width = '100%';
      processingTitle.textContent = 'Compositing full HD PNG...';

      cutoutBlob = resultBlob;
      if (cutoutUrl) URL.revokeObjectURL(cutoutUrl);
      cutoutUrl = URL.createObjectURL(resultBlob);

      previewCutoutImg.src = cutoutUrl;

      // Initialize Brush Canvas & Offscreen Pattern Buffers
      if (brushCanvas && imageNaturalWidth && imageNaturalHeight) {
        brushCanvas.width = imageNaturalWidth;
        brushCanvas.height = imageNaturalHeight;
        brushCtx = brushCanvas.getContext('2d', { willReadFrequently: true });

        // Draw the cutout to the brush canvas
        const cutoutImg = new Image();
        cutoutImg.src = cutoutUrl;
        await new Promise((resolve) => {
          cutoutImg.onload = () => resolve(null);
          cutoutImg.onerror = () => resolve(null);
        });

        if (brushCtx) {
          brushCtx.clearRect(0, 0, imageNaturalWidth, imageNaturalHeight);
          brushCtx.drawImage(cutoutImg, 0, 0);
        }

        // Store pristine initial cutout bitmap for Reset feature
        if (initialCutoutBitmap) {
          try { initialCutoutBitmap.close(); } catch (_) {}
          initialCutoutBitmap = null;
        }
        if (window.createImageBitmap) {
          try {
            initialCutoutBitmap = await createImageBitmap(brushCanvas);
          } catch (_) {}
        }

        // Create offscreen original image canvas for Restore pattern
        offscreenOriginalCanvas = document.createElement('canvas');
        offscreenOriginalCanvas.width = imageNaturalWidth;
        offscreenOriginalCanvas.height = imageNaturalHeight;
        const offCtx = offscreenOriginalCanvas.getContext('2d');
        if (offCtx && originalImageObj) {
          offCtx.drawImage(originalImageObj, 0, 0);
        }

        if (brushCtx && offscreenOriginalCanvas) {
          try {
            originalPattern = brushCtx.createPattern(offscreenOriginalCanvas, 'no-repeat');
          } catch (e) {
            console.warn('Pattern creation failed:', e);
          }
        }

        clearHistoryStacks();
      }

      updateResolutionBadge();

      const mbSize = (resultBlob.size / (1024 * 1024)).toFixed(2);
      metaSizeBadge.textContent = `${mbSize} MB PNG`;

      panX = 0;
      panY = 0;
      isPanning = false;
      startX = 0;
      startY = 0;

      if (initialDefaultMode === 'sticker') {
        switchBgTab('sticker');
        setSliderPercentage(0);
      } else {
        applyBgToElements(currentBgColor);
        setSliderPercentage(50);
      }
      applyBlurEffect();
      applyShadowEffect();

      setTimeout(() => {
        if (!isCancelled) {
          switchView('result');
          if (initialDefaultMode === 'sticker') {
            renderLiveStickerPreview();
          }
        }
      }, 200);

    } catch (err: any) {
      console.error('Background removal error:', err);
      if (!isCancelled) {
        switchView('upload');
        let errMsg = 'Processing failed. Please check your image format.';
        if (typeof err === 'string' && err.trim()) {
          errMsg = err.trim();
        } else if (err?.message && typeof err.message === 'string' && err.message.trim()) {
          errMsg = err.message.trim();
        }
        if (errMsg.includes('[object Object]') || errMsg === '{}') {
          errMsg = 'The image format could not be decoded. Please try another image or export as PNG/JPG.';
        }
        showError(errMsg);
      }
    }
  }

  if (dropZone && fileInput) {
    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput.click();
      }
    });

    ['dragenter', 'dragover'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.add('border-[#E5A93C]', 'bg-[#E5A93C]/5', 'dark:bg-[#E5A93C]/10', 'shadow-[0_0_20px_rgba(229,169,60,0.2)]');
      }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.remove('border-[#E5A93C]', 'bg-[#E5A93C]/5', 'dark:bg-[#E5A93C]/10', 'shadow-[0_0_20px_rgba(229,169,60,0.2)]');
      }, false);
    });

    dropZone.addEventListener('drop', (e) => {
      const dt = e.dataTransfer;
      if (dt && dt.files && dt.files[0]) {
        const file = dt.files[0];
        if (file.type.startsWith('image/') || /\.(png|jpe?g|webp|avif|svg)$/i.test(file.name)) {
          processImage(file);
        } else {
          showError('Please drop a valid image (PNG, JPG, WebP, AVIF, or SVG).');
        }
      }
    });
  }

  if (fileInput) {
    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files[0]) {
        processImage(fileInput.files[0]);
      }
    });
  }

  function openUrlModal() {
    if (!urlModal) return;
    urlModal.classList.remove('opacity-0', 'pointer-events-none');
    urlModal.classList.add('opacity-100');
    if (urlModalCard) {
      urlModalCard.classList.remove('scale-95');
      urlModalCard.classList.add('scale-100');
    }
    if (imageUrlInput) {
      imageUrlInput.value = '';
      setTimeout(() => imageUrlInput.focus(), 50);
    }
    if (urlModalError) {
      urlModalError.classList.add('hidden');
      urlModalError.textContent = '';
    }
  }

  function closeUrlModal() {
    if (!urlModal) return;
    urlModal.classList.add('opacity-0', 'pointer-events-none');
    urlModal.classList.remove('opacity-100');
    if (urlModalCard) {
      urlModalCard.classList.add('scale-95');
      urlModalCard.classList.remove('scale-100');
    }
    if (submitUrlBtn) submitUrlBtn.disabled = false;
    if (submitUrlSpinner) submitUrlSpinner.classList.add('hidden');
    if (submitUrlText) submitUrlText.textContent = 'Import Image';
  }

  async function fetchAndProcessImageUrl(url: string) {
    try {
      switchView('processing');
      if (processingTitle) processingTitle.textContent = 'Fetching image from URL...';
      if (processingSubtitle) processingSubtitle.textContent = 'Connecting through secure proxy...';
      if (progressBarFill) progressBarFill.style.width = '15%';

      const res = await fetch(`/api/fetch-image?url=${encodeURIComponent(url)}`);
      if (!res.ok) {
        let errMsg = `Failed to fetch image (HTTP ${res.status})`;
        try {
          const errJson = await res.json();
          if (errJson?.error) errMsg = errJson.error;
        } catch (_) {}
        throw new Error(errMsg);
      }

      const blob = await res.blob();
      if (!blob || blob.size === 0) {
        throw new Error('Received empty image response from URL.');
      }

      await processImage(blob);
    } catch (err: any) {
      switchView('upload');
      showError(err.message || 'Failed to import image from URL.');
    }
  }

  if (pasteUrlTrigger) {
    pasteUrlTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      openUrlModal();
    });
  }

  if (closeUrlModalBtn) {
    closeUrlModalBtn.addEventListener('click', closeUrlModal);
  }

  if (cancelUrlModalBtn) {
    cancelUrlModalBtn.addEventListener('click', closeUrlModal);
  }

  if (urlModal) {
    urlModal.addEventListener('click', (e) => {
      if (e.target === urlModal) {
        closeUrlModal();
      }
    });
  }

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && urlModal && !urlModal.classList.contains('pointer-events-none')) {
      closeUrlModal();
    }
  });

  if (urlForm) {
    urlForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const inputUrl = imageUrlInput?.value?.trim();
      if (!inputUrl) return;

      try {
        const u = new URL(inputUrl);
        if (u.protocol !== 'http:' && u.protocol !== 'https:') {
          throw new Error('Please enter a valid HTTP or HTTPS URL.');
        }
      } catch {
        if (urlModalError) {
          urlModalError.textContent = 'Please enter a valid image web address (e.g. https://example.com/pic.jpg).';
          urlModalError.classList.remove('hidden');
        }
        return;
      }

      if (submitUrlBtn) submitUrlBtn.disabled = true;
      if (submitUrlSpinner) submitUrlSpinner.classList.remove('hidden');
      if (submitUrlText) submitUrlText.textContent = 'Fetching...';
      if (urlModalError) urlModalError.classList.add('hidden');

      try {
        closeUrlModal();
        await fetchAndProcessImageUrl(inputUrl);
      } catch (err: any) {
        showError(err.message || 'Failed to load image from URL.');
      } finally {
        if (submitUrlBtn) submitUrlBtn.disabled = false;
        if (submitUrlSpinner) submitUrlSpinner.classList.add('hidden');
        if (submitUrlText) submitUrlText.textContent = 'Import Image';
      }
    });
  }

  window.addEventListener('paste', async (e) => {
    // If the user is typing inside an input or textarea, let default text paste proceed normally
    const activeEl = document.activeElement as HTMLElement | null;
    const isEditingText = activeEl && (
      activeEl.tagName === 'INPUT' ||
      activeEl.tagName === 'TEXTAREA' ||
      activeEl.isContentEditable
    );

    const clipboardData = e.clipboardData;
    if (!clipboardData) return;

    // 1. Check for image file in clipboard
    const items = clipboardData.items;
    let imageFile: File | null = null;
    for (let i = 0; i < items.length; i++) {
      if (items[i].type.indexOf('image') !== -1) {
        imageFile = items[i].getAsFile();
        if (imageFile) break;
      }
    }

    if (imageFile) {
      e.preventDefault();
      showToast('Image pasted from clipboard');
      processImage(imageFile);
      return;
    }

    // If an input is focused, don't intercept text pastes
    if (isEditingText) return;

    // 2. Check for URL string in clipboard
    const text = clipboardData.getData('text')?.trim();
    if (text) {
      try {
        const parsed = new URL(text);
        if (parsed.protocol === 'http:' || parsed.protocol === 'https:') {
          e.preventDefault();
          showToast('Loading image from copied URL...');
          await fetchAndProcessImageUrl(text);
        }
      } catch (_) {
        // Not a URL, ignore
      }
    }
  });

  const sampleButtons = document.querySelectorAll('.sample-btn');
  sampleButtons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const sampleUrl = btn.getAttribute('data-sample');
      if (!sampleUrl) return;

      try {
        switchView('processing');
        if (processingTitle) processingTitle.textContent = 'Loading sample image...';
        if (progressBarFill) progressBarFill.style.width = '10%';

        const response = await fetch(sampleUrl);
        if (!response.ok) throw new Error('Could not load sample');
        const blob = await response.blob();
        await processImage(blob);
      } catch (err: any) {
        switchView('upload');
        showError('Failed to load sample: ' + err.message);
      }
    });
  });

  // ==========================================
  // ERASE & RESTORE BRUSH TOOL ENGINE
  // ==========================================

  function clearHistoryStacks() {
    while (undoStack.length > 0) {
      const snap = undoStack.pop();
      try { snap?.close(); } catch (_) {}
    }
    while (redoStack.length > 0) {
      const snap = redoStack.pop();
      try { snap?.close(); } catch (_) {}
    }
    updateHistoryBtnStates();
  }

  function updateHistoryBtnStates() {
    if (brushUndoBtn) brushUndoBtn.disabled = undoStack.length === 0;
    if (brushRedoBtn) brushRedoBtn.disabled = redoStack.length === 0;
  }

  function getCanvasCoords(clientX: number, clientY: number) {
    if (!brushCanvas) return { x: 0, y: 0, scale: 1 };
    const rect = brushCanvas.getBoundingClientRect();
    const scaleX = rect.width > 0 ? brushCanvas.width / rect.width : 1;
    const scaleY = rect.height > 0 ? brushCanvas.height / rect.height : 1;
    return {
      x: (clientX - rect.left) * scaleX,
      y: (clientY - rect.top) * scaleY,
      scale: scaleX
    };
  }

  function updateCursorIndicator(clientX: number, clientY: number) {
    if (!brushCursorIndicator) return;
    brushCursorIndicator.style.left = `${clientX}px`;
    brushCursorIndicator.style.top = `${clientY}px`;
    brushCursorIndicator.style.width = `${brushSize}px`;
    brushCursorIndicator.style.height = `${brushSize}px`;
    if (currentBrushMode === 'erase') {
      brushCursorIndicator.style.borderColor = 'rgba(239, 68, 68, 0.9)';
      brushCursorIndicator.style.boxShadow = '0 0 0 1.5px rgba(0,0,0,0.7), 0 0 10px rgba(239, 68, 68, 0.6)';
    } else {
      brushCursorIndicator.style.borderColor = 'rgba(34, 197, 94, 0.9)';
      brushCursorIndicator.style.boxShadow = '0 0 0 1.5px rgba(0,0,0,0.7), 0 0 10px rgba(34, 197, 94, 0.6)';
    }
  }

  async function pushUndoState() {
    if (!brushCanvas || !window.createImageBitmap) return;
    try {
      const snapshot = await createImageBitmap(brushCanvas);
      undoStack.push(snapshot);
      if (undoStack.length > MAX_HISTORY) {
        const oldest = undoStack.shift();
        try { oldest?.close(); } catch (_) {}
      }
      while (redoStack.length > 0) {
        const snap = redoStack.pop();
        try { snap?.close(); } catch (_) {}
      }
      updateHistoryBtnStates();
    } catch (e) {
      console.warn('Snapshot creation error:', e);
    }
  }

  async function handleUndo() {
    if (undoStack.length === 0 || !brushCtx || !brushCanvas) return;
    try {
      if (window.createImageBitmap) {
        const currentState = await createImageBitmap(brushCanvas);
        redoStack.push(currentState);
      }
      const prevState = undoStack.pop()!;
      brushCtx.clearRect(0, 0, brushCanvas.width, brushCanvas.height);
      brushCtx.drawImage(prevState, 0, 0);
      try { prevState.close(); } catch (_) {}
      updateHistoryBtnStates();
      await syncCanvasToBlobAndPreview();
    } catch (e) {
      console.warn('Undo error:', e);
    }
  }

  async function handleRedo() {
    if (redoStack.length === 0 || !brushCtx || !brushCanvas) return;
    try {
      if (window.createImageBitmap) {
        const currentState = await createImageBitmap(brushCanvas);
        undoStack.push(currentState);
      }
      const nextState = redoStack.pop()!;
      brushCtx.clearRect(0, 0, brushCanvas.width, brushCanvas.height);
      brushCtx.drawImage(nextState, 0, 0);
      try { nextState.close(); } catch (_) {}
      updateHistoryBtnStates();
      await syncCanvasToBlobAndPreview();
    } catch (e) {
      console.warn('Redo error:', e);
    }
  }

  async function handleReset() {
    if (!initialCutoutBitmap || !brushCtx || !brushCanvas) return;
    try {
      await pushUndoState();
      brushCtx.clearRect(0, 0, brushCanvas.width, brushCanvas.height);
      brushCtx.drawImage(initialCutoutBitmap, 0, 0);
      updateHistoryBtnStates();
      await syncCanvasToBlobAndPreview();
      showToast('Reset to original AI cutout');
    } catch (e) {
      console.warn('Reset error:', e);
    }
  }

  function drawDot(pt: { x: number; y: number }, scale: number) {
    if (!brushCtx) return;
    const radius = Math.max(1, (brushSize * scale) / 2);
    brushCtx.save();
    if (currentBrushMode === 'erase') {
      brushCtx.globalCompositeOperation = 'destination-out';
      brushCtx.fillStyle = 'rgba(0,0,0,1)';
    } else {
      brushCtx.globalCompositeOperation = 'source-over';
      if (originalPattern) {
        brushCtx.fillStyle = originalPattern;
      } else {
        brushCtx.fillStyle = 'rgba(255,255,255,1)';
      }
    }
    brushCtx.beginPath();
    brushCtx.arc(pt.x, pt.y, radius, 0, Math.PI * 2);
    brushCtx.fill();
    brushCtx.restore();
  }

  function drawSmoothLine(p1: { x: number; y: number }, p2: { x: number; y: number }, scale: number) {
    if (!brushCtx) return;
    const lineWidth = Math.max(1, brushSize * scale);
    brushCtx.save();
    brushCtx.lineWidth = lineWidth;
    brushCtx.lineCap = 'round';
    brushCtx.lineJoin = 'round';
    if (currentBrushMode === 'erase') {
      brushCtx.globalCompositeOperation = 'destination-out';
      brushCtx.strokeStyle = 'rgba(0,0,0,1)';
    } else {
      brushCtx.globalCompositeOperation = 'source-over';
      if (originalPattern) {
        brushCtx.strokeStyle = originalPattern;
      }
    }
    brushCtx.beginPath();
    brushCtx.moveTo(p1.x, p1.y);
    brushCtx.lineTo(p2.x, p2.y);
    brushCtx.stroke();
    brushCtx.restore();
  }

  function drawSmoothCurve(p0: { x: number; y: number }, p1: { x: number; y: number }, p2: { x: number; y: number }, scale: number) {
    if (!brushCtx) return;
    const lineWidth = Math.max(1, brushSize * scale);
    brushCtx.save();
    brushCtx.lineWidth = lineWidth;
    brushCtx.lineCap = 'round';
    brushCtx.lineJoin = 'round';
    if (currentBrushMode === 'erase') {
      brushCtx.globalCompositeOperation = 'destination-out';
      brushCtx.strokeStyle = 'rgba(0,0,0,1)';
    } else {
      brushCtx.globalCompositeOperation = 'source-over';
      if (originalPattern) {
        brushCtx.strokeStyle = originalPattern;
      }
    }
    const mid1 = { x: (p0.x + p1.x) / 2, y: (p0.y + p1.y) / 2 };
    const mid2 = { x: (p1.x + p2.x) / 2, y: (p1.y + p2.y) / 2 };
    brushCtx.beginPath();
    brushCtx.moveTo(mid1.x, mid1.y);
    brushCtx.quadraticCurveTo(p1.x, p1.y, mid2.x, mid2.y);
    brushCtx.stroke();
    brushCtx.restore();
  }

  function syncCanvasToBlobAndPreview(): Promise<Blob | null> {
    return new Promise((resolve) => {
      if (!brushCanvas) return resolve(null);
      brushCanvas.toBlob((blob) => {
        if (blob) {
          cutoutBlob = blob;
          if (cutoutUrl) URL.revokeObjectURL(cutoutUrl);
          cutoutUrl = URL.createObjectURL(blob);
          if (previewCutoutImg) previewCutoutImg.src = cutoutUrl;
          const mbSize = (blob.size / (1024 * 1024)).toFixed(2);
          if (metaSizeBadge) metaSizeBadge.textContent = `${mbSize} MB PNG`;
          if (currentBgTab === 'sticker') {
            scheduleStickerRender();
          }
        }
        resolve(blob);
      }, 'image/png');
    });
  }

  // Brush Toggle Switch Listener
  if (brushToolToggle) {
    brushToolToggle.addEventListener('change', () => {
      isBrushModeActive = brushToolToggle.checked;
      if (isBrushModeActive) {
        if (brushControls) brushControls.classList.remove('opacity-50', 'pointer-events-none');
        if (sliderDivider) sliderDivider.classList.add('hidden');
        if (previewCutoutImg) previewCutoutImg.classList.add('hidden');
        if (brushCanvas) brushCanvas.classList.remove('hidden');
        if (stageBox) {
          stageBox.style.setProperty('--slider-pos', '0%');
          stageBox.classList.remove('cursor-ew-resize');
          stageBox.classList.add('cursor-none');
        }
        showToast('Brush enabled: Erase or Restore pixels');
      } else {
        if (brushControls) brushControls.classList.add('opacity-50', 'pointer-events-none');
        if (sliderDivider) sliderDivider.classList.remove('hidden');
        if (brushCanvas) brushCanvas.classList.add('hidden');
        if (previewCutoutImg) previewCutoutImg.classList.remove('hidden');
        if (brushCursorIndicator) brushCursorIndicator.classList.add('hidden');
        if (stageBox) {
          stageBox.style.setProperty('--slider-pos', '50%');
          stageBox.classList.remove('cursor-none');
          stageBox.classList.add('cursor-ew-resize');
        }
      }
    });
  }

  // Brush Mode Selectors (Erase vs Restore)
  if (brushModeErase && brushModeRestore) {
    const activeClasses = ['active', 'bg-white', 'dark:bg-[#242428]', 'text-[#b47818]', 'dark:text-[#E5A93C]', 'font-semibold', 'shadow-xs', 'border-[#E5A93C]/30'];
    const inactiveClasses = ['text-[#5a5852]', 'dark:text-[#a09c92]', 'border-transparent'];

    brushModeErase.addEventListener('click', () => {
      currentBrushMode = 'erase';
      brushModeErase.classList.add(...activeClasses);
      brushModeErase.classList.remove(...inactiveClasses);
      brushModeRestore.classList.remove(...activeClasses);
      brushModeRestore.classList.add(...inactiveClasses);
      if (brushCursorIndicator) {
        brushCursorIndicator.style.borderColor = 'rgba(239, 68, 68, 0.9)';
        brushCursorIndicator.style.boxShadow = '0 0 0 1.5px rgba(0,0,0,0.7), 0 0 10px rgba(239, 68, 68, 0.6)';
      }
    });

    brushModeRestore.addEventListener('click', () => {
      currentBrushMode = 'restore';
      brushModeRestore.classList.add(...activeClasses);
      brushModeRestore.classList.remove(...inactiveClasses);
      brushModeErase.classList.remove(...activeClasses);
      brushModeErase.classList.add(...inactiveClasses);
      if (brushCursorIndicator) {
        brushCursorIndicator.style.borderColor = 'rgba(34, 197, 94, 0.9)';
        brushCursorIndicator.style.boxShadow = '0 0 0 1.5px rgba(0,0,0,0.7), 0 0 10px rgba(34, 197, 94, 0.6)';
      }
    });
  }

  // Brush Size Slider Listener
  if (brushSizeSlider) {
    brushSizeSlider.addEventListener('input', () => {
      brushSize = parseInt(brushSizeSlider.value, 10) || 25;
      if (brushSizeLabel) brushSizeLabel.textContent = `${brushSize}px`;
      if (brushCursorIndicator) {
        brushCursorIndicator.style.width = `${brushSize}px`;
        brushCursorIndicator.style.height = `${brushSize}px`;
      }
    });
  }

  // History & Reset Button Listeners
  if (brushUndoBtn) brushUndoBtn.addEventListener('click', handleUndo);
  if (brushRedoBtn) brushRedoBtn.addEventListener('click', handleRedo);
  if (brushResetBtn) brushResetBtn.addEventListener('click', handleReset);

  // Keyboard Shortcuts for Undo/Redo
  window.addEventListener('keydown', (e: KeyboardEvent) => {
    if (!isBrushModeActive) return;
    if ((e.ctrlKey || e.metaKey) && (e.key === 'z' || e.key === 'Z') && !e.shiftKey) {
      e.preventDefault();
      handleUndo();
    } else if ((e.ctrlKey || e.metaKey) && (e.key === 'y' || e.key === 'Y' || ((e.key === 'z' || e.key === 'Z') && e.shiftKey))) {
      e.preventDefault();
      handleRedo();
    }
  });

  // Brush Canvas Drawing Pointer & Touch Listeners
  if (brushCanvas) {
    brushCanvas.addEventListener('pointerenter', (e: PointerEvent) => {
      if (!isBrushModeActive) return;
      if (brushCursorIndicator) brushCursorIndicator.classList.remove('hidden');
      updateCursorIndicator(e.clientX, e.clientY);
    });

    brushCanvas.addEventListener('pointerleave', () => {
      if (brushCursorIndicator) brushCursorIndicator.classList.add('hidden');
      if (isDrawing) {
        isDrawing = false;
        strokePoints = [];
        syncCanvasToBlobAndPreview();
      }
    });

    brushCanvas.addEventListener('pointerdown', async (e: PointerEvent) => {
      if (!isBrushModeActive || e.button !== 0) return;
      try {
        brushCanvas.setPointerCapture(e.pointerId);
      } catch (_) {}

      await pushUndoState();
      isDrawing = true;
      const pt = getCanvasCoords(e.clientX, e.clientY);
      strokePoints = [pt];
      drawDot(pt, pt.scale);
      updateCursorIndicator(e.clientX, e.clientY);
    });

    brushCanvas.addEventListener('pointermove', (e: PointerEvent) => {
      if (!isBrushModeActive) return;
      updateCursorIndicator(e.clientX, e.clientY);

      if (!isDrawing) return;
      const pt = getCanvasCoords(e.clientX, e.clientY);
      strokePoints.push(pt);

      if (strokePoints.length === 2) {
        drawSmoothLine(strokePoints[0], strokePoints[1], pt.scale);
      } else if (strokePoints.length >= 3) {
        drawSmoothCurve(
          strokePoints[strokePoints.length - 3],
          strokePoints[strokePoints.length - 2],
          strokePoints[strokePoints.length - 1],
          pt.scale
        );
      }
    });

    const endDrawing = (e: PointerEvent) => {
      if (!isDrawing) return;
      isDrawing = false;
      try {
        brushCanvas.releasePointerCapture(e.pointerId);
      } catch (_) {}

      if (strokePoints.length >= 2) {
        const lastPt = strokePoints[strokePoints.length - 1];
        const prevPt = strokePoints[strokePoints.length - 2];
        const mid = { x: (prevPt.x + lastPt.x) / 2, y: (prevPt.y + lastPt.y) / 2 };
        drawSmoothLine(mid, lastPt, lastPt.scale);
      }
      strokePoints = [];
      syncCanvasToBlobAndPreview();
    };

    brushCanvas.addEventListener('pointerup', endDrawing);
    brushCanvas.addEventListener('pointercancel', endDrawing);

    // Explicit touch handling with passive: false to prevent scrolling while drawing
    brushCanvas.addEventListener('touchstart', (e: TouchEvent) => {
      if (!isBrushModeActive) return;
      if (e.cancelable) e.preventDefault();
    }, { passive: false });

    brushCanvas.addEventListener('touchmove', (e: TouchEvent) => {
      if (!isBrushModeActive) return;
      if (e.cancelable) e.preventDefault();
    }, { passive: false });

    brushCanvas.addEventListener('touchend', (e: TouchEvent) => {
      if (!isBrushModeActive) return;
      if (e.cancelable) e.preventDefault();
    }, { passive: false });
  }

  // ==========================================
  // EXPORT ACTIONS (HD PNG, JPG, CLIPBOARD)
  // ==========================================

  // Primary Export: Download Full HD PNG
  if (downloadHdBtn) {
    downloadHdBtn.addEventListener('click', async () => {
      if (!cutoutBlob) return;
      try {
        downloadHdBtn.disabled = true;
        downloadHdBtn.classList.add('opacity-75');

        await syncCanvasToBlobAndPreview();

        const originalName = currentFile instanceof File ? currentFile.name.replace(/\.[^/.]+$/, "") : 'cutout';
        const filename = `${originalName}-fastbgremove-hd.png`;

        const isStickerActive =
          currentBgTab === 'sticker' &&
          (stickerStrokeWidth > 0 ||
            currentStickerShape !== 'die-cut' ||
            (isStickerCaptionActive && stickerCaptionText.trim().length > 0));

        const { naturalPanX, naturalPanY } = getNaturalPanOffsets();
        const exportOpts: ExportOptions = {
          ratio: currentRatio,
          backgroundColor: isStickerActive ? 'transparent' : currentBgColor,
          customBgImage: customBgImageObj,
          originalImage: originalImageObj,
          blur: blurBgPx,
          isBlurEnabled: isBlurBgActive,
          isShadowEnabled: isShadowActive,
          shadowOpacity: shadowOpacityPct,
          isStickerEnabled: isStickerActive,
          stickerStrokeColor: stickerStrokeColor,
          stickerStrokeWidth: stickerStrokeWidth,
          stickerShape: currentStickerShape,
          stickerPanX: currentStickerShape !== 'die-cut' ? naturalPanX : 0,
          stickerPanY: currentStickerShape !== 'die-cut' ? naturalPanY : 0,
          stickerCaptionText: isStickerCaptionActive ? stickerCaptionText : '',
          stickerCaptionColor: stickerCaptionColor,
          stickerTextNormX: stickerTextNormX,
          stickerTextNormY: stickerTextNormY,
          stickerIsBold: stickerIsBold,
          stickerIsItalic: stickerIsItalic,
          stickerFontSize: stickerFontSize
        };

        const finalBlob = await createHdExportBlob(cutoutBlob, exportOpts);
        triggerDownload(finalBlob, filename);
        showToast('Download started');
      } catch (err) {
        console.error('Export download error:', err);
        showError('Failed to export HD PNG.');
      } finally {
        downloadHdBtn.disabled = false;
        downloadHdBtn.classList.remove('opacity-75');
      }
    });
  }

  // Secondary Export: Export Compressed JPG (Binary Search)
  if (exportJpgBtn) {
    exportJpgBtn.addEventListener('click', async () => {
      if (!cutoutBlob) return;
      try {
        exportJpgBtn.disabled = true;
        await syncCanvasToBlobAndPreview();
        const originalBtnText = exportJpgText ? exportJpgText.textContent : 'Export JPG';
        if (exportJpgText) exportJpgText.textContent = 'Optimizing...';

        const preset = ((jpgPresetSelect ? jpgPresetSelect.value : '100kb') as JpgCompressionPreset) || '100kb';
        const isStickerActive =
          currentBgTab === 'sticker' &&
          (stickerStrokeWidth > 0 ||
            currentStickerShape !== 'die-cut' ||
            (isStickerCaptionActive && stickerCaptionText.trim().length > 0));

        const { naturalPanX, naturalPanY } = getNaturalPanOffsets();
        const exportOpts: ExportOptions = {
          ratio: currentRatio,
          backgroundColor: isStickerActive ? '#FFFFFF' : currentBgColor,
          customBgImage: customBgImageObj,
          originalImage: originalImageObj,
          blur: blurBgPx,
          isBlurEnabled: isBlurBgActive,
          isShadowEnabled: isShadowActive,
          shadowOpacity: shadowOpacityPct,
          isStickerEnabled: isStickerActive,
          stickerStrokeColor: stickerStrokeColor,
          stickerStrokeWidth: stickerStrokeWidth,
          stickerShape: currentStickerShape,
          stickerPanX: currentStickerShape !== 'die-cut' ? naturalPanX : 0,
          stickerPanY: currentStickerShape !== 'die-cut' ? naturalPanY : 0,
          stickerCaptionText: isStickerCaptionActive ? stickerCaptionText : '',
          stickerCaptionColor: stickerCaptionColor,
          stickerTextNormX: stickerTextNormX,
          stickerTextNormY: stickerTextNormY,
          stickerIsBold: stickerIsBold,
          stickerIsItalic: stickerIsItalic,
          stickerFontSize: stickerFontSize
        };

        const finalBlob = await createCompressedJpgBlob(cutoutBlob, preset, exportOpts);
        const originalName = currentFile instanceof File ? currentFile.name.replace(/\.[^/.]+$/, "") : 'cutout';
        const filename = `${originalName}-fastbgremove-${preset}.jpg`;

        triggerDownload(finalBlob, filename);
        const sizeKb = (finalBlob.size / 1024).toFixed(1);
        showToast(`JPG downloaded (${sizeKb} KB)`);
        if (exportJpgText) exportJpgText.textContent = originalBtnText;
      } catch (err) {
        console.error('JPG export error:', err);
        showError('Failed to export compressed JPG.');
        if (exportJpgText) exportJpgText.textContent = 'Export JPG';
      } finally {
        exportJpgBtn.disabled = false;
      }
    });
  }

  // Copy to Clipboard
  if (copyClipboardBtn) {
    copyClipboardBtn.addEventListener('click', async () => {
      if (!cutoutBlob) return;
      try {
        copyClipboardBtn.disabled = true;
        await syncCanvasToBlobAndPreview();
        const originalText = copyBtnText ? copyBtnText.textContent : 'Copy PNG';
        if (copyBtnText) copyBtnText.textContent = 'Copying...';

        const isStickerActive =
          currentBgTab === 'sticker' &&
          (stickerStrokeWidth > 0 ||
            currentStickerShape !== 'die-cut' ||
            (isStickerCaptionActive && stickerCaptionText.trim().length > 0));

        const { naturalPanX, naturalPanY } = getNaturalPanOffsets();
        const exportOpts: ExportOptions = {
          ratio: currentRatio,
          backgroundColor: isStickerActive ? 'transparent' : currentBgColor,
          customBgImage: customBgImageObj,
          originalImage: originalImageObj,
          blur: blurBgPx,
          isBlurEnabled: isBlurBgActive,
          isShadowEnabled: isShadowActive,
          shadowOpacity: shadowOpacityPct,
          isStickerEnabled: isStickerActive,
          stickerStrokeColor: stickerStrokeColor,
          stickerStrokeWidth: stickerStrokeWidth,
          stickerShape: currentStickerShape,
          stickerPanX: currentStickerShape !== 'die-cut' ? naturalPanX : 0,
          stickerPanY: currentStickerShape !== 'die-cut' ? naturalPanY : 0,
          stickerCaptionText: isStickerCaptionActive ? stickerCaptionText : '',
          stickerCaptionColor: stickerCaptionColor,
          stickerTextNormX: stickerTextNormX,
          stickerTextNormY: stickerTextNormY,
          stickerIsBold: stickerIsBold,
          stickerIsItalic: stickerIsItalic,
          stickerFontSize: stickerFontSize
        };

        const finalBlob = await createHdExportBlob(cutoutBlob, exportOpts);
        const success = await copyImageToClipboard(finalBlob);

        if (success) {
          if (copyBtnText) copyBtnText.textContent = 'Copied!';
          showToast('Cutout copied to clipboard');
          setTimeout(() => {
            if (copyBtnText) copyBtnText.textContent = originalText;
            copyClipboardBtn.disabled = false;
          }, 2000);
        } else {
          if (copyBtnText) copyBtnText.textContent = 'Failed';
          showError('Clipboard copy is not supported in this browser.');
          setTimeout(() => {
            if (copyBtnText) copyBtnText.textContent = originalText;
            copyClipboardBtn.disabled = false;
          }, 2000);
        }
      } catch (err) {
        console.error('Clipboard copy error:', err);
        copyClipboardBtn.disabled = false;
      }
    });
  }

  // Quick Export: Download WhatsApp Sticker (512x512 transparent PNG with 16px safety padding)
  async function downloadWhatsAppSticker() {
    if (!cutoutBlob) return;
    try {
      if (downloadWhatsappBtn) downloadWhatsappBtn.disabled = true;

      await syncCanvasToBlobAndPreview();
      let source: HTMLCanvasElement | HTMLImageElement = (isBrushModeActive && brushCanvas) ? brushCanvas : previewCutoutImg;
      if (!isBrushModeActive && (!previewCutoutImg || previewCutoutImg.naturalWidth === 0 || !previewCutoutImg.complete)) {
        source = await loadImageFromBlob(cutoutBlob);
      }
      const widthToUse = currentBgTab === 'sticker' ? stickerStrokeWidth : 14;
      const shapeToUse = currentBgTab === 'sticker' ? currentStickerShape : 'die-cut';
      const textToUse = (currentBgTab === 'sticker' && isStickerCaptionActive) ? stickerCaptionText : '';

      const { naturalPanX, naturalPanY } = getNaturalPanOffsets();

      // 1. Render full-resolution sticker canvas with shape, stroke & typography text
      const renderedSourceCanvas = renderStickerCanvas(source, {
        shape: shapeToUse,
        strokeColor: stickerStrokeColor,
        strokeWidth: widthToUse,
        panX: shapeToUse !== 'die-cut' ? naturalPanX : 0,
        panY: shapeToUse !== 'die-cut' ? naturalPanY : 0,
        captionText: textToUse,
        captionColor: stickerCaptionColor,
        textNormX: stickerTextNormX,
        textNormY: stickerTextNormY,
        isBold: stickerIsBold,
        isItalic: stickerIsItalic,
        fontSize: stickerFontSize
      });

      // 2. Export strictly at 512x512 PNG with 16px safety padding using bulletproof pipeline
      const finalBlob = await exportWhatsAppSticker(renderedSourceCanvas);

      const originalName = currentFile instanceof File ? currentFile.name.replace(/\.[^/.]+$/, "") : 'sticker';
      triggerDownload(finalBlob, `${originalName}-whatsapp-512x512.png`);
      showToast('WhatsApp sticker downloaded (512x512 PNG)');
    } catch (err) {
      console.error('WhatsApp export error:', err);
      showError('Failed to export WhatsApp sticker.');
    } finally {
      if (downloadWhatsappBtn) downloadWhatsappBtn.disabled = false;
    }
  }

  if (downloadWhatsappBtn) {
    downloadWhatsappBtn.addEventListener('click', downloadWhatsAppSticker);
  }
</script>
