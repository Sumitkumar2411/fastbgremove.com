      shadowOpacityPct = parseInt(shadowSlider.value, 10) || 0;
      if (shadowLabel) shadowLabel.textContent = `${shadowOpacityPct}%`;
      if (shadowOpacityPct > 0 && shadowToggle && !shadowToggle.checked) {
        shadowToggle.checked = true;
        isShadowActive = true;
        shadowSlider.disabled = false;
        shadowSlider.classList.remove('opacity-50', 'disabled:cursor-not-allowed');
      }
      applyShadowEffect();
