---
interface Props {
  heading?: string;
  subheading?: string;
  defaultBg?: 'transparent' | 'white' | 'passport-blue';
  defaultMode?: 'default' | 'sticker';
}

const {
  heading = "Remove Background from Image",
  subheading = "100% automatic, in-browser background removal. No sign-up, no compression, and no watermarks.",
  defaultBg = "transparent",
  defaultMode = "default"
} = Astro.props;
---

<section class="w-full flex flex-col items-center justify-center pt-2 sm:pt-4 pb-6" data-default-bg={defaultBg} data-default-mode={defaultMode}>
  <!-- Desktop Hero Heading (Clean & Bold Cursor Typography) -->
  <div class="text-center max-w-3xl mx-auto mb-6 sm:mb-8 space-y-2">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
      {heading}
    </h1>
    <p class="text-base sm:text-lg text-zinc-600 dark:text-[#A7A7A7] max-w-2xl mx-auto leading-relaxed">
      {subheading}
    </p>
  </div>

  <!-- Main Workspace (Cursor Editor Grade Card with 8px/12px Geometry) -->
  <div id="workspace-card" class="w-full max-w-4xl bg-white dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] rounded-lg shadow-xs p-3.5 sm:p-7 relative transition-all">
    <!-- Active Accent Corner Dot -->
    <div class="absolute -top-[1px] -left-[1px] w-2.5 h-2.5 rounded-tl-lg bg-[#E5A93C] z-20 pointer-events-none shadow-[0_0_8px_rgba(229,169,60,0.5)]"></div>

    <!-- STATE 1: UPLOAD DROPZONE VIEW (HERO ELEMENT) -->
    <div id="upload-view" class="flex flex-col items-center justify-center">
      <div
        id="main-upload-dropzone"
        tabindex="0"
        role="button"
        aria-label="Upload image for background removal"
        class="w-full min-h-[220px] sm:min-h-[340px] md:min-h-[440px] border-2 border-dashed border-[#cfcdc4] dark:border-[#2e2e33] hover:border-[#E5A93C] dark:hover:border-[#E5A93C] hover:bg-[#efeee8]/50 dark:hover:bg-[#1c1c1f] focus:border-[#D49B28] focus:outline-none rounded-lg p-4 sm:p-8 md:p-14 flex flex-col items-center justify-center text-center cursor-pointer transition-all group shadow-xs hover:shadow-[0_0_24px_rgba(229,169,60,0.15)] relative"
      >
        <span id="drop-zone" class="contents"></span>
        <input type="file" id="file-input" accept="image/png, image/jpeg, image/webp, image/avif, image/svg+xml" class="hidden" />

        <!-- Large Upload Icon with Golden Accent -->
        <div class="w-16 h-16 rounded-md bg-[#E5A93C]/10 border border-[#E5A93C]/20 flex items-center justify-center text-[#E5A93C] group-hover:scale-105 transition-transform mb-6 shadow-xs">
          <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
        </div>

        <!-- Prominent Primary Callout -->
        <div class="space-y-2 mb-4">
          <p class="text-xl sm:text-2xl font-bold text-[#26251e] dark:text-white">
            Drop your image here, or <span class="text-[#b47818] dark:text-[#E5A93C] underline decoration-2 underline-offset-4 group-hover:text-[#D49B28]">Browse</span>
          </p>
          <p class="text-sm sm:text-base text-[#5a5852] dark:text-[#a09c92]">
            Supports PNG, JPG, WebP, AVIF, SVG up to 25MB • Or paste directly with <kbd class="px-2 py-1 rounded-md bg-[#efeee8] dark:bg-[#242428] border border-[#cfcdc4] dark:border-[#3e3e44] text-xs font-mono text-[#26251e] dark:text-[#ededed] font-semibold">Ctrl+V</kbd>
          </p>
        </div>

        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#E5A93C]/10 border border-[#E5A93C]/20 text-xs font-semibold text-[#b47818] dark:text-[#E5A93C]">
          <span class="w-2 h-2 rounded-full bg-[#E5A93C]"></span>
          <span>100% In-Browser & Private • Free Full Resolution</span>
        </div>
      </div>

      <!-- Paste image or URL trigger under dropzone -->
      <p class="mt-3.5 mb-1 text-center text-xs sm:text-sm text-[#5a5852] dark:text-[#a09c92]">
        or drop a file, paste image or <button type="button" id="paste-url-trigger" class="text-[#b47818] dark:text-[#E5A93C] font-semibold underline decoration-1 underline-offset-4 hover:text-[#D49B28] dark:hover:text-[#F3C363] transition-colors cursor-pointer">URL</button>
      </p>

      <!-- Sample Cards Row (Clickable 8px Thumbnail Cards) -->
      <div class="mt-4 sm:mt-6 flex flex-wrap items-center justify-center gap-2 sm:gap-3.5">
        <span class="text-xs sm:text-sm font-medium text-[#5a5852] dark:text-[#a09c92] w-full text-center sm:w-auto">Try with a sample:</span>

        <button
          type="button"
          data-sample="/samples/portrait.jpg"
          class="sample-btn flex items-center gap-2 sm:gap-3 p-1.5 pr-3 sm:p-2 sm:pr-4 rounded-md bg-[#f7f7f4] dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] hover:border-[#E5A93C] hover:shadow-[0_0_12px_rgba(229,169,60,0.15)] transition-all cursor-pointer group/card"
        >
          <img src="/samples/portrait.jpg" alt="Portrait photo background removal sample" class="w-8 h-8 sm:w-10 sm:h-10 rounded-md object-cover group-hover/card:scale-105 transition-transform" />
          <div class="text-left">
            <div class="text-xs sm:text-sm font-semibold text-[#26251e] dark:text-[#ededed] group-hover/card:text-[#b47818] dark:group-hover/card:text-[#E5A93C]">Portrait</div>
            <div class="text-[10px] sm:text-xs text-[#807d72] dark:text-[#a09c92]">Headshot & People</div>
          </div>
        </button>

        <button
          type="button"
          data-sample="/samples/signature.jpg"
          class="sample-btn flex items-center gap-2 sm:gap-3 p-1.5 pr-3 sm:p-2 sm:pr-4 rounded-md bg-[#f7f7f4] dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] hover:border-[#E5A93C] hover:shadow-[0_0_12px_rgba(229,169,60,0.15)] transition-all cursor-pointer group/card"
        >
          <img src="/samples/signature.jpg" alt="Handwritten signature transparency sample" class="w-8 h-8 sm:w-10 sm:h-10 rounded-md object-cover bg-white group-hover/card:scale-105 transition-transform" />
          <div class="text-left">
            <div class="text-xs sm:text-sm font-semibold text-[#26251e] dark:text-[#ededed] group-hover/card:text-[#b47818] dark:group-hover/card:text-[#E5A93C]">Signature</div>
            <div class="text-[10px] sm:text-xs text-[#807d72] dark:text-[#a09c92]">Ink & Documents</div>
          </div>
        </button>

        <button
          type="button"
          data-sample="/samples/product.jpg"
          class="sample-btn flex items-center gap-2 sm:gap-3 p-1.5 pr-3 sm:p-2 sm:pr-4 rounded-md bg-[#f7f7f4] dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] hover:border-[#E5A93C] hover:shadow-[0_0_12px_rgba(229,169,60,0.15)] transition-all cursor-pointer group/card"
        >
          <img src="/samples/product.jpg" alt="E-commerce product background removal sample" class="w-8 h-8 sm:w-10 sm:h-10 rounded-md object-cover group-hover/card:scale-105 transition-transform" />
          <div class="text-left">
            <div class="text-xs sm:text-sm font-semibold text-[#26251e] dark:text-[#ededed] group-hover/card:text-[#b47818] dark:group-hover/card:text-[#E5A93C]">Product</div>
            <div class="text-[10px] sm:text-xs text-[#807d72] dark:text-[#a09c92]">Commercial Object</div>
          </div>
        </button>
      </div>
    </div>

    <!-- STATE 2: PROCESSING VIEW -->
    <div id="processing-view" class="hidden flex flex-col items-center justify-center min-h-[420px] p-8 text-center">
      <div class="w-12 h-12 rounded-full border-3 border-[#E5A93C]/20 border-t-[#E5A93C] animate-spin mb-5"></div>

      <div class="space-y-2 max-w-md w-full">
        <h3 id="processing-title" class="text-lg font-bold text-[#26251e] dark:text-white">
          Removing background locally...
        </h3>
        <p id="processing-subtitle" class="text-sm text-[#5a5852] dark:text-[#a09c92]">
          Running in-browser WebAssembly neural engine...
        </p>

        <!-- Progress Bar with Golden Accent Fill -->
        <div class="w-full bg-[#efeee8] dark:bg-[#121212] border border-[#e6e5e0] dark:border-[#2e2e33] rounded-full h-2 mt-4 overflow-hidden">
          <div id="progress-bar-fill" class="bg-[#E5A93C] h-full w-12 transition-all duration-200 rounded-full shadow-[0_0_10px_rgba(229,169,60,0.5)]"></div>
        </div>

        <p class="text-xs text-[#807d72] dark:text-[#706e68] pt-2">
          Model weights are cached locally. Your image is never uploaded to any server.
        </p>
      </div>

      <button
        id="cancel-processing-btn"
        type="button"
        class="mt-6 text-sm font-medium text-[#5a5852] hover:text-[#26251e] dark:text-[#a09c92] dark:hover:text-white underline underline-offset-4 cursor-pointer"
      >
        Cancel
      </button>
    </div>

    <!-- STATE 3: RESULT VIEW (INTERACTIVE BEFORE/AFTER SLIDER & INLINE CONTROLS) -->
    <div id="result-view" class="hidden flex flex-col space-y-3.5">
      <!-- Toolbar Header: Resolution badge & Ratio Segmented Controls -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5 pb-2.5 border-b border-[#e6e5e0] dark:border-[#2e2e33]">
        <!-- Left: Image Resolution, Size Badge & Quick Replace Action -->
        <div class="flex items-center justify-between sm:justify-start gap-2 flex-wrap">
          <span class="inline-flex items-center gap-2 px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-md bg-[#E5A93C]/10 border border-[#E5A93C]/20 text-[11px] sm:text-xs font-semibold text-[#b47818] dark:text-[#E5A93C] font-mono">
            <span class="w-2 h-2 rounded-full bg-[#E5A93C]"></span>
            <span id="meta-res-badge">HD READY</span>
          </span>
          <span id="meta-size-badge" class="text-xs font-medium text-[#807d72] dark:text-[#a09c92] font-mono hidden sm:inline-block"></span>

          <!-- Quick Replace Action -->
          <input type="file" id="quick-replace-input" accept="image/*" class="hidden" />
          <button
            type="button"
            id="quick-replace-btn"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-200 shadow-xs hover:bg-slate-50 dark:hover:bg-slate-750 transition-all cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7"/>
              <path d="m16 5 3 3-7 7H9v-3z"/>
            </svg>
            <span>Replace Image</span>
          </button>
        </div>

        <!-- Right: Canvas Ratio Controls & 50% Split Reset -->
        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-1 max-w-full">
          <div class="flex items-center gap-1.5 text-xs font-mono text-[#807d72] dark:text-[#a09c92] hidden md:flex shrink-0">
            <svg class="w-3.5 h-3.5 text-[#E5A93C]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
            </svg>
            <span>Ratio:</span>
          </div>

          <div id="ratio-selector" class="flex items-center p-1 rounded-md border border-[#e6e5e0] dark:border-[#2e2e33] bg-[#efeee8] dark:bg-[#121212] gap-1 shadow-xs text-xs font-mono shrink-0">
            <button
              type="button"
              data-ratio="original"
              class="ratio-btn active py-1.5 px-2.5 sm:px-3 rounded-md font-semibold text-[#b47818] dark:text-[#E5A93C] bg-white dark:bg-[#242428] shadow-xs cursor-pointer transition-all border border-[#E5A93C]/30 shrink-0 whitespace-nowrap"
            >
              Original
            </button>
            <button
              type="button"
              data-ratio="1:1"
              class="ratio-btn py-1.5 px-2.5 sm:px-3 rounded-md font-medium text-[#5a5852] dark:text-[#a09c92] hover:text-[#b47818] dark:hover:text-[#E5A93C] cursor-pointer transition-all border border-transparent shrink-0 whitespace-nowrap"
            >
              1:1
            </button>
            <button
              type="button"
              data-ratio="16:9"
              class="ratio-btn py-1.5 px-2.5 sm:px-3 rounded-md font-medium text-[#5a5852] dark:text-[#a09c92] hover:text-[#b47818] dark:hover:text-[#E5A93C] cursor-pointer transition-all border border-transparent shrink-0 whitespace-nowrap"
            >
              16:9
            </button>
            <button
              type="button"
              data-ratio="passport"
              class="ratio-btn py-1.5 px-2.5 sm:px-3 rounded-md font-medium text-[#5a5852] dark:text-[#a09c92] hover:text-[#b47818] dark:hover:text-[#E5A93C] cursor-pointer transition-all border border-transparent shrink-0 whitespace-nowrap"
            >
              Passport
            </button>
          </div>

          {defaultMode !== 'sticker' && (
            <button
              id="reset-slider-btn"
              type="button"
              title="Reset slider to 50% center"
              class="shrink-0 py-1.5 px-2.5 rounded-md border border-[#e6e5e0] dark:border-[#2e2e33] bg-white dark:bg-[#1c1c1f] text-xs font-mono font-medium text-[#5a5852] dark:text-[#a09c92] hover:text-[#b47818] dark:hover:text-[#E5A93C] hover:border-[#E5A93C] transition-all shadow-xs cursor-pointer whitespace-nowrap"
            >
              50%
            </button>
          )}
        </div>
      </div>

      <!-- INTERACTIVE BEFORE/AFTER PREVIEW SLIDER VIEWPORT -->
      <div
        id="preview-container"
        class="w-full relative min-h-[440px] sm:min-h-[500px] rounded-lg border border-[#e6e5e0] dark:border-[#2e2e33] flex items-center justify-center overflow-hidden bg-[#efeee8]/50 dark:bg-[#151518] transition-colors select-none p-3 sm:p-4"
      >
        <!-- Tiny non-intrusive micro-badge above the canvas when a shape is selected -->
        <div
          id="sticker-pan-hint"
          class="hidden absolute top-2.5 left-1/2 -translate-x-1/2 z-30 pointer-events-none select-none transition-opacity duration-200"
        >
          <span class="text-[11px] text-slate-500 dark:text-slate-400 font-medium bg-white/90 dark:bg-[#1c1c1f]/90 px-2.5 py-1 rounded-full border border-slate-200/80 dark:border-slate-700/80 shadow-xs backdrop-blur-xs flex items-center gap-1">💡 Drag photo inside the frame to adjust position</span>
        </div>

        <!-- Bounding Stage Box for Ratio Containment & Dragging -->
        <div
          id="stage-box"
          class:list={[
            "relative flex items-center justify-center transition-all overflow-hidden rounded-md max-h-[440px] sm:max-h-[480px] max-w-full select-none touch-none shadow-xs border border-[#cfcdc4] dark:border-[#3e3e44]",
            defaultMode === 'sticker' ? 'cursor-default' : 'cursor-ew-resize'
          ]}
          style={`--slider-pos: ${defaultMode === 'sticker' ? '0%' : '50%'}; touch-action: none;`}
        >
          <!-- LAYER 1: BASE (ORIGINAL UPLOADED IMAGE - LEFT SIDE) -->
          <div id="slider-base-layer" class="w-full h-full relative flex items-center justify-center overflow-hidden bg-[#f7f7f4] dark:bg-[#121212]">
            <img
              id="preview-original-img"
              alt="Original uploaded image preview"
              class="max-h-[420px] sm:max-h-[480px] w-auto max-w-full object-contain pointer-events-none select-none"
            />
            <!-- Left Badge: Original -->
            <span
              id="original-badge"
              class:list={[
                "absolute top-3 left-3 text-xs font-mono font-semibold text-[#5a5852] dark:text-[#a09c92] bg-white/95 dark:bg-[#1c1c1f]/95 px-2.5 py-1 rounded-md border border-[#e6e5e0] dark:border-[#2e2e33] shadow-xs pointer-events-none z-20 backdrop-blur-xs",
                { hidden: defaultMode === 'sticker' }
              ]}
            >
              ORIGINAL
            </span>
          </div>

          <!-- LAYER 2: CLIPPED OVERLAY (CUTOUT + BACKDROP - RIGHT SIDE) -->
          <div
            id="slider-cutout-layer"
            class="absolute inset-0 z-10 overflow-hidden pointer-events-none flex items-center justify-center transition-none"
            style="clip-path: inset(0 0 0 var(--slider-pos, 50%));"
          >
            <!-- Background Layer (Checkerboard, Solid Color, or Custom BG Image + Blur) -->
            <div id="stage-bg-layer" class="absolute inset-0 z-0 bg-checkerboard transition-all overflow-hidden pointer-events-none flex items-center justify-center">
              <img id="custom-bg-preview-img" alt="Custom background image preview" class="hidden w-full h-full object-cover transition-all" />
              <!-- Hardware-Accelerated Blurred Background Layer (Original image scaled 1.04x to prevent blur edge-bleeding/halo) -->
              <img
                id="blurred-original-bg-img"
                alt="Blurred background preview"
                class="hidden max-h-[420px] sm:max-h-[480px] w-auto max-w-full object-contain pointer-events-none select-none transition-none"
                style="will-change: filter, transform; transform: scale(1.04) translateZ(0);"
              />
            </div>

            <!-- Foreground Cutout Image (Identical size & containment as original) -->
            <img
              id="preview-cutout-img"
              alt="Transparent background cutout preview"
              class="max-h-[420px] sm:max-h-[480px] w-auto max-w-full object-contain relative z-10 pointer-events-none select-none drop-shadow-xs transition-none"
              style="will-change: filter, transform; transform: translateZ(0);"
            />

            <!-- Live Sticker Outline Canvas (Zero-lag 60fps die-cut preview) -->
            <canvas
              id="sticker-canvas"
              class="hidden max-h-[420px] sm:max-h-[480px] w-auto max-w-full object-contain relative z-10 pointer-events-auto select-none drop-shadow-xs transition-none"
              style="will-change: filter, transform; transform: translateZ(0); touch-action: none;"
            ></canvas>

            <!-- Interactive Brush Canvas (overlay / active drawing surface) -->
            <canvas
              id="brush-canvas"
              class="hidden max-h-[420px] sm:max-h-[480px] w-auto max-w-full object-contain relative z-10 select-none drop-shadow-xs transition-none cursor-none touch-none pointer-events-auto"
              style="will-change: filter, transform; transform: translateZ(0); touch-action: none;"
            ></canvas>

            <!-- Right Badge: Cutout -->
            <span
              id="cutout-badge"
              class:list={[
                "absolute top-3 right-3 text-xs font-mono font-semibold text-[#b47818] dark:text-[#E5A93C] bg-white/95 dark:bg-[#1c1c1f]/95 px-2.5 py-1 rounded-md border border-[#E5A93C]/20 shadow-xs pointer-events-none z-20 backdrop-blur-xs",
                { hidden: defaultMode === 'sticker' }
              ]}
            >
              CUTOUT
            </span>
          </div>

          <!-- Floating Brush Cursor Circle Indicator (tracks pointer in brush mode) -->
          <div
            id="brush-cursor-indicator"
            class="hidden fixed pointer-events-none z-50 rounded-full border-2 border-white shadow-[0_0_0_1.5px_rgba(0,0,0,0.7),0_0_10px_rgba(229,169,60,0.8)] transform -translate-x-1/2 -translate-y-1/2 transition-none"
            style="width: 25px; height: 25px;"
          ></div>

          <!-- CENTER DRAGGABLE DIVIDER -->
          <div
            id="slider-divider"
            class:list={[
              "absolute top-0 bottom-0 z-30 pointer-events-none flex items-center justify-center transition-none",
              { hidden: defaultMode === 'sticker' }
            ]}
            style="left: var(--slider-pos, 50%); transform: translateX(-50%);"
          >
            <!-- Divider Vertical Bar (#E5A93C golden active accent) -->
            <div class="w-0.5 h-full bg-[#E5A93C] shadow-[0_0_10px_rgba(229,169,60,0.7)]"></div>

            <!-- Grab Handle Pill with Left/Right Arrows (↔) -->
            <div
              id="slider-handle"
              class="absolute w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white dark:bg-[#1c1c1f] border-2 border-[#E5A93C] shadow-[0_0_12px_rgba(229,169,60,0.35)] flex items-center justify-center text-[#b47818] dark:text-[#E5A93C] pointer-events-auto cursor-ew-resize hover:scale-110 active:scale-95 transition-transform"
              style="touch-action: none;"
              title="Drag left or right to inspect cutout contours (60fps)"
            >
              <svg class="w-4 h-4 text-[#b47818] dark:text-[#E5A93C]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="8 17 3 12 8 7"/>
                <polyline points="16 7 21 12 16 17"/>
              </svg>
            </div>
          </div>
        </div>
      </div>

      {defaultMode === 'sticker' && (
        <!-- STRUCTURED 2-ROW STICKER INSPECTOR (ZERO OVERFLOW, SAAS-GRADE) -->
        <div
          id="sticker-inspector-card"
          class="w-full max-w-3xl mx-auto mt-5 space-y-3"
        >
          <!-- Row 1: Shapes & Outline Engine -->
          <div class="flex flex-wrap items-center justify-between gap-4 p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700">
            <!-- Left Group (Shapes): Pill group -->
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Shape:</span>
              <div class="inline-flex items-center p-1 rounded-xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 gap-1 shadow-inner">
                <button
                  type="button"
                  data-sticker-shape="die-cut"
                  title="Exact subject contour with smooth die-cut outline"
                  class="sticker-shape-btn active py-1.5 px-2.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-700 shadow-xs cursor-pointer border border-slate-200/80 dark:border-slate-600"
                >
                  <span>✂️</span>
                  <span>Die-Cut</span>
                </button>
                <button
                  type="button"
                  data-sticker-shape="circle"
                  title="Circular clipping badge"
                  class="sticker-shape-btn py-1.5 px-2.5 rounded-lg text-xs font-medium flex items-center gap-1.5 transition-all text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white cursor-pointer border border-transparent"
                >
                  <span>⚪</span>
                  <span>Circle</span>
                </button>
                <button
                  type="button"
                  data-sticker-shape="square"
                  title="Sharp 1:1 square frame"
