  // ==========================================
  // STICKER MAKER OUTLINE & PREVIEW ENGINE
  // ==========================================

  function getNaturalPanOffsets(): { naturalPanX: number; naturalPanY: number } {
    if (!imageNaturalWidth || !imageNaturalHeight) {
      return { naturalPanX: panX, naturalPanY: panY };
    }
    const targetEl = (stickerCanvas && stickerCanvas.getBoundingClientRect().width > 0)
      ? stickerCanvas
      : ((previewCutoutImg && previewCutoutImg.getBoundingClientRect().width > 0) ? previewCutoutImg : stageBox);

    if (!targetEl) {
      return { naturalPanX: panX, naturalPanY: panY };
    }
    const rect = targetEl.getBoundingClientRect();
    if (rect.width <= 0) {
      return { naturalPanX: panX, naturalPanY: panY };
    }
    const scale = imageNaturalWidth / rect.width;
    return {
      naturalPanX: Math.round(panX * scale),
      naturalPanY: Math.round(panY * scale)
    };
  }

  function updateCanvasCursor() {
    if (currentBgTab !== 'sticker') {
      if (stageBox && !isBrushModeActive) {
        stageBox.style.cursor = '';
      }
      return;
    }

    let cursor = 'default';
    if (isDraggingStickerText || isPointerOverStickerText) {
      cursor = 'move';
    } else if (currentStickerShape !== 'die-cut') {
      cursor = isPanning ? 'grabbing' : 'grab';
    }

    if (stickerCanvas) stickerCanvas.style.cursor = cursor;
    if (stageBox) stageBox.style.cursor = cursor;
  }

  function updatePanHintUI() {
    const hint = document.getElementById('sticker-pan-hint');
    if (!hint) return;
    if (currentBgTab === 'sticker' && currentStickerShape !== 'die-cut') {
      hint.classList.remove('hidden');
    } else {
      hint.classList.add('hidden');
    }
  }

  function renderLiveStickerPreview() {
    if (!stickerCanvas || !previewCutoutImg) return;

    const hasStickerActive =
      currentBgTab === 'sticker' &&
      !!imageNaturalWidth &&
      !!imageNaturalHeight &&
      (stickerStrokeWidth > 0 ||
        currentStickerShape !== 'die-cut' ||
        (isStickerCaptionActive && stickerCaptionText.trim().length > 0));

    if (hasStickerActive) {
      if (stickerCanvas.width !== imageNaturalWidth || stickerCanvas.height !== imageNaturalHeight) {
        stickerCanvas.width = imageNaturalWidth;
        stickerCanvas.height = imageNaturalHeight;
      }
      const sCtx = stickerCanvas.getContext('2d');
      if (sCtx) {
        sCtx.clearRect(0, 0, imageNaturalWidth, imageNaturalHeight);
        const source = (isBrushModeActive && brushCanvas) ? brushCanvas : previewCutoutImg;
        const showBoundingBox = isStickerCaptionActive && (isDraggingStickerText || isPointerOverStickerText);
        const { naturalPanX, naturalPanY } = getNaturalPanOffsets();
        drawSticker(sCtx, source, {
          shape: currentStickerShape,
          strokeColor: stickerStrokeColor,
          strokeWidth: stickerStrokeWidth,
          panX: currentStickerShape !== 'die-cut' ? naturalPanX : 0,
          panY: currentStickerShape !== 'die-cut' ? naturalPanY : 0,
          captionText: isStickerCaptionActive ? stickerCaptionText : undefined,
          captionColor: stickerCaptionColor,
          textNormX: stickerTextNormX,
          textNormY: stickerTextNormY,
          isBold: stickerIsBold,
          isItalic: stickerIsItalic,
          fontSize: stickerFontSize,
          showBoundingBox
        });
      }
      stickerCanvas.classList.remove('hidden');
      previewCutoutImg.classList.add('hidden');
    } else {
      stickerCanvas.classList.add('hidden');
      if (!isBrushModeActive && previewCutoutImg) {
        previewCutoutImg.classList.remove('hidden');
      }
    }
  }

  function scheduleStickerRender() {
    if (stickerRafId !== null) return;
    stickerRafId = requestAnimationFrame(() => {
      renderLiveStickerPreview();
      stickerRafId = null;
    });
  }

  function updateStickerShapeUI(selectedShape: StickerShape) {
    stickerShapeBtns.forEach(btn => {
      const s = btn.getAttribute('data-sticker-shape') as StickerShape;
      const isActive = s === selectedShape;
      btn.classList.toggle('active', isActive);

      if (btn.classList.contains('rounded-lg')) {
        // Card inspector styling
        btn.classList.toggle('bg-slate-100', isActive);
        btn.classList.toggle('dark:bg-slate-700', isActive);
        btn.classList.toggle('text-slate-900', isActive);
        btn.classList.toggle('dark:text-white', isActive);
        btn.classList.toggle('font-semibold', isActive);
        btn.classList.toggle('border-slate-200/80', isActive);
        btn.classList.toggle('dark:border-slate-600', isActive);
        btn.classList.toggle('shadow-xs', isActive);

        btn.classList.toggle('text-slate-600', !isActive);
        btn.classList.toggle('dark:text-slate-300', !isActive);
        btn.classList.toggle('font-medium', !isActive);
        btn.classList.toggle('border-transparent', !isActive);
      } else {
        // Tab strip styling
        btn.classList.toggle('bg-white', isActive);
        btn.classList.toggle('dark:bg-[#242428]', isActive);
        btn.classList.toggle('text-[#b47818]', isActive);
        btn.classList.toggle('dark:text-[#E5A93C]', isActive);
        btn.classList.toggle('font-semibold', isActive);
        btn.classList.toggle('shadow-xs', isActive);
        btn.classList.toggle('border-[#E5A93C]/30', isActive);

        btn.classList.toggle('text-[#5a5852]', !isActive);
        btn.classList.toggle('dark:text-[#a09c92]', !isActive);
        btn.classList.toggle('border-transparent', !isActive);
      }
    });
    updatePanHintUI();
    updateCanvasCursor();
  }

  stickerShapeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const shape = btn.getAttribute('data-sticker-shape') as StickerShape;
      if (!shape) return;
      currentStickerShape = shape;
      updateStickerShapeUI(shape);
      scheduleStickerRender();
    });
  });

  function updateStickerSwatchUI(selectedColor: string) {
    stickerColorBtns.forEach(b => {
      const c = b.getAttribute('data-sticker-color');
      const isActive = !!(c && c.toUpperCase() === selectedColor.toUpperCase());
      b.classList.toggle('active', isActive);

      if (b.classList.contains('rounded-full')) {
