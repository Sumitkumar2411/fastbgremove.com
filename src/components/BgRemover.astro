  function applyBgToElements(color: string) {
    const isTrans = color === 'transparent' && !customBgImageObj;
    const isWhite = color.toUpperCase() === '#FFFFFF';
    const isBlue = color.toUpperCase() === '#0055A5' || color.toUpperCase() === '#2563EB';
    const isCustomImg = !!customBgImageObj;

    // Update buttons
    const activeClasses = ['active', 'bg-white', 'dark:bg-[#242428]', 'text-[#b47818]', 'dark:text-[#E5A93C]', 'font-semibold', 'shadow-xs', 'border-[#E5A93C]/30'];
    const inactiveClasses = ['text-[#5a5852]', 'dark:text-[#a09c92]', 'border-transparent'];

    [bgBtnTransparent, bgBtnWhite, bgBtnBlue, bgBtnCustomImage].forEach(b => {
      if (b) {
        b.classList.remove(...activeClasses);
        b.classList.add(...inactiveClasses);
      }
    });

    if (isCustomImg && bgBtnCustomImage) {
      bgBtnCustomImage.classList.add(...activeClasses);
      bgBtnCustomImage.classList.remove(...inactiveClasses);
    } else if (isTrans && bgBtnTransparent) {
      bgBtnTransparent.classList.add(...activeClasses);
      bgBtnTransparent.classList.remove(...inactiveClasses);
    } else if (isWhite && bgBtnWhite) {
      bgBtnWhite.classList.add(...activeClasses);
      bgBtnWhite.classList.remove(...inactiveClasses);
    } else if (isBlue && bgBtnBlue) {
      bgBtnBlue.classList.add(...activeClasses);
      bgBtnBlue.classList.remove(...inactiveClasses);
    }

    // Apply to preview backdrop layers
    if (stageBgLayer) {
      if (isCustomImg) {
        stageBgLayer.style.backgroundColor = 'transparent';
        stageBgLayer.classList.remove('bg-checkerboard');
      } else if (isTrans && !isBlurBgActive) {
        stageBgLayer.style.backgroundColor = '';
        stageBgLayer.classList.add('bg-checkerboard');
      } else {
        stageBgLayer.style.backgroundColor = color;
        stageBgLayer.classList.remove('bg-checkerboard');
        if (customColorSwatch) customColorSwatch.style.backgroundColor = color;
      }
    }
  }

  // Real-time GPU Blur Effect Handler
  function applyBlurEffect() {
    if (!blurredOriginalBgImg) return;
    if (isBlurBgActive && blurBgPx > 0) {
      blurredOriginalBgImg.classList.remove('hidden');
      blurredOriginalBgImg.style.filter = `blur(${blurBgPx}px)`;
      blurredOriginalBgImg.style.transform = 'scale(1.04) translateZ(0)';
      blurredOriginalBgImg.style.willChange = 'filter, transform';
      if (stageBgLayer) stageBgLayer.classList.remove('bg-checkerboard');
      if (customBgPreviewImg && customBgImageObj) {
        customBgPreviewImg.style.filter = `blur(${blurBgPx}px)`;
        customBgPreviewImg.style.transform = 'scale(1.04) translateZ(0)';
        customBgPreviewImg.style.willChange = 'filter, transform';
      }
    } else {
      blurredOriginalBgImg.classList.add('hidden');
      blurredOriginalBgImg.style.filter = 'none';
      if (customBgPreviewImg) {
        customBgPreviewImg.style.filter = 'none';
        customBgPreviewImg.style.transform = 'none';
      }
      if (currentBgColor === 'transparent' && !customBgImageObj && stageBgLayer) {
        stageBgLayer.classList.add('bg-checkerboard');
      }
    }
  }

  // Real-time GPU Drop Shadow Effect Handler
  function applyShadowEffect() {
    const filterVal = (isShadowActive && shadowOpacityPct > 0)
      ? `drop-shadow(0px ${Math.round(10 * (shadowOpacityPct / 100))}px ${Math.round(18 * (shadowOpacityPct / 100))}px rgba(0, 0, 0, ${(0.65 * (shadowOpacityPct / 100)).toFixed(2)}))`
      : 'none';

    if (previewCutoutImg) {
      previewCutoutImg.style.filter = filterVal;
      previewCutoutImg.style.transform = 'translateZ(0)';
      if (isShadowActive && shadowOpacityPct > 0) {
        previewCutoutImg.style.willChange = 'filter, transform';
      }
    }
    if (brushCanvas) {
      brushCanvas.style.filter = filterVal;
      brushCanvas.style.transform = 'translateZ(0)';
      if (isShadowActive && shadowOpacityPct > 0) {
        brushCanvas.style.willChange = 'filter, transform';
      }
    }
    if (stickerCanvas) {
      stickerCanvas.style.filter = filterVal;
      stickerCanvas.style.transform = 'translateZ(0)';
      if (isShadowActive && shadowOpacityPct > 0) {
        stickerCanvas.style.willChange = 'filter, transform';
      }
    }
  }

  // Blur Background Switch & Slider Listeners
  if (blurBgToggle) {
    blurBgToggle.addEventListener('change', () => {
      isBlurBgActive = blurBgToggle.checked;
      if (isBlurBgActive) {
        if (blurBgSlider) {
          blurBgSlider.disabled = false;
          blurBgSlider.classList.remove('opacity-50', 'disabled:cursor-not-allowed');
          if (blurBgPx === 0) {
            blurBgPx = 12;
            blurBgSlider.value = '12';
