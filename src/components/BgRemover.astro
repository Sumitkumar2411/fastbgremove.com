---
interface Props {
  heading?: string;
  subheading?: string;
  defaultBg?: 'transparent' | 'white' | 'passport-blue';
}

const {
  heading = "Remove Background from Image",
  subheading = "100% automatic, in-browser background removal. No sign-up, no compression, and no watermarks.",
  defaultBg = "transparent"
} = Astro.props;
---

<section class="w-full flex flex-col items-center justify-center pt-2 sm:pt-4 pb-6" data-default-bg={defaultBg}>
  <!-- Desktop Hero Heading (Clean & Bold Cursor Typography) -->
  <div class="text-center max-w-3xl mx-auto mb-6 sm:mb-8 space-y-2">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
      {heading}
    </h1>
    <p class="text-base sm:text-lg text-zinc-600 dark:text-[#A7A7A7] max-w-2xl mx-auto leading-relaxed">
      {subheading}
    </p>
  </div>

  <!-- Main Workspace (Cursor Editor Grade Card with 8px/12px Geometry) -->
  <div id="workspace-card" class="w-full max-w-5xl bg-white dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] rounded-lg shadow-xs p-3.5 sm:p-7 relative transition-all">
    <!-- Active Accent Corner Dot -->
    <div class="absolute -top-[1px] -left-[1px] w-2.5 h-2.5 rounded-tl-lg bg-[#f54e00] z-20 pointer-events-none"></div>

    <!-- STATE 1: UPLOAD DROPZONE VIEW (HERO ELEMENT) -->
    <div id="upload-view" class="flex flex-col items-center justify-center">
      <div
        id="drop-zone"
        tabindex="0"
        role="button"
        aria-label="Upload image for background removal"
        class="w-full min-h-[220px] sm:min-h-[340px] md:min-h-[440px] border-2 border-dashed border-[#cfcdc4] dark:border-[#2e2e33] hover:border-[#f54e00] dark:hover:border-[#f54e00] hover:bg-[#efeee8]/50 dark:hover:bg-[#1c1c1f] focus:border-[#d04200] focus:outline-none rounded-lg p-4 sm:p-8 md:p-14 flex flex-col items-center justify-center text-center cursor-pointer transition-all group shadow-xs relative"
      >
        <input type="file" id="file-input" accept="image/png, image/jpeg, image/webp" class="hidden" />

        <!-- Large Upload Icon with Cursor Orange Accent -->
        <div class="w-16 h-16 rounded-md bg-[#f54e00]/10 border border-[#f54e00]/20 flex items-center justify-center text-[#f54e00] group-hover:scale-105 transition-transform mb-6 shadow-xs">
          <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
        </div>

        <!-- Prominent Primary Callout -->
        <div class="space-y-2 mb-4">
          <p class="text-xl sm:text-2xl font-bold text-[#26251e] dark:text-white">
            Drop your image here, or <span class="text-[#f54e00] underline decoration-2 underline-offset-4 group-hover:text-[#d04200]">Browse</span>
          </p>
          <p class="text-sm sm:text-base text-[#5a5852] dark:text-[#a09c92]">
            Supports PNG, JPG, WebP up to 25MB • Or paste directly with <kbd class="px-2 py-1 rounded-md bg-[#efeee8] dark:bg-[#242428] border border-[#cfcdc4] dark:border-[#3e3e44] text-xs font-mono text-[#26251e] dark:text-[#ededed] font-semibold">Ctrl+V</kbd>
          </p>
        </div>

        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#f54e00]/10 border border-[#f54e00]/20 text-xs font-semibold text-[#d04200] dark:text-[#f54e00]">
          <span class="w-2 h-2 rounded-full bg-[#f54e00]"></span>
          <span>100% In-Browser & Private • Free Full Resolution</span>
        </div>
      </div>

      <!-- Sample Cards Row (Clickable 8px Thumbnail Cards) -->
      <div class="mt-4 sm:mt-6 flex flex-wrap items-center justify-center gap-2 sm:gap-3.5">
        <span class="text-xs sm:text-sm font-medium text-[#5a5852] dark:text-[#a09c92] w-full text-center sm:w-auto">Try with a sample:</span>

        <button
          type="button"
          data-sample="/samples/portrait.jpg"
          class="sample-btn flex items-center gap-2 sm:gap-3 p-1.5 pr-3 sm:p-2 sm:pr-4 rounded-md bg-[#f7f7f4] dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] hover:border-[#f54e00] hover:shadow-xs transition-all cursor-pointer group/card"
        >
          <img src="/samples/portrait.jpg" alt="Portrait photo background removal sample" class="w-8 h-8 sm:w-10 sm:h-10 rounded-md object-cover group-hover/card:scale-105 transition-transform" />
          <div class="text-left">
            <div class="text-xs sm:text-sm font-semibold text-[#26251e] dark:text-[#ededed] group-hover/card:text-[#d04200] dark:group-hover/card:text-[#f54e00]">Portrait</div>
            <div class="text-[10px] sm:text-xs text-[#807d72] dark:text-[#a09c92]">Headshot & People</div>
          </div>
        </button>

        <button
          type="button"
          data-sample="/samples/signature.jpg"
          class="sample-btn flex items-center gap-2 sm:gap-3 p-1.5 pr-3 sm:p-2 sm:pr-4 rounded-md bg-[#f7f7f4] dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] hover:border-[#f54e00] hover:shadow-xs transition-all cursor-pointer group/card"
        >
          <img src="/samples/signature.jpg" alt="Handwritten signature transparency sample" class="w-8 h-8 sm:w-10 sm:h-10 rounded-md object-cover bg-white group-hover/card:scale-105 transition-transform" />
          <div class="text-left">
            <div class="text-xs sm:text-sm font-semibold text-[#26251e] dark:text-[#ededed] group-hover/card:text-[#d04200] dark:group-hover/card:text-[#f54e00]">Signature</div>
            <div class="text-[10px] sm:text-xs text-[#807d72] dark:text-[#a09c92]">Ink & Documents</div>
          </div>
        </button>

        <button
          type="button"
          data-sample="/samples/product.jpg"
          class="sample-btn flex items-center gap-2 sm:gap-3 p-1.5 pr-3 sm:p-2 sm:pr-4 rounded-md bg-[#f7f7f4] dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] hover:border-[#f54e00] hover:shadow-xs transition-all cursor-pointer group/card"
        >
          <img src="/samples/product.jpg" alt="E-commerce product background removal sample" class="w-8 h-8 sm:w-10 sm:h-10 rounded-md object-cover group-hover/card:scale-105 transition-transform" />
          <div class="text-left">
            <div class="text-xs sm:text-sm font-semibold text-[#26251e] dark:text-[#ededed] group-hover/card:text-[#d04200] dark:group-hover/card:text-[#f54e00]">Product</div>
            <div class="text-[10px] sm:text-xs text-[#807d72] dark:text-[#a09c92]">Commercial Object</div>
          </div>
        </button>
      </div>
    </div>

    <!-- STATE 2: PROCESSING VIEW -->
    <div id="processing-view" class="hidden flex flex-col items-center justify-center min-h-[420px] p-8 text-center">
      <div class="w-12 h-12 rounded-full border-3 border-[#f54e00]/20 border-t-[#f54e00] animate-spin mb-5"></div>

      <div class="space-y-2 max-w-md w-full">
        <h3 id="processing-title" class="text-lg font-bold text-[#26251e] dark:text-white">
          Removing background locally...
        </h3>
        <p id="processing-subtitle" class="text-sm text-[#5a5852] dark:text-[#a09c92]">
          Running in-browser WebAssembly neural engine...
        </p>

        <!-- Progress Bar with Cursor Orange Fill -->
        <div class="w-full bg-[#efeee8] dark:bg-[#121212] border border-[#e6e5e0] dark:border-[#2e2e33] rounded-full h-2 mt-4 overflow-hidden">
          <div id="progress-bar-fill" class="bg-[#f54e00] h-full w-12 transition-all duration-200 rounded-full"></div>
        </div>

        <p class="text-xs text-[#807d72] dark:text-[#706e68] pt-2">
          Model weights are cached locally. Your image is never uploaded to any server.
        </p>
      </div>

      <button
        id="cancel-processing-btn"
        type="button"
        class="mt-6 text-sm font-medium text-[#5a5852] hover:text-[#26251e] dark:text-[#a09c92] dark:hover:text-white underline underline-offset-4 cursor-pointer"
      >
        Cancel
      </button>
    </div>

    <!-- STATE 3: RESULT VIEW (INTERACTIVE BEFORE/AFTER SLIDER & INLINE CONTROLS) -->
    <div id="result-view" class="hidden flex flex-col space-y-3.5">
      <!-- Toolbar Header: Resolution badge & Ratio Segmented Controls -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5 pb-2.5 border-b border-[#e6e5e0] dark:border-[#2e2e33]">
        <!-- Left: Image Resolution & Size Badge -->
        <div class="flex items-center justify-between sm:justify-start gap-2">
          <span class="inline-flex items-center gap-2 px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-md bg-[#f54e00]/10 border border-[#f54e00]/20 text-[11px] sm:text-xs font-semibold text-[#d04200] dark:text-[#f54e00] font-mono">
            <span class="w-2 h-2 rounded-full bg-[#f54e00]"></span>
            <span id="meta-res-badge">HD READY</span>
          </span>
          <span id="meta-size-badge" class="text-xs font-medium text-[#807d72] dark:text-[#a09c92] font-mono hidden sm:inline-block"></span>
        </div>

        <!-- Right: Canvas Ratio Controls & 50% Split Reset -->
        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-1 max-w-full">
          <div class="flex items-center gap-1.5 text-xs font-mono text-[#807d72] dark:text-[#a09c92] hidden md:flex shrink-0">
            <svg class="w-3.5 h-3.5 text-[#f54e00]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
            </svg>
            <span>Ratio:</span>
          </div>

          <div id="ratio-selector" class="flex items-center p-1 rounded-md border border-[#e6e5e0] dark:border-[#2e2e33] bg-[#efeee8] dark:bg-[#121212] gap-1 shadow-xs text-xs font-mono shrink-0">
            <button
              type="button"
              data-ratio="original"
              class="ratio-btn active py-1.5 px-2.5 sm:px-3 rounded-md font-semibold text-[#d04200] dark:text-[#f54e00] bg-white dark:bg-[#242428] shadow-xs cursor-pointer transition-all border border-[#f54e00]/20 shrink-0 whitespace-nowrap"
            >
              Original
            </button>
            <button
              type="button"
              data-ratio="1:1"
              class="ratio-btn py-1.5 px-2.5 sm:px-3 rounded-md font-medium text-[#5a5852] dark:text-[#a09c92] hover:text-[#d04200] dark:hover:text-[#f54e00] cursor-pointer transition-all border border-transparent shrink-0 whitespace-nowrap"
            >
              1:1
            </button>
            <button
              type="button"
              data-ratio="16:9"
              class="ratio-btn py-1.5 px-2.5 sm:px-3 rounded-md font-medium text-[#5a5852] dark:text-[#a09c92] hover:text-[#d04200] dark:hover:text-[#f54e00] cursor-pointer transition-all border border-transparent shrink-0 whitespace-nowrap"
            >
              16:9
            </button>
            <button
              type="button"
              data-ratio="passport"
              class="ratio-btn py-1.5 px-2.5 sm:px-3 rounded-md font-medium text-[#5a5852] dark:text-[#a09c92] hover:text-[#d04200] dark:hover:text-[#f54e00] cursor-pointer transition-all border border-transparent shrink-0 whitespace-nowrap"
            >
              Passport
            </button>
          </div>

          <button
            id="reset-slider-btn"
            type="button"
            title="Reset slider to 50% center"
            class="shrink-0 py-1.5 px-2.5 rounded-md border border-[#e6e5e0] dark:border-[#2e2e33] bg-white dark:bg-[#1c1c1f] text-xs font-mono font-medium text-[#5a5852] dark:text-[#a09c92] hover:text-[#d04200] dark:hover:text-[#f54e00] hover:border-[#f54e00] transition-all shadow-xs cursor-pointer whitespace-nowrap"
          >
            50%
          </button>
        </div>
      </div>

      <!-- INTERACTIVE BEFORE/AFTER PREVIEW SLIDER VIEWPORT -->
      <div
        id="preview-container"
        class="w-full relative min-h-[440px] sm:min-h-[500px] rounded-lg border border-[#e6e5e0] dark:border-[#2e2e33] flex items-center justify-center overflow-hidden bg-[#efeee8]/50 dark:bg-[#151518] transition-colors select-none p-3 sm:p-4"
      >
        <!-- Bounding Stage Box for Ratio Containment & Dragging -->
        <div
          id="stage-box"
          class="relative flex items-center justify-center transition-all overflow-hidden rounded-md max-h-[440px] sm:max-h-[480px] max-w-full select-none cursor-ew-resize touch-none shadow-xs border border-[#cfcdc4] dark:border-[#3e3e44]"
          style="--slider-pos: 50%; touch-action: none;"
        >
          <!-- LAYER 1: BASE (ORIGINAL UPLOADED IMAGE - LEFT SIDE) -->
          <div id="slider-base-layer" class="w-full h-full relative flex items-center justify-center overflow-hidden bg-[#f7f7f4] dark:bg-[#121212]">
            <img
              id="preview-original-img"
              alt="Original uploaded image preview"
              class="max-h-[420px] sm:max-h-[480px] w-auto max-w-full object-contain pointer-events-none select-none"
            />
            <!-- Left Badge: Original -->
            <span class="absolute top-3 left-3 text-xs font-mono font-semibold text-[#5a5852] dark:text-[#a09c92] bg-white/95 dark:bg-[#1c1c1f]/95 px-2.5 py-1 rounded-md border border-[#e6e5e0] dark:border-[#2e2e33] shadow-xs pointer-events-none z-20 backdrop-blur-xs">
              ORIGINAL
            </span>
          </div>

          <!-- LAYER 2: CLIPPED OVERLAY (CUTOUT + BACKDROP - RIGHT SIDE) -->
          <div
            id="slider-cutout-layer"
            class="absolute inset-0 z-10 overflow-hidden pointer-events-none flex items-center justify-center transition-none"
            style="clip-path: inset(0 0 0 var(--slider-pos, 50%));"
          >
            <!-- Background Layer (Checkerboard, Solid Color, or Custom BG Image + Blur) -->
            <div id="stage-bg-layer" class="absolute inset-0 z-0 bg-checkerboard transition-all overflow-hidden pointer-events-none">
              <img id="custom-bg-preview-img" alt="Custom background image preview" class="hidden w-full h-full object-cover transition-all" />
            </div>

            <!-- Foreground Cutout Image (Identical size & containment as original) -->
            <img
              id="preview-cutout-img"
              alt="Transparent background cutout preview"
              class="max-h-[420px] sm:max-h-[480px] w-auto max-w-full object-contain relative z-10 pointer-events-none select-none drop-shadow-xs"
            />

            <!-- Right Badge: Cutout -->
            <span class="absolute top-3 right-3 text-xs font-mono font-semibold text-[#d04200] dark:text-[#f54e00] bg-white/95 dark:bg-[#1c1c1f]/95 px-2.5 py-1 rounded-md border border-[#f54e00]/20 shadow-xs pointer-events-none z-20 backdrop-blur-xs">
              CUTOUT
            </span>
          </div>

          <!-- CENTER DRAGGABLE DIVIDER -->
          <div
            id="slider-divider"
            class="absolute top-0 bottom-0 z-30 pointer-events-none flex items-center justify-center transition-none"
            style="left: var(--slider-pos, 50%); transform: translateX(-50%);"
          >
            <!-- Divider Vertical Bar (#d04200 active accent) -->
            <div class="w-0.5 h-full bg-[#f54e00] shadow-[0_0_8px_rgba(245,78,0,0.6)]"></div>

            <!-- Grab Handle Pill with Left/Right Arrows (↔) -->
            <div
              id="slider-handle"
              class="absolute w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white dark:bg-[#1c1c1f] border-2 border-[#f54e00] shadow-md flex items-center justify-center text-[#d04200] dark:text-[#f54e00] pointer-events-auto cursor-ew-resize hover:scale-110 active:scale-95 transition-transform"
              style="touch-action: none;"
              title="Drag left or right to inspect cutout contours (60fps)"
            >
              <svg class="w-4 h-4 text-[#d04200] dark:text-[#f54e00]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="8 17 3 12 8 7"/>
                <polyline points="16 7 21 12 16 17"/>
              </svg>
            </div>
          </div>
        </div>
      </div>

      <!-- INLINE ACTION CONTROLS: ROW 1 (BACKDROP & BLUR SLIDER) -->
      <div class="flex flex-wrap items-center justify-between gap-2 sm:gap-3 pt-1">
        <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
          <span class="text-xs font-mono text-[#807d72] dark:text-[#a09c92] hidden sm:inline">Backdrop:</span>
          <!-- Background Color Segmented Pill -->
          <div class="flex flex-wrap items-center p-1 rounded-md border border-[#e6e5e0] dark:border-[#2e2e33] bg-[#efeee8] dark:bg-[#121212] gap-1 shadow-xs max-w-full">
            <!-- Transparent Checkerboard Toggle -->
            <button
              id="bg-btn-transparent"
              type="button"
              title="Transparent Checkerboard"
              class="bg-color-btn active py-1.5 px-2.5 sm:px-3 rounded-md text-xs sm:text-sm font-semibold flex items-center gap-1.5 transition-all text-[#d04200] dark:text-[#f54e00] bg-white dark:bg-[#242428] shadow-xs cursor-pointer border border-[#f54e00]/20 shrink-0"
              data-bg="transparent"
            >
              <div class="w-3.5 h-3.5 rounded-sm bg-checkerboard-dense border border-zinc-300 dark:border-zinc-600"></div>
              <span>Transparent</span>
            </button>

            <!-- Pure White (#FFFFFF) -->
            <button
              id="bg-btn-white"
              type="button"
              title="Pure White (#FFFFFF)"
              class="bg-color-btn py-1.5 px-2.5 sm:px-3 rounded-md text-xs sm:text-sm font-medium flex items-center gap-1.5 transition-all text-[#5a5852] dark:text-[#a09c92] hover:text-[#d04200] dark:hover:text-[#f54e00] cursor-pointer border border-transparent shrink-0"
              data-bg="#FFFFFF"
            >
              <div class="w-3.5 h-3.5 rounded-sm bg-white border border-zinc-300"></div>
              <span>White</span>
            </button>

            <!-- Royal / Passport Blue (#2563EB) -->
            <button
              id="bg-btn-blue"
              type="button"
              title="Royal / Passport Blue (#2563EB)"
              class="bg-color-btn py-1.5 px-2.5 sm:px-3 rounded-md text-xs sm:text-sm font-medium flex items-center gap-1.5 transition-all text-[#5a5852] dark:text-[#a09c92] hover:text-[#d04200] dark:hover:text-[#f54e00] cursor-pointer border border-transparent shrink-0"
              data-bg="#2563EB"
            >
              <div class="w-3.5 h-3.5 rounded-sm bg-[#2563EB] border border-blue-400/40"></div>
              <span>Blue</span>
            </button>

            <!-- Custom Color Picker -->
            <label
              title="Custom Hex Color"
              class="relative flex items-center gap-1.5 py-1.5 px-2 sm:px-2.5 rounded-md text-xs sm:text-sm font-medium text-[#5a5852] dark:text-[#a09c92] hover:text-[#d04200] dark:hover:text-[#f54e00] cursor-pointer border border-transparent shrink-0"
            >
              <input type="color" id="custom-color-picker" value="#000000" class="sr-only" />
              <div id="custom-color-swatch" class="w-3.5 h-3.5 rounded-sm border border-zinc-300 dark:border-zinc-600 bg-black"></div>
              <span>Color</span>
            </label>

            <!-- [+] Custom BG Image File Input -->
            <button
              id="bg-btn-custom-image"
              type="button"
              title="Upload Custom Backdrop Image"
              class="bg-color-btn py-1.5 px-2 sm:px-2.5 rounded-md text-xs sm:text-sm font-medium flex items-center gap-1.5 transition-all text-[#5a5852] dark:text-[#a09c92] hover:text-[#d04200] dark:hover:text-[#f54e00] cursor-pointer border border-transparent shrink-0"
            >
              <svg class="w-3.5 h-3.5 text-[#f54e00]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
              <span>[+] Custom BG</span>
            </button>
            <input type="file" id="custom-bg-input" accept="image/png, image/jpeg, image/webp" class="hidden" />
          </div>

          <!-- Discrete Backdrop Blur Range Slider (Visible when custom backdrop or solid color is active) -->
          <div id="blur-control-wrapper" class="hidden items-center gap-2 px-3 py-1 rounded-md border border-[#e6e5e0] dark:border-[#2e2e33] bg-[#efeee8] dark:bg-[#121212] shadow-xs text-xs font-mono">
            <span class="text-[#5a5852] dark:text-[#a09c92]">Blur:</span>
            <input
              type="range"
              id="backdrop-blur-slider"
              min="0"
              max="20"
              value="0"
              step="1"
              class="w-18 sm:w-20 h-1.5 accent-[#f54e00] cursor-pointer"
              title="Adjust backdrop blur (0-20px)"
            />
            <span id="blur-value-label" class="w-7 text-right font-semibold text-[#26251e] dark:text-white">0px</span>
          </div>
        </div>

        <span class="text-xs font-mono text-[#807d72] dark:text-[#706e68] hidden md:inline">
          Drag ↔ slider to inspect edges live
        </span>
      </div>

      <!-- Action Bar: Prominent Primary Button & Secondary Actions -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-2">
        <!-- Right Action Group (Shown First on Mobile via order-1 sm:order-2) -->
        <div class="w-full sm:w-auto flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 order-1 sm:order-2">
          <!-- Primary Hero Button: Download Full HD PNG (Full width on mobile for easy one-tap export) -->
          <button
            id="download-hd-btn"
            type="button"
            class="w-full sm:w-auto h-12 sm:h-11 px-7 rounded-md bg-[#f54e00] hover:bg-[#d04200] active:bg-[#b03800] text-white text-sm sm:text-base font-semibold transition-all flex items-center justify-center gap-2.5 shadow-xs hover:shadow cursor-pointer active:scale-[0.99] order-1 sm:order-3"
          >
            <svg class="w-5 h-5 text-white shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <span class="whitespace-nowrap">Download Full HD PNG</span>
          </button>

          <!-- Secondary Actions: Clean 2-Column Grid on Mobile, Inline on Desktop -->
          <div class="w-full sm:w-auto grid grid-cols-2 sm:flex items-center gap-2 sm:gap-2.5 order-2 sm:order-1">
            <!-- Copy to Clipboard Button -->
            <button
              id="copy-clipboard-btn"
              type="button"
              class="w-full sm:w-auto h-11 px-3 sm:px-4 rounded-md bg-white dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] hover:border-[#f54e00] text-xs sm:text-sm font-medium text-[#26251e] dark:text-[#ededed] hover:text-[#d04200] dark:hover:text-[#f54e00] transition-all flex items-center justify-center gap-1.5 sm:gap-2 cursor-pointer shadow-xs"
              title="Copy cutout image to clipboard"
            >
              <svg class="w-4 h-4 text-[#f54e00] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
              </svg>
              <span id="copy-btn-text" class="truncate">Copy PNG</span>
            </button>

            <!-- DUAL EXPORT TRIGGER: Compressed JPG with discrete target selector -->
            <div class="w-full sm:w-auto flex items-center shadow-xs">
              <select
                id="jpg-preset-select"
                aria-label="JPG compression target"
                class="w-1/2 sm:w-auto h-11 pl-2 sm:pl-3 pr-1 sm:pr-2 rounded-l-md border border-r-0 border-[#e6e5e0] dark:border-[#2e2e33] bg-[#f7f7f4] dark:bg-[#1c1c1f] text-[11px] sm:text-xs font-mono font-medium text-[#26251e] dark:text-[#ededed] cursor-pointer focus:outline-none focus:border-[#f54e00]"
              >
                <option value="50kb">&lt;50KB</option>
                <option value="100kb" selected>&lt;100KB</option>
                <option value="max">Max</option>
              </select>
              <button
                id="export-jpg-btn"
                type="button"
                class="w-1/2 sm:w-auto h-11 px-2 sm:px-4 rounded-r-md border border-[#e6e5e0] dark:border-[#2e2e33] bg-white dark:bg-[#1c1c1f] hover:border-[#f54e00] text-[11px] sm:text-xs md:text-sm font-medium text-[#26251e] dark:text-[#ededed] hover:text-[#d04200] dark:hover:text-[#f54e00] transition-all flex items-center justify-center gap-1 sm:gap-1.5 cursor-pointer whitespace-nowrap"
                title="Export compressed JPG strictly below target threshold"
              >
                <svg class="w-3.5 sm:w-4 h-3.5 sm:h-4 text-[#f54e00] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                <span id="export-jpg-text">JPG</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Left: Upload Another (Order 2 on mobile so Download HD is top priority) -->
        <button
          id="upload-another-btn"
          type="button"
          class="w-full sm:w-auto h-11 px-5 rounded-md bg-[#f7f7f4] dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] hover:border-[#cfcdc4] dark:hover:border-[#3e3e44] text-xs sm:text-sm font-medium text-[#26251e] dark:text-[#ededed] transition-all flex items-center justify-center gap-2 cursor-pointer shadow-xs order-2 sm:order-1"
        >
          <svg class="w-4 h-4 text-[#807d72] dark:text-[#a09c92]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
          <span>Select New Image</span>
        </button>
      </div>
    </div>

    <!-- Error Toast Box -->
    <div id="error-box" class="hidden mt-4 p-3 rounded-md bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800/60 text-red-700 dark:text-red-200 text-sm font-medium flex items-center justify-between">
      <span id="error-message">Processing error.</span>
      <button id="close-error-btn" type="button" class="text-red-500 hover:text-red-700 dark:hover:text-red-200 ml-3">✕</button>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="paste-toast" class="fixed bottom-6 right-6 z-50 transform translate-y-12 opacity-0 pointer-events-none transition-all duration-200 bg-white dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] text-[#26251e] dark:text-white px-4 py-2.5 rounded-md shadow-lg flex items-center gap-2.5 text-sm font-medium">
    <span class="w-2 h-2 rounded-full bg-[#f54e00]"></span>
    <span id="paste-toast-text">Pasted image from clipboard</span>
  </div>
</section>

<script>
  import {
    createHdExportBlob,
    createCompressedJpgBlob,
    refineAlphaMask,
    triggerDownload,
    copyImageToClipboard,
    type CanvasRatio,
    type JpgCompressionPreset,
    type ExportOptions
  } from '../lib/canvasExport';

  // Global state
  let currentFile: File | Blob | null = null;
  let originalImageUrl: string | null = null;
  let cutoutBlob: Blob | null = null;
  let cutoutUrl: string | null = null;
  let currentBgColor: string = 'transparent';
  let customBgImageObj: HTMLImageElement | null = null;
  let customBgObjectUrl: string | null = null;
  let currentBlur: number = 0;
  let currentRatio: CanvasRatio = 'original';
  let imageNaturalWidth: number = 0;
  let imageNaturalHeight: number = 0;
  let isCancelled: boolean = false;

  // DOM Elements
  const sectionRoot = document.querySelector('section[data-default-bg]') as HTMLElement;
  const initialDefaultBg = sectionRoot?.dataset.defaultBg || 'transparent';

  const dropZone = document.getElementById('drop-zone') as HTMLElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const uploadView = document.getElementById('upload-view') as HTMLElement;
  const processingView = document.getElementById('processing-view') as HTMLElement;
  const resultView = document.getElementById('result-view') as HTMLElement;
  const errorBox = document.getElementById('error-box') as HTMLElement;
  const errorMessage = document.getElementById('error-message') as HTMLElement;
  const closeErrorBtn = document.getElementById('close-error-btn') as HTMLElement;
  const pasteToast = document.getElementById('paste-toast') as HTMLElement;
  const pasteToastText = document.getElementById('paste-toast-text') as HTMLElement;

  const processingTitle = document.getElementById('processing-title') as HTMLElement;
  const processingSubtitle = document.getElementById('processing-subtitle') as HTMLElement;
  const progressBarFill = document.getElementById('progress-bar-fill') as HTMLElement;
  const cancelProcessingBtn = document.getElementById('cancel-processing-btn') as HTMLElement;

  const previewContainer = document.getElementById('preview-container') as HTMLElement;
  const stageBox = document.getElementById('stage-box') as HTMLElement;
  const stageBgLayer = document.getElementById('stage-bg-layer') as HTMLElement;
  const customBgPreviewImg = document.getElementById('custom-bg-preview-img') as HTMLImageElement;
  const previewCutoutImg = document.getElementById('preview-cutout-img') as HTMLImageElement;
  const previewOriginalImg = document.getElementById('preview-original-img') as HTMLImageElement;
  const sliderDivider = document.getElementById('slider-divider') as HTMLElement;
  const sliderHandle = document.getElementById('slider-handle') as HTMLElement;
  const resetSliderBtn = document.getElementById('reset-slider-btn') as HTMLButtonElement;

  const metaResBadge = document.getElementById('meta-res-badge') as HTMLElement;
  const metaSizeBadge = document.getElementById('meta-size-badge') as HTMLElement;

  const bgBtnTransparent = document.getElementById('bg-btn-transparent') as HTMLButtonElement;
  const bgBtnWhite = document.getElementById('bg-btn-white') as HTMLButtonElement;
  const bgBtnBlue = document.getElementById('bg-btn-blue') as HTMLButtonElement;
  const customColorPicker = document.getElementById('custom-color-picker') as HTMLInputElement;
  const customColorSwatch = document.getElementById('custom-color-swatch') as HTMLElement;
  const bgBtnCustomImage = document.getElementById('bg-btn-custom-image') as HTMLButtonElement;
  const customBgInput = document.getElementById('custom-bg-input') as HTMLInputElement;

  const blurControlWrapper = document.getElementById('blur-control-wrapper') as HTMLElement;
  const backdropBlurSlider = document.getElementById('backdrop-blur-slider') as HTMLInputElement;
  const blurValueLabel = document.getElementById('blur-value-label') as HTMLElement;

  const ratioButtons = document.querySelectorAll('.ratio-btn');

  const uploadAnotherBtn = document.getElementById('upload-another-btn') as HTMLButtonElement;
  const copyClipboardBtn = document.getElementById('copy-clipboard-btn') as HTMLButtonElement;
  const copyBtnText = document.getElementById('copy-btn-text') as HTMLElement;
  const downloadHdBtn = document.getElementById('download-hd-btn') as HTMLButtonElement;
  const exportJpgBtn = document.getElementById('export-jpg-btn') as HTMLButtonElement;
  const exportJpgText = document.getElementById('export-jpg-text') as HTMLElement;
  const jpgPresetSelect = document.getElementById('jpg-preset-select') as HTMLInputElement;

  // Setup initial color mode based on page prop
  if (initialDefaultBg === 'white') {
    currentBgColor = '#FFFFFF';
  } else if (initialDefaultBg === 'passport-blue') {
    currentBgColor = '#0055A5';
  } else {
    currentBgColor = 'transparent';
  }

  function updateResolutionBadge() {
    if (!metaResBadge) return;
    if (currentRatio === 'original') {
      if (imageNaturalWidth && imageNaturalHeight) {
        metaResBadge.textContent = `${imageNaturalWidth} × ${imageNaturalHeight} PX HD`;
      } else {
        metaResBadge.textContent = 'FULL RESOLUTION HD';
      }
    } else if (currentRatio === '1:1') {
      const side = Math.max(imageNaturalWidth, imageNaturalHeight);
      metaResBadge.textContent = `1:1 • ${side} × ${side} PX HD`;
    } else if (currentRatio === '16:9') {
      metaResBadge.textContent = '16:9 (YOUTUBE) HD';
    } else if (currentRatio === 'passport') {
      metaResBadge.textContent = 'PASSPORT 3.5×4.5 CM';
    }
  }

  function setCanvasRatio(ratio: CanvasRatio) {
    currentRatio = ratio;
    const activeClasses = ['active', 'bg-white', 'dark:bg-[#242428]', 'text-[#d04200]', 'dark:text-[#f54e00]', 'font-semibold', 'shadow-xs', 'border-[#f54e00]/20'];
    const inactiveClasses = ['text-[#5a5852]', 'dark:text-[#a09c92]', 'border-transparent'];

    ratioButtons.forEach(btn => {
      if (btn.getAttribute('data-ratio') === ratio) {
        btn.classList.add(...activeClasses);
        btn.classList.remove(...inactiveClasses);
      } else {
        btn.classList.remove(...activeClasses);
        btn.classList.add(...inactiveClasses);
      }
    });

    if (!stageBox) return;

    if (ratio === 'original') {
      stageBox.style.aspectRatio = '';
      stageBox.style.width = 'auto';
      stageBox.style.height = 'auto';
      stageBox.classList.remove('border', 'border-[#cfcdc4]', 'dark:border-[#3e3e44]', 'shadow-xs');
      previewCutoutImg.style.width = 'auto';
      previewCutoutImg.style.height = 'auto';
      if (previewOriginalImg) {
        previewOriginalImg.style.width = 'auto';
        previewOriginalImg.style.height = 'auto';
      }
    } else if (ratio === '1:1') {
      stageBox.style.aspectRatio = '1 / 1';
      stageBox.style.width = 'min(100%, 460px)';
      stageBox.style.height = 'min(100%, 460px)';
      stageBox.classList.add('border', 'border-[#cfcdc4]', 'dark:border-[#3e3e44]', 'shadow-xs');
      previewCutoutImg.style.width = '100%';
      previewCutoutImg.style.height = '100%';
      if (previewOriginalImg) {
        previewOriginalImg.style.width = '100%';
        previewOriginalImg.style.height = '100%';
      }
    } else if (ratio === '16:9') {
      stageBox.style.aspectRatio = '16 / 9';
      stageBox.style.width = 'min(100%, 680px)';
      stageBox.style.height = 'auto';
      stageBox.classList.add('border', 'border-[#cfcdc4]', 'dark:border-[#3e3e44]', 'shadow-xs');
      previewCutoutImg.style.width = '100%';
      previewCutoutImg.style.height = '100%';
      if (previewOriginalImg) {
        previewOriginalImg.style.width = '100%';
        previewOriginalImg.style.height = '100%';
      }
    } else if (ratio === 'passport') {
      stageBox.style.aspectRatio = '3.5 / 4.5';
      stageBox.style.width = 'min(100%, 350px)';
      stageBox.style.height = 'min(100%, 450px)';
      stageBox.classList.add('border', 'border-[#cfcdc4]', 'dark:border-[#3e3e44]', 'shadow-xs');
      previewCutoutImg.style.width = '100%';
      previewCutoutImg.style.height = '100%';
      if (previewOriginalImg) {
        previewOriginalImg.style.width = '100%';
        previewOriginalImg.style.height = '100%';
      }
    }

    updateResolutionBadge();
  }

  ratioButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const r = btn.getAttribute('data-ratio') as CanvasRatio;
      if (r) setCanvasRatio(r);
    });
  });

  function clearCustomBg() {
    customBgImageObj = null;
    if (customBgObjectUrl) {
      URL.revokeObjectURL(customBgObjectUrl);
      customBgObjectUrl = null;
    }
    if (customBgPreviewImg) {
      customBgPreviewImg.classList.add('hidden');
      customBgPreviewImg.src = '';
      customBgPreviewImg.style.transform = 'none';
    }
    if (customBgInput) customBgInput.value = '';
  }

  function applyBgToElements(color: string) {
    const isTrans = color === 'transparent' && !customBgImageObj;
    const isWhite = color.toUpperCase() === '#FFFFFF';
    const isBlue = color.toUpperCase() === '#0055A5' || color.toUpperCase() === '#2563EB';
    const isCustomImg = !!customBgImageObj;

    // Update buttons
    const activeClasses = ['active', 'bg-white', 'dark:bg-[#242428]', 'text-[#d04200]', 'dark:text-[#f54e00]', 'font-semibold', 'shadow-xs', 'border-[#f54e00]/20'];
    const inactiveClasses = ['text-[#5a5852]', 'dark:text-[#a09c92]', 'border-transparent'];

    [bgBtnTransparent, bgBtnWhite, bgBtnBlue, bgBtnCustomImage].forEach(b => {
      if (b) {
        b.classList.remove(...activeClasses);
        b.classList.add(...inactiveClasses);
      }
    });

    if (isCustomImg && bgBtnCustomImage) {
      bgBtnCustomImage.classList.add(...activeClasses);
      bgBtnCustomImage.classList.remove(...inactiveClasses);
    } else if (isTrans && bgBtnTransparent) {
      bgBtnTransparent.classList.add(...activeClasses);
      bgBtnTransparent.classList.remove(...inactiveClasses);
    } else if (isWhite && bgBtnWhite) {
      bgBtnWhite.classList.add(...activeClasses);
      bgBtnWhite.classList.remove(...inactiveClasses);
    } else if (isBlue && bgBtnBlue) {
      bgBtnBlue.classList.add(...activeClasses);
      bgBtnBlue.classList.remove(...inactiveClasses);
    }

    // Blur slider visibility: visible when custom backdrop or solid color is active, hidden when transparent
    if (isTrans) {
      if (blurControlWrapper) {
        blurControlWrapper.classList.add('hidden');
        blurControlWrapper.classList.remove('flex');
      }
      currentBlur = 0;
      if (backdropBlurSlider) backdropBlurSlider.value = '0';
      if (blurValueLabel) blurValueLabel.textContent = '0px';
      if (stageBgLayer) stageBgLayer.style.filter = 'none';
      if (customBgPreviewImg) customBgPreviewImg.style.transform = 'none';
    } else {
      if (blurControlWrapper) {
        blurControlWrapper.classList.remove('hidden');
        blurControlWrapper.classList.add('flex');
      }
    }

    // Apply to preview backdrop layers
    if (stageBgLayer) {
      if (isCustomImg) {
        stageBgLayer.style.backgroundColor = 'transparent';
        stageBgLayer.classList.remove('bg-checkerboard');
      } else if (isTrans) {
        stageBgLayer.style.backgroundColor = '';
        stageBgLayer.classList.add('bg-checkerboard');
      } else {
        stageBgLayer.style.backgroundColor = color;
        stageBgLayer.classList.remove('bg-checkerboard');
        if (customColorSwatch) customColorSwatch.style.backgroundColor = color;
      }
    }
  }

  // Backdrop blur slider input
  if (backdropBlurSlider) {
    backdropBlurSlider.addEventListener('input', () => {
      currentBlur = parseInt(backdropBlurSlider.value, 10) || 0;
      if (blurValueLabel) blurValueLabel.textContent = `${currentBlur}px`;
      const filterVal = currentBlur > 0 ? `blur(${currentBlur}px)` : 'none';
      if (stageBgLayer) stageBgLayer.style.filter = filterVal;
      if (customBgPreviewImg) customBgPreviewImg.style.transform = currentBlur > 0 ? 'scale(1.08)' : 'none';
    });
  }

  // Custom background image file upload
  if (bgBtnCustomImage && customBgInput) {
    bgBtnCustomImage.addEventListener('click', () => {
      customBgInput.click();
    });

    customBgInput.addEventListener('change', () => {
      if (customBgInput.files && customBgInput.files[0]) {
        const file = customBgInput.files[0];
        if (customBgObjectUrl) URL.revokeObjectURL(customBgObjectUrl);
        customBgObjectUrl = URL.createObjectURL(file);

        const img = new Image();
        img.onload = () => {
          customBgImageObj = img;
          if (customBgPreviewImg) {
            customBgPreviewImg.src = customBgObjectUrl!;
            customBgPreviewImg.classList.remove('hidden');
          }
          applyBgToElements(currentBgColor);
        };
        img.src = customBgObjectUrl;
      }
    });
  }

  function showToast(text: string) {
    if (!pasteToast) return;
    pasteToastText.textContent = text;
    pasteToast.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
    pasteToast.classList.add('translate-y-0', 'opacity-100');
    setTimeout(() => {
      pasteToast.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
      pasteToast.classList.remove('translate-y-0', 'opacity-100');
    }, 2500);
  }

  function showError(msg: string) {
    if (errorBox && errorMessage) {
      errorMessage.textContent = msg;
      errorBox.classList.remove('hidden');
    }
  }

  function clearError() {
    if (errorBox) {
      errorBox.classList.add('hidden');
    }
  }

  if (closeErrorBtn) {
    closeErrorBtn.addEventListener('click', clearError);
  }

  function switchView(view: 'upload' | 'processing' | 'result') {
    clearError();
    uploadView.classList.add('hidden');
    processingView.classList.add('hidden');
    resultView.classList.add('hidden');

    if (view === 'upload') {
      uploadView.classList.remove('hidden');
    } else if (view === 'processing') {
      processingView.classList.remove('hidden');
    } else if (view === 'result') {
      resultView.classList.remove('hidden');
    }
  }

  function setSliderPercentage(pct: number) {
    const clamped = Math.max(0, Math.min(100, pct));
    if (stageBox) {
      stageBox.style.setProperty('--slider-pos', `${clamped.toFixed(2)}%`);
    }
  }

  function resetAll() {
    isCancelled = true;
    currentFile = null;
    clearCustomBg();
    currentBlur = 0;
    backdropBlurSlider.value = '0';
    blurValueLabel.textContent = '0px';
    currentRatio = 'original';
    setCanvasRatio('original');
    setSliderPercentage(50);

    if (originalImageUrl) {
      URL.revokeObjectURL(originalImageUrl);
      originalImageUrl = null;
    }
    if (cutoutUrl) {
      URL.revokeObjectURL(cutoutUrl);
      cutoutUrl = null;
    }
    cutoutBlob = null;
    fileInput.value = '';
    switchView('upload');
  }

  if (uploadAnotherBtn) uploadAnotherBtn.addEventListener('click', resetAll);
  if (cancelProcessingBtn) cancelProcessingBtn.addEventListener('click', resetAll);

  // Background toggle clicks
  if (bgBtnTransparent) {
    bgBtnTransparent.addEventListener('click', () => {
      currentBgColor = 'transparent';
      clearCustomBg();
      applyBgToElements(currentBgColor);
    });
  }

  if (bgBtnWhite) {
    bgBtnWhite.addEventListener('click', () => {
      currentBgColor = '#FFFFFF';
      clearCustomBg();
      applyBgToElements(currentBgColor);
    });
  }

  if (bgBtnBlue) {
    bgBtnBlue.addEventListener('click', () => {
      currentBgColor = '#2563EB';
      clearCustomBg();
      applyBgToElements(currentBgColor);
    });
  }

  if (customColorPicker) {
    customColorPicker.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      currentBgColor = val;
      clearCustomBg();
      applyBgToElements(currentBgColor);
    });
  }

  // 60FPS Interactive Before/After Split Slider Drag Logic (Pointer Events API)
  let isDraggingSlider = false;
  let pendingSliderPos: number | null = null;
  let rafId: number | null = null;

  function updateSliderFromClientX(clientX: number) {
    if (!stageBox) return;
    const rect = stageBox.getBoundingClientRect();
    if (rect.width <= 0) return;
    const rawPct = ((clientX - rect.left) / rect.width) * 100;
    pendingSliderPos = Math.max(0, Math.min(100, rawPct));

    if (rafId === null) {
      rafId = requestAnimationFrame(() => {
        if (pendingSliderPos !== null && stageBox) {
          stageBox.style.setProperty('--slider-pos', `${pendingSliderPos.toFixed(2)}%`);
        }
        rafId = null;
      });
    }
  }

  function onPointerDown(e: PointerEvent) {
    isDraggingSlider = true;
    try {
      (e.currentTarget as HTMLElement)?.setPointerCapture?.(e.pointerId);
    } catch (_) {}
    updateSliderFromClientX(e.clientX);
  }

  function onPointerMove(e: PointerEvent) {
    if (!isDraggingSlider) return;
    updateSliderFromClientX(e.clientX);
  }

  function onPointerUp(e: PointerEvent) {
    if (isDraggingSlider) {
      isDraggingSlider = false;
      try {
        (e.currentTarget as HTMLElement)?.releasePointerCapture?.(e.pointerId);
      } catch (_) {}
    }
  }

  // Touch Event Handlers for Thumb Dragging on Mobile Devices
  function onTouchStart(e: TouchEvent) {
    if (e.touches && e.touches.length > 0) {
      isDraggingSlider = true;
      updateSliderFromClientX(e.touches[0].clientX);
    }
  }

  function onTouchMove(e: TouchEvent) {
    if (!isDraggingSlider) return;
    if (e.touches && e.touches.length > 0) {
      if (e.cancelable) e.preventDefault();
      updateSliderFromClientX(e.touches[0].clientX);
    }
  }

  function onTouchEnd() {
    if (isDraggingSlider) {
      isDraggingSlider = false;
    }
  }

  // Mouse fallback handlers
  function onMouseDown(e: MouseEvent) {
    isDraggingSlider = true;
    updateSliderFromClientX(e.clientX);
  }

  function onMouseMove(e: MouseEvent) {
    if (!isDraggingSlider) return;
    updateSliderFromClientX(e.clientX);
  }

  function onMouseUp() {
    if (isDraggingSlider) isDraggingSlider = false;
  }

  if (stageBox) {
    // Pointer Events API
    stageBox.addEventListener('pointerdown', onPointerDown);
    stageBox.addEventListener('pointermove', onPointerMove);
    stageBox.addEventListener('pointerup', onPointerUp);
    stageBox.addEventListener('pointercancel', onPointerUp);

    // Explicit Touch Events with passive: false for smooth non-scrolling thumb drag
    stageBox.addEventListener('touchstart', onTouchStart, { passive: false });
    stageBox.addEventListener('touchmove', onTouchMove, { passive: false });
    stageBox.addEventListener('touchend', onTouchEnd);
    stageBox.addEventListener('touchcancel', onTouchEnd);

    // Mouse fallback
    stageBox.addEventListener('mousedown', onMouseDown);
  }

  // Global window listeners for drag continuation outside container
  window.addEventListener('pointermove', (e: PointerEvent) => {
    if (isDraggingSlider) updateSliderFromClientX(e.clientX);
  });
  window.addEventListener('pointerup', () => {
    if (isDraggingSlider) isDraggingSlider = false;
  });
  window.addEventListener('pointercancel', () => {
    if (isDraggingSlider) isDraggingSlider = false;
  });

  window.addEventListener('touchmove', (e: TouchEvent) => {
    if (isDraggingSlider && e.touches && e.touches.length > 0) {
      if (e.cancelable) e.preventDefault();
      updateSliderFromClientX(e.touches[0].clientX);
    }
  }, { passive: false });
  window.addEventListener('touchend', onTouchEnd);
  window.addEventListener('touchcancel', onTouchEnd);

  window.addEventListener('mousemove', onMouseMove);
  window.addEventListener('mouseup', onMouseUp);

  if (resetSliderBtn) {
    resetSliderBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      setSliderPercentage(50);
    });
  }

  // Core Processing Routine
  async function processImage(file: File | Blob) {
    try {
      isCancelled = false;
      currentFile = file;
      clearError();

      if (file.size > 25 * 1024 * 1024) {
        showError('Image exceeds 25MB limit. Please choose a smaller file.');
        return;
      }

      if (originalImageUrl) URL.revokeObjectURL(originalImageUrl);
      originalImageUrl = URL.createObjectURL(file);
      previewOriginalImg.src = originalImageUrl;

      const imgProbe = new Image();
      imgProbe.src = originalImageUrl;
      await new Promise((resolve) => {
        imgProbe.onload = () => {
          imageNaturalWidth = imgProbe.naturalWidth;
          imageNaturalHeight = imgProbe.naturalHeight;
          resolve(null);
        };
        imgProbe.onerror = () => resolve(null);
      });

      switchView('processing');
      progressBarFill.style.width = '15%';
      processingTitle.textContent = 'Initializing in-browser neural engine...';
      processingSubtitle.textContent = 'Loading WebAssembly runtime...';

      const { removeBackground } = await import('@imgly/background-removal');

      if (isCancelled) return;

      progressBarFill.style.width = '35%';
      processingTitle.textContent = 'Segmenting foreground...';
      processingSubtitle.textContent = 'Calculating pixel contours in browser RAM...';

      const rawBlob = await removeBackground(file, {
        progress: (key: string, current: number, total: number) => {
          if (isCancelled) return;
          if (total > 0) {
            const pct = Math.min(94, Math.round((current / total) * 100));
            progressBarFill.style.width = `${Math.max(35, pct)}%`;
          }
          if (key.includes('fetch')) {
            processingSubtitle.textContent = 'Caching model weights locally in browser (~20MB)...';
          } else if (key.includes('compute')) {
            processingSubtitle.textContent = 'Executing inference via WebAssembly...';
          }
        },
        model: 'medium',
        output: {
          format: 'image/png',
          quality: 1.0,
          type: 'foreground'
        }
      });

      if (isCancelled) return;

      progressBarFill.style.width = '97%';
      processingTitle.textContent = 'Refining alpha contours & edge feathering...';
      processingSubtitle.textContent = 'Applying PhotoRoom-grade trimap thresholding & perimeter erosion...';

      const resultBlob = await refineAlphaMask(rawBlob, file);

      if (isCancelled) return;

      progressBarFill.style.width = '100%';
      processingTitle.textContent = 'Compositing full HD PNG...';

      cutoutBlob = resultBlob;
      if (cutoutUrl) URL.revokeObjectURL(cutoutUrl);
      cutoutUrl = URL.createObjectURL(resultBlob);

      previewCutoutImg.src = cutoutUrl;

      updateResolutionBadge();

      const mbSize = (resultBlob.size / (1024 * 1024)).toFixed(2);
      metaSizeBadge.textContent = `${mbSize} MB PNG`;

      applyBgToElements(currentBgColor);
      setSliderPercentage(50);

      setTimeout(() => {
        if (!isCancelled) {
          switchView('result');
        }
      }, 200);

    } catch (err: any) {
      console.error('Background removal error:', err);
      if (!isCancelled) {
        switchView('upload');
        showError(err?.message || 'Processing failed. Please check your image format.');
      }
    }
  }

  if (dropZone && fileInput) {
    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput.click();
      }
    });

    ['dragenter', 'dragover'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.add('border-[#f54e00]', 'bg-[#f54e00]/5', 'dark:bg-[#f54e00]/10');
      }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.remove('border-[#f54e00]', 'bg-[#f54e00]/5', 'dark:bg-[#f54e00]/10');
      }, false);
    });

    dropZone.addEventListener('drop', (e) => {
      const dt = e.dataTransfer;
      if (dt && dt.files && dt.files[0]) {
        const file = dt.files[0];
        if (file.type.startsWith('image/')) {
          processImage(file);
        } else {
          showError('Please drop a valid image (PNG, JPG, or WebP).');
        }
      }
    });
  }

  if (fileInput) {
    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files[0]) {
        processImage(fileInput.files[0]);
      }
    });
  }

  window.addEventListener('paste', (e) => {
    const clipboardData = e.clipboardData;
    if (!clipboardData) return;

    const items = clipboardData.items;
    for (let i = 0; i < items.length; i++) {
      if (items[i].type.indexOf('image') !== -1) {
        const file = items[i].getAsFile();
        if (file) {
          showToast('Image pasted from clipboard');
          processImage(file);
          break;
        }
      }
    }
  });

  const sampleButtons = document.querySelectorAll('.sample-btn');
  sampleButtons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const sampleUrl = btn.getAttribute('data-sample');
      if (!sampleUrl) return;

      try {
        switchView('processing');
        if (processingTitle) processingTitle.textContent = 'Loading sample image...';
        if (progressBarFill) progressBarFill.style.width = '10%';

        const response = await fetch(sampleUrl);
        if (!response.ok) throw new Error('Could not load sample');
        const blob = await response.blob();
        await processImage(blob);
      } catch (err: any) {
        switchView('upload');
        showError('Failed to load sample: ' + err.message);
      }
    });
  });

  // Primary Export: Download Full HD PNG
  if (downloadHdBtn) {
    downloadHdBtn.addEventListener('click', async () => {
      if (!cutoutBlob) return;
      try {
        downloadHdBtn.disabled = true;
        downloadHdBtn.classList.add('opacity-75');

        const originalName = currentFile instanceof File ? currentFile.name.replace(/\.[^/.]+$/, "") : 'cutout';
        const filename = `${originalName}-fastbgremove-hd.png`;

        const exportOpts: ExportOptions = {
          ratio: currentRatio,
          backgroundColor: currentBgColor,
          customBgImage: customBgImageObj,
          blur: currentBlur
        };

        const finalBlob = await createHdExportBlob(cutoutBlob, exportOpts);
        triggerDownload(finalBlob, filename);
        showToast('Download started');
      } catch (err) {
        console.error('Export download error:', err);
        showError('Failed to export HD PNG.');
      } finally {
        downloadHdBtn.disabled = false;
        downloadHdBtn.classList.remove('opacity-75');
      }
    });
  }

  // Secondary Export: Export Compressed JPG (Binary Search)
  if (exportJpgBtn) {
    exportJpgBtn.addEventListener('click', async () => {
      if (!cutoutBlob) return;
      try {
        exportJpgBtn.disabled = true;
        const originalBtnText = exportJpgText ? exportJpgText.textContent : 'Export JPG';
        if (exportJpgText) exportJpgText.textContent = 'Optimizing...';

        const preset = ((jpgPresetSelect ? jpgPresetSelect.value : '100kb') as JpgCompressionPreset) || '100kb';
        const exportOpts: ExportOptions = {
          ratio: currentRatio,
          backgroundColor: currentBgColor,
          customBgImage: customBgImageObj,
          blur: currentBlur
        };

        const finalBlob = await createCompressedJpgBlob(cutoutBlob, preset, exportOpts);
        const originalName = currentFile instanceof File ? currentFile.name.replace(/\.[^/.]+$/, "") : 'cutout';
        const filename = `${originalName}-fastbgremove-${preset}.jpg`;

        triggerDownload(finalBlob, filename);
        const sizeKb = (finalBlob.size / 1024).toFixed(1);
        showToast(`JPG downloaded (${sizeKb} KB)`);
        if (exportJpgText) exportJpgText.textContent = originalBtnText;
      } catch (err) {
        console.error('JPG export error:', err);
        showError('Failed to export compressed JPG.');
        if (exportJpgText) exportJpgText.textContent = 'Export JPG';
      } finally {
        exportJpgBtn.disabled = false;
      }
    });
  }

  // Copy to Clipboard
  if (copyClipboardBtn) {
    copyClipboardBtn.addEventListener('click', async () => {
      if (!cutoutBlob) return;
      try {
        copyClipboardBtn.disabled = true;
        const originalText = copyBtnText ? copyBtnText.textContent : 'Copy PNG';
        if (copyBtnText) copyBtnText.textContent = 'Copying...';

        const exportOpts: ExportOptions = {
          ratio: currentRatio,
          backgroundColor: currentBgColor,
          customBgImage: customBgImageObj,
          blur: currentBlur
        };

        const finalBlob = await createHdExportBlob(cutoutBlob, exportOpts);
        const success = await copyImageToClipboard(finalBlob);

        if (success) {
          if (copyBtnText) copyBtnText.textContent = 'Copied!';
          showToast('Cutout copied to clipboard');
          setTimeout(() => {
            if (copyBtnText) copyBtnText.textContent = originalText;
            copyClipboardBtn.disabled = false;
          }, 2000);
        } else {
          if (copyBtnText) copyBtnText.textContent = 'Failed';
          showError('Clipboard copy is not supported in this browser.');
          setTimeout(() => {
            if (copyBtnText) copyBtnText.textContent = originalText;
            copyClipboardBtn.disabled = false;
          }, 2000);
        }
      } catch (err) {
        console.error('Clipboard copy error:', err);
        copyClipboardBtn.disabled = false;
      }
    });
  }
</script>
