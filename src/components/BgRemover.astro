  function showToast(text: string) {
    if (!pasteToast) return;
    pasteToastText.textContent = text;
    pasteToast.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
    pasteToast.classList.add('translate-y-0', 'opacity-100');
    setTimeout(() => {
      pasteToast.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
      pasteToast.classList.remove('translate-y-0', 'opacity-100');
    }, 2500);
  }

  function showError(msg: any) {
    if (errorBox && errorMessage) {
      let text = 'An unexpected error occurred.';
      if (typeof msg === 'string' && msg.trim()) {
        text = msg.trim();
      } else if (msg?.message && typeof msg.message === 'string') {
        text = msg.message.trim();
      } else if (msg) {
        try {
          const str = JSON.stringify(msg);
          if (str && str !== '{}') text = str;
        } catch (_) {}
      }
      if (text.includes('[object Object]')) {
        text = 'Processing failed. The image format could not be decoded.';
      }
      errorMessage.textContent = text;
      errorBox.classList.remove('hidden');
    }
  }

  function clearError() {
    if (errorBox) {
      errorBox.classList.add('hidden');
    }
  }

  if (closeErrorBtn) {
    closeErrorBtn.addEventListener('click', clearError);
  }

  function switchView(view: 'upload' | 'processing' | 'result') {
    clearError();
    uploadView.classList.add('hidden');
    processingView.classList.add('hidden');
    resultView.classList.add('hidden');

    if (view === 'upload') {
      uploadView.classList.remove('hidden');
    } else if (view === 'processing') {
      processingView.classList.remove('hidden');
    } else if (view === 'result') {
      resultView.classList.remove('hidden');
    }
  }

  function setSliderPercentage(pct: number) {
    const clamped = Math.max(0, Math.min(100, pct));
    if (stageBox) {
      stageBox.style.setProperty('--slider-pos', `${clamped.toFixed(2)}%`);
    }
  }

  function resetAll() {
    isCancelled = true;
    currentFile = null;
    clearCustomBg();
    currentBlur = 0;
    currentRatio = 'original';
    setCanvasRatio('original');
    setSliderPercentage(50);

    // Reset Blur Effect
    isBlurBgActive = false;
    blurBgPx = 0;
    if (blurBgToggle) blurBgToggle.checked = false;
    if (blurBgSlider) {
      blurBgSlider.value = '0';
      blurBgSlider.disabled = true;
      blurBgSlider.classList.add('opacity-50', 'disabled:cursor-not-allowed');
    }
    if (blurBgLabel) blurBgLabel.textContent = '0px';
    if (blurredOriginalBgImg) {
      blurredOriginalBgImg.classList.add('hidden');
      blurredOriginalBgImg.style.filter = 'none';
      blurredOriginalBgImg.src = '';
    }

    // Reset Shadow Effect
    isShadowActive = false;
    shadowOpacityPct = 0;
    if (shadowToggle) shadowToggle.checked = false;
    if (shadowSlider) {
      shadowSlider.value = '0';
      shadowSlider.disabled = true;
      shadowSlider.classList.add('opacity-50', 'disabled:cursor-not-allowed');
    }
    if (shadowLabel) shadowLabel.textContent = '0%';
    if (previewCutoutImg) {
      previewCutoutImg.style.filter = 'none';
      previewCutoutImg.classList.remove('hidden');
    }

    // Reset Brush Tool state
    isBrushModeActive = false;
    currentBrushMode = 'erase';
    brushSize = 25;
    if (brushSizeSlider) brushSizeSlider.value = '25';
    if (brushSizeLabel) brushSizeLabel.textContent = '25px';
    if (brushToolToggle) brushToolToggle.checked = false;
    if (brushControls) brushControls.classList.add('opacity-50', 'pointer-events-none');
    if (brushCanvas) {
      brushCanvas.classList.add('hidden');
      brushCanvas.style.filter = 'none';
      if (brushCtx) brushCtx.clearRect(0, 0, brushCanvas.width, brushCanvas.height);
    }
    if (brushCursorIndicator) brushCursorIndicator.classList.add('hidden');
    if (sliderDivider) sliderDivider.classList.remove('hidden');
    if (stageBox) {
      stageBox.classList.remove('cursor-none');
      stageBox.classList.add('cursor-ew-resize');
    }
    clearHistoryStacks();
    if (initialCutoutBitmap) {
      try { initialCutoutBitmap.close(); } catch (_) {}
      initialCutoutBitmap = null;
    }
    offscreenOriginalCanvas = null;
    originalPattern = null;
    brushCtx = null;

    originalImageObj = null;

    if (originalImageUrl) {
      URL.revokeObjectURL(originalImageUrl);
      originalImageUrl = null;
    }
    if (cutoutUrl) {
      URL.revokeObjectURL(cutoutUrl);
      cutoutUrl = null;
    }
    cutoutBlob = null;
    clearMagicStatus();
    if (magicPromptInput) magicPromptInput.value = '';

    // Reset Sticker Outline & Pan state
    panX = 0;
    panY = 0;
    isPanning = false;
    startX = 0;
    startY = 0;
    stickerStrokeWidth = 14;
    stickerStrokeColor = '#FFFFFF';
    currentStickerShape = 'die-cut';
    updateStickerShapeUI('die-cut');
    if (stickerStrokeSlider) stickerStrokeSlider.value = '14';
    if (stickerStrokeLabel) stickerStrokeLabel.textContent = '14px';
    updateStickerSwatchUI('#FFFFFF');
    isStickerCaptionActive = false;
    isDraggingStickerText = false;
    isPointerOverStickerText = false;
    if (stickerTextToggleCheckbox) stickerTextToggleCheckbox.checked = false;
    if (stickerCaptionPanel) stickerCaptionPanel.classList.add('hidden');
