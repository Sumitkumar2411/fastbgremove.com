        b.classList.toggle('border-2', isActive);
        b.classList.toggle('border-[#E5A93C]', isActive);
        b.classList.toggle('scale-110', isActive);

        const innerDot = b.querySelector('span');
        if (innerDot) {
          innerDot.classList.toggle('hidden', !isActive);
