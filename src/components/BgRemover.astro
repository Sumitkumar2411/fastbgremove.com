  // Backdrop Tab Switching Handler
  function switchBgTab(tab: 'color' | 'photo' | 'magic' | 'sticker') {
    currentBgTab = tab;
    const activeClasses = ['active', 'bg-white', 'dark:bg-[#242428]', 'text-[#b47818]', 'dark:text-[#E5A93C]', 'font-semibold', 'shadow-xs', 'border-[#E5A93C]/30'];
    const inactiveClasses = ['text-[#5a5852]', 'dark:text-[#a09c92]', 'border-transparent'];

    const tabs = [
      { id: 'color', btn: bgTabBtnColor, content: bgTabContentColor },
      { id: 'photo', btn: bgTabBtnPhoto, content: bgTabContentPhoto },
      { id: 'magic', btn: bgTabBtnMagic, content: bgTabContentMagic },
      { id: 'sticker', btn: bgTabBtnSticker, content: bgTabContentSticker },
    ];

    tabs.forEach(({ id, btn, content }) => {
      if (!btn || !content) return;
      if (id === tab) {
        btn.classList.add(...activeClasses);
        btn.classList.remove(...inactiveClasses);
        content.classList.remove('hidden');
      } else {
        btn.classList.remove(...activeClasses);
        btn.classList.add(...inactiveClasses);
        content.classList.add('hidden');
      }
    });

    if (tab === 'sticker') {
      applyBgToElements('transparent');
      if (sliderDivider) sliderDivider.classList.add('hidden');
      if (originalBadge) originalBadge.classList.add('hidden');
      if (cutoutBadge) cutoutBadge.classList.add('hidden');
      if (stageBox) {
        stageBox.style.setProperty('--slider-pos', '0%');
        stageBox.classList.remove('cursor-ew-resize');
      }
      updateCanvasCursor();
      updatePanHintUI();
      renderLiveStickerPreview();
    } else {
      if (stickerCanvas) stickerCanvas.classList.add('hidden');
      updatePanHintUI();
      if (!isBrushModeActive && previewCutoutImg) {
        previewCutoutImg.classList.remove('hidden');
      }
      if (!isBrushModeActive && sliderDivider) {
        sliderDivider.classList.remove('hidden');
      }
      if (originalBadge) originalBadge.classList.remove('hidden');
      if (cutoutBadge) cutoutBadge.classList.remove('hidden');
      if (stageBox && !isBrushModeActive) {
        stageBox.style.setProperty('--slider-pos', '50%');
        stageBox.style.cursor = '';
        stageBox.classList.add('cursor-ew-resize');
      }
      applyBgToElements(currentBgColor);
    }
  }

  bgTabBtns.forEach(btn => {
