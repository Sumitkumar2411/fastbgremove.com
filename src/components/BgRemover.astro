        b.classList.toggle('dark:bg-[#242428]', isActive);
        b.classList.toggle('text-[#b47818]', isActive);
        b.classList.toggle('dark:text-[#E5A93C]', isActive);
        b.classList.toggle('font-semibold', isActive);
        b.classList.toggle('shadow-xs', isActive);
        b.classList.toggle('border-[#E5A93C]/30', isActive);

        b.classList.toggle('text-[#5a5852]', !isActive);
        b.classList.toggle('dark:text-[#a09c92]', !isActive);
        b.classList.toggle('border-transparent', !isActive);
