---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="space-y-3 w-full">
  {items.map((item, index) => (
    <details
      class="group rounded-lg border border-[#e6e5e0] dark:border-[#2e2e33] bg-white dark:bg-[#1c1c1f] p-5 sm:p-6 transition-all duration-150 open:border-[#f54e00]/40 shadow-xs relative"
      open={index === 0 ? true : undefined}
    >
      <summary class="flex cursor-pointer items-center justify-between font-semibold text-base sm:text-lg text-[#26251e] dark:text-white group-hover:text-[#d04200] dark:group-hover:text-[#f54e00] transition-colors list-none select-none">
        <span class="pr-4">{item.question}</span>
        <span class="ml-2 flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-[#efeee8] dark:bg-[#242428] text-[#5a5852] dark:text-[#a09c92] group-open:rotate-180 group-open:text-[#f54e00] dark:group-open:text-[#f54e00] transition-transform duration-200">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </span>
      </summary>
      <div class="mt-4 text-sm sm:text-base text-[#5a5852] dark:text-[#a09c92] leading-relaxed border-t border-[#e6e5e0] dark:border-[#2e2e33] pt-4 font-sans">
        {item.answer}
      </div>
    </details>
  ))}
</div>
