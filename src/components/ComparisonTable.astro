---
const features = [
  {
    feature: "Full Resolution HD Export",
    fastbg: "100% Free (Native Camera Resolution)",
    removebg: "0.25 Megapixels (Paid credits for HD)",
    cloud: "Paid API per megapixel"
  },
  {
    feature: "Image Privacy & Data Storage",
    fastbg: "Zero Server Uploads (100% In-Browser RAM)",
    removebg: "Uploaded to remote servers",
    cloud: "Stored on 3rd-party cloud buckets"
  },
  {
    feature: "Sign-up & Account Required",
    fastbg: "No Account / No Sign-up",
    removebg: "Account required for credits",
    cloud: "API keys, billing, credit card"
  },
  {
    feature: "Watermarks or Compression",
    fastbg: "Zero Watermarks Ever",
    removebg: "Credit paywalls & subscriptions",
    cloud: "Usage tiers & overages"
  },
  {
    feature: "Processing Pipeline",
    fastbg: "Client-side WebAssembly + ONNX",
    removebg: "Remote server queue",
    cloud: "Serverless REST endpoints"
  },
  {
    feature: "Air-Gapped / Offline Capable",
    fastbg: "Yes (Runs fully in browser cache)",
    removebg: "No (Requires remote connection)",
    cloud: "No (Requires remote connection)"
  }
];
---

<div class="w-full overflow-x-auto rounded-lg border border-[#e6e5e0] dark:border-[#2e2e33] bg-white dark:bg-[#1c1c1f] shadow-xs relative">
  <!-- Active Accent Corner Dot -->
  <div class="absolute -top-[1px] -left-[1px] w-2.5 h-2.5 rounded-tl-lg bg-[#E5A93C] z-10 pointer-events-none"></div>

  <table class="w-full text-left text-xs sm:text-sm border-collapse font-sans">
    <thead>
      <tr class="border-b border-[#e6e5e0] dark:border-[#2e2e33] bg-[#f7f7f4] dark:bg-[#121212]">
        <th class="p-3.5 sm:p-4 font-semibold text-[#26251e] dark:text-[#ededed]">Feature / Specification</th>
        <th class="p-3.5 sm:p-4 font-bold text-[#26251e] dark:text-white bg-[#E5A93C]/10 dark:bg-[#E5A93C]/15 border-x border-[#e6e5e0] dark:border-[#2e2e33]">
          <div class="flex items-center gap-1.5 font-mono text-xs">
            <span>fastbgremove.com</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded-sm bg-[#E5A93C] text-zinc-950 font-bold uppercase">WASM</span>
          </div>
        </th>
        <th class="p-3.5 sm:p-4 font-medium text-[#807d72] dark:text-[#a09c92]">Remove.bg</th>
        <th class="p-3.5 sm:p-4 font-medium text-[#807d72] dark:text-[#a09c92]">Cloud APIs</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-[#e6e5e0] dark:divide-[#2e2e33]">
      {features.map((item) => (
        <tr class="hover:bg-[#f7f7f4]/80 dark:hover:bg-[#242428]/40 transition-colors">
          <td class="p-3.5 sm:p-4 font-medium text-[#26251e] dark:text-[#ededed]">{item.feature}</td>
          <td class="p-3.5 sm:p-4 text-[#26251e] dark:text-white bg-[#E5A93C]/5 dark:bg-[#E5A93C]/10 border-x border-[#e6e5e0] dark:border-[#2e2e33] font-medium">
            <div class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-[#E5A93C] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span>{item.fastbg}</span>
            </div>
          </td>
          <td class="p-3.5 sm:p-4 text-[#807d72] dark:text-[#a09c92]">{item.removebg}</td>
          <td class="p-3.5 sm:p-4 text-[#807d72] dark:text-[#a09c92]">{item.cloud}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
