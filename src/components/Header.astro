---
const currentPath = Astro.url.pathname;
const isSticker = currentPath === "/sticker-maker" || currentPath === "/sticker-maker/";
const isPassport = currentPath.startsWith("/passport-photo");
const isSignature = currentPath.startsWith("/transparent-signature") || currentPath.startsWith("/signature");
const isVsRemoveBg = currentPath.startsWith("/remove-bg-alternative") || currentPath.startsWith("/vs-remove-bg");
---

<header class="w-full border-b border-slate-200/80 dark:border-slate-800 bg-white/95 dark:bg-slate-950/95 backdrop-blur-md sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 grid grid-cols-3 items-center">
    <!-- Left Column (Brand Logo) -->
    <div class="flex items-center justify-start">
      <a href="/" class="flex items-center gap-2 sm:gap-2.5 shrink-0 select-none">
        <img 
          src="/logo.png" 
          alt="FastBgRemove logo" 
          class="h-[38px] w-auto object-contain shrink-0" 
          style="height: 38px; width: auto; object-fit: contain;"
        />
        <span class="font-bold text-sm xs:text-base sm:text-lg text-zinc-900 dark:text-white tracking-tight whitespace-nowrap">FastBgRemove</span>
      </a>
    </div>

    <!-- Center Column (True Centered Tool Navigation Pills) -->
    <div class="flex items-center justify-center">
      <nav class="hidden md:inline-flex items-center gap-1.5 p-1 rounded-full bg-slate-100 dark:bg-slate-800/80 border border-slate-200/70 dark:border-slate-700/60 shadow-2xs">
        <a
          href="/sticker-maker"
          class:list={[
            "px-3.5 py-1.5 rounded-full text-xs transition-all whitespace-nowrap",
            isSticker
              ? "font-semibold bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-xs"
              : "font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
          ]}
        >
          Sticker Maker
        </a>
        <a
          href="/passport-photo"
          class:list={[
            "px-3.5 py-1.5 rounded-full text-xs transition-all whitespace-nowrap",
            isPassport
              ? "font-semibold bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-xs"
              : "font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
          ]}
        >
          Passport Photo
        </a>
        <a
          href="/signature"
          class:list={[
            "px-3.5 py-1.5 rounded-full text-xs transition-all whitespace-nowrap",
            isSignature
              ? "font-semibold bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-xs"
              : "font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
          ]}
        >
          Signature
        </a>
        <a
          href="/vs-remove-bg"
          class:list={[
            "px-3.5 py-1.5 rounded-full text-xs transition-all whitespace-nowrap",
            isVsRemoveBg
              ? "font-semibold bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-xs"
              : "font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
          ]}
        >
          vs Remove.bg
        </a>
      </nav>
    </div>

    <!-- Right Column (Theme Switcher) -->
    <div class="flex items-center justify-end">
      <button
        id="theme-toggle-btn"
        type="button"
        aria-label="Toggle Light or Dark theme"
        class="w-8 h-8 rounded-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 flex items-center justify-center transition-all active:scale-[0.95] cursor-pointer shadow-xs shrink-0"
      >
        <!-- Sun Icon (in dark mode) -->
        <svg class="w-4 h-4 hidden dark:block text-[#E5A93C]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <!-- Moon Icon (in light mode) -->
        <svg class="w-4 h-4 block dark:hidden text-[#26251e]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('theme-toggle-btn');
  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    });
  }
</script>
