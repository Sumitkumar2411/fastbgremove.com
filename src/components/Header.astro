---
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full border-b border-[#e6e5e0] dark:border-[#2e2e33] bg-[#f7f7f4]/90 dark:bg-[#121212]/90 backdrop-blur-md transition-colors">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo & Wordmark -->
    <a href="/" class="flex items-center gap-2.5">
      <img 
        src="/logo.png" 
        alt="fastbgremove.com" 
        class="w-8 h-8 rounded-full object-cover shrink-0 border border-zinc-200 dark:border-zinc-800 shadow-sm" 
      />
      <span class="font-bold text-lg text-zinc-900 dark:text-white tracking-tight">fastbgremove.com</span>
    </a>

    <!-- Navigation Links & Theme Switcher -->
    <div class="flex items-center gap-3 sm:gap-6">
      <nav class="flex items-center gap-1 sm:gap-2">
        <a
          href="/passport-photo-white-background"
          class:list={[
            "text-sm font-medium px-3 py-1.5 rounded-md transition-colors",
            currentPath === "/passport-photo-white-background"
              ? "bg-[#f54e00]/10 text-[#d04200] dark:text-[#f54e00] font-semibold"
              : "text-[#5a5852] dark:text-[#a09c92] hover:text-[#26251e] dark:hover:text-[#ededed] hover:bg-[#efeee8] dark:hover:bg-[#1c1c1f]"
          ]}
        >
          Passport Photo
        </a>
        <a
          href="/transparent-signature-maker"
          class:list={[
            "text-sm font-medium px-3 py-1.5 rounded-md transition-colors",
            currentPath === "/transparent-signature-maker"
              ? "bg-[#f54e00]/10 text-[#d04200] dark:text-[#f54e00] font-semibold"
              : "text-[#5a5852] dark:text-[#a09c92] hover:text-[#26251e] dark:hover:text-[#ededed] hover:bg-[#efeee8] dark:hover:bg-[#1c1c1f]"
          ]}
        >
          Signature Maker
        </a>
        <a
          href="/remove-bg-alternative"
          class:list={[
            "text-sm font-medium px-3 py-1.5 rounded-md transition-colors hidden md:block",
            currentPath === "/remove-bg-alternative"
              ? "bg-[#f54e00]/10 text-[#d04200] dark:text-[#f54e00] font-semibold"
              : "text-[#5a5852] dark:text-[#a09c92] hover:text-[#26251e] dark:hover:text-[#ededed] hover:bg-[#efeee8] dark:hover:bg-[#1c1c1f]"
          ]}
        >
          vs Remove.bg
        </a>
      </nav>

      <!-- Crisp Sun / Moon Theme Toggle -->
      <button
        id="theme-toggle-btn"
        type="button"
        aria-label="Toggle Light or Dark theme"
        class="w-9 h-9 rounded-md border border-[#e6e5e0] dark:border-[#2e2e33] bg-white dark:bg-[#1c1c1f] text-[#26251e] dark:text-[#ededed] hover:border-[#cfcdc4] dark:hover:border-[#3e3e44] flex items-center justify-center transition-all cursor-pointer shadow-xs"
      >
        <!-- Sun Icon (in dark mode) -->
        <svg class="w-4.5 h-4.5 hidden dark:block text-[#f54e00]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <!-- Moon Icon (in light mode) -->
        <svg class="w-4.5 h-4.5 block dark:hidden text-[#26251e]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('theme-toggle-btn');
  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    });
  }
</script>
