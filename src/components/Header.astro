---
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full border-b border-[#e6e5e0] dark:border-[#2e2e33] bg-[#f7f7f4]/90 dark:bg-[#121212]/90 backdrop-blur-md transition-colors">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 md:px-8 h-14 sm:h-16 flex items-center justify-between gap-2">
    <!-- Brand Logo & Wordmark -->
    <a href="/" class="flex items-center gap-2 sm:gap-2.5 shrink-0 select-none">
      <img 
        src="/logo.png" 
        alt="FastBgRemove logo" 
        class="w-7 h-7 sm:w-8 sm:h-8 rounded-full object-cover shrink-0 border border-zinc-200 dark:border-zinc-800 shadow-sm" 
      />
      <span class="font-bold text-sm xs:text-base sm:text-lg text-zinc-900 dark:text-white tracking-tight whitespace-nowrap">FastBgRemove</span>
    </a>

    <!-- Navigation Links & Theme Switcher -->
    <div class="flex items-center gap-1.5 sm:gap-3 min-w-0">
      <nav class="flex items-center gap-1 sm:gap-2 overflow-x-auto no-scrollbar scroll-smooth py-1 max-w-[170px] xs:max-w-[240px] sm:max-w-none">
        <a
          href="/passport-photo-white-background"
          class:list={[
            "inline-flex items-center px-2.5 sm:px-4 py-1 sm:py-1.5 text-[11px] sm:text-xs font-medium rounded-full border shadow-[inset_0_1px_1px_rgba(255,255,255,0.8),0_1px_2px_rgba(0,0,0,0.06)] transition-all active:scale-[0.98] shrink-0 whitespace-nowrap",
            currentPath === "/passport-photo-white-background"
              ? "bg-orange-50/80 dark:bg-orange-950/30 text-[#d04200] dark:text-[#f54e00] border-[#d04200]/50 dark:border-[#f54e00]/50 font-semibold ring-1 ring-[#d04200]/20"
              : "bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 border-zinc-300 dark:border-zinc-700 hover:bg-zinc-50 dark:hover:bg-zinc-800"
          ]}
        >
          Passport Photo
        </a>
        <a
          href="/transparent-signature-maker"
          class:list={[
            "inline-flex items-center px-2.5 sm:px-4 py-1 sm:py-1.5 text-[11px] sm:text-xs font-medium rounded-full border shadow-[inset_0_1px_1px_rgba(255,255,255,0.8),0_1px_2px_rgba(0,0,0,0.06)] transition-all active:scale-[0.98] shrink-0 whitespace-nowrap",
            currentPath === "/transparent-signature-maker"
              ? "bg-orange-50/80 dark:bg-orange-950/30 text-[#d04200] dark:text-[#f54e00] border-[#d04200]/50 dark:border-[#f54e00]/50 font-semibold ring-1 ring-[#d04200]/20"
              : "bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 border-zinc-300 dark:border-zinc-700 hover:bg-zinc-50 dark:hover:bg-zinc-800"
          ]}
        >
          Signature
        </a>
        <a
          href="/remove-bg-alternative"
          class:list={[
            "hidden md:inline-flex items-center px-2.5 sm:px-4 py-1 sm:py-1.5 text-[11px] sm:text-xs font-medium rounded-full border shadow-[inset_0_1px_1px_rgba(255,255,255,0.8),0_1px_2px_rgba(0,0,0,0.06)] transition-all active:scale-[0.98] shrink-0 whitespace-nowrap",
            currentPath === "/remove-bg-alternative"
              ? "bg-orange-50/80 dark:bg-orange-950/30 text-[#d04200] dark:text-[#f54e00] border-[#d04200]/50 dark:border-[#f54e00]/50 font-semibold ring-1 ring-[#d04200]/20"
              : "bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 border-zinc-300 dark:border-zinc-700 hover:bg-zinc-50 dark:hover:bg-zinc-800"
          ]}
        >
          vs Remove.bg
        </a>
      </nav>

      <!-- Crisp Sun / Moon Theme Toggle -->
      <button
        id="theme-toggle-btn"
        type="button"
        aria-label="Toggle Light or Dark theme"
        class="w-7 h-7 sm:w-8 sm:h-8 rounded-full border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-[#26251e] dark:text-[#ededed] hover:bg-zinc-50 dark:hover:bg-zinc-800 flex items-center justify-center transition-all active:scale-[0.95] cursor-pointer shadow-[inset_0_1px_1px_rgba(255,255,255,0.8),0_1px_2px_rgba(0,0,0,0.06)] shrink-0"
      >
        <!-- Sun Icon (in dark mode) -->
        <svg class="w-4 h-4 hidden dark:block text-[#f54e00]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <!-- Moon Icon (in light mode) -->
        <svg class="w-4 h-4 block dark:hidden text-[#26251e]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('theme-toggle-btn');
  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    });
  }
</script>
