---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  structuredData?: Record<string, any> | Record<string, any>[];
}

const props = Astro.props;
---

<BaseLayout {...props}>
  <slot />
</BaseLayout>
