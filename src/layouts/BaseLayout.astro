---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  structuredData?: Record<string, any> | Record<string, any>[];
  noindex?: boolean;
}

const {
  title = "fastbgremove.com – 100% Free HD Background Remover (Zero Upload, Unlimited)",
  description = "Instant, 100% in-browser background removal with zero server uploads. Download full original resolution HD PNGs with no watermarks and no sign-up.",
  canonicalPath = "",
  ogType = "website",
  ogTitle,
  ogDescription,
  ogImage = "https://fastbgremove.com/og-image.png",
  structuredData,
  noindex = false
} = Astro.props;

// Self-referencing canonical URL matching sitemap directory structure
const cleanPath = canonicalPath 
  ? (canonicalPath.endsWith('/') || canonicalPath.includes('.') ? canonicalPath : `${canonicalPath}/`)
  : '/';
const canonicalUrl = new URL(cleanPath, "https://fastbgremove.com").href;

const isHomepage = cleanPath === '/' || cleanPath === '';
const finalOgTitle = ogTitle || (isHomepage ? "fastbgremove.com – Free In-Browser Background Remover" : title);
const finalOgDescription = ogDescription || (isHomepage ? "Remove image backgrounds instantly in HD. 100% private, no sign-up, zero watermarks." : description);
const finalOgUrl = canonicalUrl;

const defaultStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "FastBGRemove",
    "alternateName": ["fastbgremove.com", "Fast BG Remove"],
    "url": "https://fastbgremove.com",
    "description": "100% Free HD Background Remover with zero server uploads and unlimited exports."
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FastBGRemove",
    "url": "https://fastbgremove.com",
    "description": "Instant, 100% in-browser background removal with zero server uploads. Download full original resolution HD PNGs with no watermarks and no sign-up.",
    "applicationCategory": ["MultimediaApplication", "PhotoEditing"],
    "operatingSystem": "All",
    "browserRequirements": "Requires WebAssembly & HTML5 Canvas support",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "100% client-side WebAssembly processing",
      "Zero server image uploads (total privacy)",
      "Full original resolution HD PNG export",
      "No watermarks",
      "No account or sign-up required",
      "Passport photo background presets (White, Passport Blue)",
      "Transparent signature maker"
    ]
  }
];

const schemas = structuredData ? (Array.isArray(structuredData) ? [...defaultStructuredData, ...structuredData] : [...defaultStructuredData, structuredData]) : defaultStructuredData;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2X0LJ2G3RX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-2X0LJ2G3RX');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <!-- Anti-FOUC Theme Initialization Script -->
    <script is:inline>
      (function() {
        const storedTheme = typeof localStorage !== 'undefined' && localStorage.getItem('theme');
        const theme = storedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'dark');
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="theme-color" content="#f54e00" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Fonts: Geist, Geist Mono & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- OpenGraph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={finalOgUrl} />
    <meta property="og:title" content={finalOgTitle} />
    <meta property="og:description" content={finalOgDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={finalOgTitle} />
    <meta property="og:site_name" content="fastbgremove.com" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={finalOgUrl} />
    <meta name="twitter:title" content={finalOgTitle} />
    <meta name="twitter:description" content={finalOgDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={finalOgTitle} />

    <!-- Structured Data (JSON-LD Schema) -->
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="bg-[#f7f7f4] dark:bg-[#121212] text-[#26251e] dark:text-[#ededed] antialiased flex flex-col min-h-screen selection:bg-[#f54e00]/20 selection:text-[#d04200]">
    <Header />
    <main class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 py-2 sm:py-4">
      <slot />
    </main>
    <Footer />
  </body>
</html>
