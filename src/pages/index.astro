---
import BaseLayout from '../layouts/BaseLayout.astro';
import BgRemover from '../components/BgRemover.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const strategicFaqs = [
  {
    question: "How to remove background from image for free without watermark?",
    answer: "You can remove the background from any photo for free without watermarks using FastBG. Simply drag and drop your PNG, JPG, or WebP image into the tool above. Our client-side neural network instantly isolates the foreground subject and lets you download a full-resolution transparent PNG with zero watermarks, zero subscription fees, and no account sign-up required."
  },
  {
    question: "What is the best 100% free remove.bg alternative?",
    answer: "FastBG is the premier 100% free alternative to remove.bg, especially as remove.bg transitions toward its standalone service shutdown and restricts free users to tiny 0.25-megapixel preview cutouts. Unlike remove.bg, which requires paid credits or monthly subscriptions for high-resolution images, FastBG runs directly in your browser using WebAssembly. It delivers unlimited, full-resolution HD cutouts up to original 4K+ quality completely free forever."
  },
  {
    question: "Photo ke piche ka background kaise hataye bina quality gawaye?",
    answer: "Photo ke piche ka background bina quality gawaye hatane ke liye FastBG ka use karein. Apni photo ko upar drop karein ya browse karein — hamara in-browser AI engine bina photo compress kiye background ko transparent bana deta hai. Isse aapki photo ki original Full HD clarity, sharp edges aur pixel dimensions (4K tak) bilkul barkarar rehte hain aur aap bina kisi watermark ke HD PNG download kar sakte hain."
  },
  {
    question: "How does in-browser client-side background removal protect my privacy?",
    answer: "Traditional background removal services upload your images to cloud servers where they can be logged, analyzed, or stored. FastBG operates 100% client-side using WebAssembly (WASM) and ONNX Runtime. The segmentation model runs exclusively inside your browser's local RAM. Your raw photo pixels never travel across the internet or touch any remote server, guaranteeing total confidentiality for personal photos, government IDs, and legal documents."
  },
  {
    question: "Can I export original camera resolution in Full HD PNG?",
    answer: "Yes. FastBG processes your photos at their exact native dimensions. If you upload an image shot on an iPhone, Android, or professional DSLR camera at 4000x3000 pixels, your downloaded cutout will remain 4000x3000 pixels in lossless 32-bit PNG format (with 8-bit alpha transparency). We never downscale or compress your images."
  },
  {
    question: "Photo se white background kaise banaye for passport and visa?",
    answer: "Passport ya visa application ke liye white background banana behad aasan hai. FastBG par apni portrait photo upload karein, AI background remove kar dega, aur fir upar diye gaye color options me se 'White (#FFFFFF)' select karein. Isse aapko official passport and visa guidelines (US 2x2, Schengen, Indian Passport/OCI) ke mutabiq crystal-clear white background photo mil jayegi, jise aap 300 DPI me print kar sakte hain."
  },
  {
    question: "How to remove background from signature online for job/exam forms?",
    answer: "To extract a clean transparent signature for competitive exam portals (UPSC, SSC, Banking), job applications, or digital contracts: sign with a dark blue or black pen on unlined white paper, take a clear overhead photo, and drop it into FastBG. The tool automatically isolates the ink strokes from the paper and outputs a transparent PNG that you can directly insert into PDF forms, Microsoft Word, or Google Docs."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": strategicFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<BaseLayout
  title="FastBG – 100% Free Background Remover (In-Browser HD, Zero Watermark)"
  description="Remove image backgrounds instantly for free without watermarks. 100% private in-browser WebAssembly, full HD resolution export, zero sign-up. The best free remove.bg alternative."
  canonicalPath="/"
  structuredData={faqSchema}
>
  <!-- THE HERO WORKSPACE (ABOVE THE FOLD) -->
  <BgRemover
    heading="Remove Background from Image"
    subheading="100% automatic, in-browser background removal. Free full-resolution HD PNG export with zero watermarks and zero sign-up."
    defaultBg="transparent"
  />

  <!-- BELOW THE FOLD: ARCHITECTURE & BENEFITS -->
  <section class="mt-24 sm:mt-32 pt-16 border-t border-zinc-200 dark:border-[#232326]">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">
        Built for Speed, Privacy, and Uncompromised Quality
      </h2>
      <p class="text-sm sm:text-base text-zinc-500 dark:text-[#A7A7A7] mt-2">
        Why running AI segmentation directly on your machine delivers a superior experience.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-[2px] bg-white dark:bg-[#121214] border border-zinc-200 dark:border-[#232326] shadow-xs space-y-3 relative">
        <div class="absolute -top-[1px] -left-[1px] w-2.5 h-2.5 bg-[#76B900]"></div>
        <div class="w-11 h-11 rounded-[2px] bg-[#76B900]/10 border border-[#76B900]/30 flex items-center justify-center text-[#76B900]">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </div>
        <h3 class="text-base font-bold text-zinc-900 dark:text-white">Complete Data Privacy</h3>
        <p class="text-sm text-zinc-500 dark:text-[#A7A7A7] leading-relaxed">
          Your photos never leave your device. All image pixels remain in local browser memory, making FastBG fully safe for confidential documents, client assets, and personal photos.
        </p>
      </div>

      <div class="p-6 rounded-[2px] bg-white dark:bg-[#121214] border border-zinc-200 dark:border-[#232326] shadow-xs space-y-3 relative">
        <div class="absolute -top-[1px] -left-[1px] w-2.5 h-2.5 bg-[#76B900]"></div>
        <div class="w-11 h-11 rounded-[2px] bg-[#76B900]/10 border border-[#76B900]/30 flex items-center justify-center text-[#76B900]">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
        </div>
        <h3 class="text-base font-bold text-zinc-900 dark:text-white">True Full Resolution HD</h3>
        <p class="text-sm text-zinc-500 dark:text-[#A7A7A7] leading-relaxed">
          Unlike platforms that bait-and-switch with tiny 0.25-megapixel previews, FastBG exports cutouts at 100% original camera resolution with zero downscaling or compression loss.
        </p>
      </div>

      <div class="p-6 rounded-[2px] bg-white dark:bg-[#121214] border border-zinc-200 dark:border-[#232326] shadow-xs space-y-3 relative">
        <div class="absolute -top-[1px] -left-[1px] w-2.5 h-2.5 bg-[#76B900]"></div>
        <div class="w-11 h-11 rounded-[2px] bg-[#76B900]/10 border border-[#76B900]/30 flex items-center justify-center text-[#76B900]">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </svg>
        </div>
        <h3 class="text-base font-bold text-zinc-900 dark:text-white">Zero Server Queues</h3>
        <p class="text-sm text-zinc-500 dark:text-[#A7A7A7] leading-relaxed">
          No waiting for remote cloud servers to process your queue or uploading massive files over slow mobile networks. Processing executes directly on your local CPU.
        </p>
      </div>
    </div>
  </section>

  <!-- Comparison Matrix vs Remove.bg -->
  <section class="mt-24 sm:mt-32 pt-16 border-t border-zinc-200 dark:border-[#232326]">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">
        How FastBG Compares to Remove.bg
      </h2>
      <p class="text-sm sm:text-base text-zinc-500 dark:text-[#A7A7A7] mt-2">
        See the difference between local in-browser processing and cloud paywalls.
      </p>
    </div>

    <ComparisonTable />
  </section>

  <!-- Strategic SEO FAQ Section with JSON-LD Schema -->
  <section class="mt-24 sm:mt-32 pt-16 border-t border-zinc-200 dark:border-[#232326] max-w-4xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
        Frequently Asked Questions
      </h2>
      <p class="text-sm sm:text-base text-zinc-500 dark:text-[#A7A7A7] mt-2">
        Clear answers about our in-browser background remover, privacy, resolution, and passport standards.
      </p>
    </div>

    <FaqAccordion items={strategicFaqs} />
  </section>
</BaseLayout>
