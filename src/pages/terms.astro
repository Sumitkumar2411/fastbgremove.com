---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Terms of Service – fastbgremove.com"
  description="Terms of service and fair use guidelines for fastbgremove.com client-side utility."
  canonicalPath="/terms"
>
  <div class="max-w-3xl mx-auto py-8 sm:py-12 space-y-10">
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 text-xs font-mono text-[#f54e00] bg-[#f54e00]/10 px-3 py-1 rounded-md border border-[#f54e00]/20 font-semibold">
        <span class="w-1.5 h-1.5 rounded-full bg-[#f54e00]"></span>
        <span>FAIR USE TERMS</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#26251e] dark:text-white">
        Terms of Service
      </h1>
      <p class="text-xs sm:text-sm text-[#807d72] dark:text-[#706e68]">
        Effective: 2026 • Client-Side Software License
      </p>
    </div>

    <div class="space-y-6 text-sm sm:text-base text-[#5a5852] dark:text-[#a09c92]">
      <!-- 1. Permitted Use -->
      <section class="space-y-3 p-6 sm:p-7 rounded-lg bg-white dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] shadow-xs">
        <h2 class="text-base sm:text-lg font-bold text-[#26251e] dark:text-white">1. Permitted Fair Use</h2>
        <p class="leading-relaxed">
          fastbgremove.com is provided as a free, client-side web utility. You are permitted to process personal, commercial, and client images without restriction, subscription fees, or mandatory attribution.
        </p>
      </section>

      <!-- 2. Ownership & Intellectual Property -->
      <section class="space-y-3 p-6 sm:p-7 rounded-lg bg-white dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] shadow-xs">
        <h2 class="text-base sm:text-lg font-bold text-[#26251e] dark:text-white">2. Full Intellectual Property Ownership</h2>
        <p class="leading-relaxed">
          You retain 100% full ownership, rights, and copyright to all original and processed images. Because all operations execute locally in your browser's isolated sandbox, fastbgremove.com does not access, claim, or license any rights to your content or generated cutout files.
        </p>
      </section>

      <!-- 3. Disclaimer of Warranties -->
      <section class="space-y-3 p-6 sm:p-7 rounded-lg bg-white dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] shadow-xs">
        <h2 class="text-base sm:text-lg font-bold text-[#26251e] dark:text-white">3. Disclaimer of Warranties & Liability</h2>
        <p class="leading-relaxed">
          fastbgremove.com is provided "as is", without warranty of any kind, express or implied, including but not limited to the warranties of merchantability, fitness for a particular purpose, and noninfringement. In no event shall fastbgremove.com or its authors be liable for any direct, indirect, or consequential damages resulting from the use of this utility.
        </p>
      </section>

      <!-- 4. Trademark Notice -->
      <section class="space-y-3 p-6 sm:p-7 rounded-lg bg-white dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] shadow-xs">
        <h2 class="text-base sm:text-lg font-bold text-[#26251e] dark:text-white">4. Independent Utility Notice</h2>
        <p class="leading-relaxed">
          fastbgremove.com is an independent utility. All third-party product names, logos, and brands mentioned on this site (including Remove.bg) are property of their respective owners and are referenced solely for comparative and educational identification purposes.
        </p>
      </section>

      <!-- Return to Workspace -->
      <div class="pt-2 text-center">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-md bg-[#f54e00] hover:bg-[#d04200] active:bg-[#b03800] text-white font-medium text-sm transition-all shadow-xs"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span>Return to Workspace</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
