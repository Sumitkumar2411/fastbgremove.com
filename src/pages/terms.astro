---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Terms of Use – fastbgremove.com"
  description="Terms of use for fastbgremove.com web utility."
  canonicalPath="/terms"
>
  <div class="max-w-3xl mx-auto py-8 sm:py-12 space-y-8">
    <div class="space-y-2">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 dark:text-white">
        Terms of Use
      </h1>
      <p class="text-xs sm:text-sm text-zinc-500 dark:text-[#A7A7A7]">
        Last updated: September 2026
      </p>
    </div>

    <div class="prose prose-invert max-w-none text-xs sm:text-sm text-zinc-600 dark:text-[#A7A7A7] space-y-6">
      <section class="space-y-3 p-6 rounded-[2px] bg-white dark:bg-[#121214] border border-zinc-200 dark:border-[#232326] shadow-xs relative">
        <div class="absolute -top-[1px] -left-[1px] w-2.5 h-2.5 bg-[#76B900]"></div>
        <h2 class="text-base font-semibold text-zinc-900 dark:text-white">1. Service Scope</h2>
        <p class="leading-relaxed">
          fastbgremove.com is provided as a free, client-side web utility. You are free to process personal, commercial, and client images without restriction, watermarks, or licensing fees.
        </p>
      </section>

      <section class="space-y-3 p-6 rounded-[2px] bg-white dark:bg-[#121214] border border-zinc-200 dark:border-[#232326] shadow-xs relative">
        <div class="absolute -top-[1px] -left-[1px] w-2.5 h-2.5 bg-[#76B900]"></div>
        <h2 class="text-base font-semibold text-zinc-900 dark:text-white">2. Ownership & Intellectual Property</h2>
        <p class="leading-relaxed">
          You retain 100% full ownership, rights, and copyright to all images you process with fastbgremove.com. Because all processing executes in your browser sandbox, fastbgremove.com asserts no claim, license, or rights to any generated outputs.
        </p>
      </section>

      <section class="space-y-3 p-6 rounded-[2px] bg-white dark:bg-[#121214] border border-zinc-200 dark:border-[#232326] shadow-xs relative">
        <div class="absolute -top-[1px] -left-[1px] w-2.5 h-2.5 bg-[#76B900]"></div>
        <h2 class="text-base font-semibold text-zinc-900 dark:text-white">3. Disclaimer of Warranties</h2>
        <p class="leading-relaxed">
          The software is provided "as is", without warranty of any kind, express or implied. In no event shall the authors or copyright holders be liable for any claim, damages, or other liability arising from the use of the tool.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
