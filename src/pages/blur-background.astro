---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const pageTitle = "Blur Image Online Free — DSLR Background Blur & Photo Censoring";
const pageDescription = "Free in-browser tool to blur photo backgrounds with DSLR bokeh or censor sensitive details in screenshots. 100% private, instant, and runs locally on your device.";
const canonicalPath = "/blur-background";

const faqs = [
  {
    question: "How do I blur the background of a photo online for free?",
    answer: "Upload your photo to FastBgRemove and select 'Blur Background'. The in-browser AI automatically detects and isolates the human subject, product, or pet, keeping it razor-sharp while applying a realistic optical DSLR bokeh blur to the background. You can adjust blur intensity from subtle f/4.0 softness to creamy f/1.4 depth and download your full-resolution HD photo instantly for free."
  },
  {
    question: "How can I blur sensitive text or numbers in a screenshot?",
    answer: "Select the 'Censor Area / Box Blur' mode in our interactive studio. Click and drag your cursor over any confidential details—such as credit card numbers, passwords, API keys, addresses, or faces—to draw an irreversible privacy blur box. You can create multiple censor boxes across receipts, bank statements, or chat logs before exporting."
  },
  {
    question: "Does blurring an image upload my photos to an external server?",
    answer: "No. FastBgRemove operates on a strict 100% client-side privacy architecture using HTML5 Canvas and local WebAssembly. All pixel processing, neural subject detection, and blur computations occur entirely in your device's memory (RAM). Your files never touch external servers or cloud databases, making it fully safe for sensitive corporate documents and personal IDs."
  },
  {
    question: "How do I blur an image on iPhone or Android mobile without installing an app?",
    answer: "Open fastbgremove.com/blur-background directly in Safari, Chrome, or any mobile browser. Tap to upload or take a photo, select your blur mode, use touch controls to adjust bokeh or drag censor boxes, and tap 'Download Full HD Image'. No App Store download, no account creation, and zero storage space required."
  },
  {
    question: "What is the difference between full image blur and DSLR portrait bokeh?",
    answer: "Full image blur applies a uniform Gaussian blur across every single pixel, which is ideal for obscuring an entire background graphic, sensitive document, or privacy thumbnail. In contrast, DSLR portrait bokeh utilizes neural subject isolation to separate the foreground subject from the background, simulating a physical 50mm f/1.4 prime lens where the subject remains crisp while only the background melts away."
  },
  {
    question: "Can I blur photos without losing original HD resolution?",
    answer: "Yes. FastBgRemove exports images at their native camera resolution (up to 4K+). While other online tools downscale free exports to low-resolution 0.25MP previews or compress them heavily, our pipeline renders full-fidelity exports directly on an offscreen canvas matching your original pixel dimensions with zero watermarks."
  }
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "FastBgRemove Blur Studio",
  "url": "https://fastbgremove.com/blur-background",
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires WebAssembly & HTML5 Canvas support",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": pageDescription,
  "featureList": [
    "AI Portrait Bokeh background blur with subject protection",
    "Selective Censor Area / Box Blur for redacting text and faces in screenshots",
    "Full photo blur mode for privacy and background graphics",
    "Live adjustable blur intensity slider (0-40px)",
    "Interactive before/after split slider and instant preview toggle",
    "100% client-side WebAssembly execution with zero server uploads",
    "Full original resolution HD export with zero watermarks"
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  structuredData={[softwareSchema, faqSchema]}
>
  <meta name="keywords" content="blur image online, blur photo online free, photo background blur online, blur something in a picture, how to blur in a screenshot, dslr bokeh online" slot="head" />

  <!-- HERO SECTION (Clean & Above-the-fold) -->
  <section class="w-full flex flex-col items-center justify-center pt-2 sm:pt-4 pb-4 sm:pb-6 text-center">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 dark:bg-amber-500/15 border border-[#D49B28]/30 dark:border-[#E5A93C]/30 text-xs font-semibold text-[#b47818] dark:text-[#E5A93C] shadow-xs mb-3">
      <span>⚡ Instant In-Browser Blur · 100% Private</span>
    </div>
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
      Blur Image Online Free
    </h1>
    <p class="mt-2.5 text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
      Create DSLR-quality portrait bokeh, censor sensitive details in screenshots, or apply smooth photo blur in seconds. Free, unlimited, and runs locally on your device.
    </p>
  </section>

  <!-- INTERACTIVE BLUR STUDIO -->
  <div class="w-full max-w-4xl mx-auto px-1 sm:px-4">
    <div
      id="blur-studio-card"
      class="w-full bg-white dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] rounded-2xl shadow-xs p-3.5 sm:p-7 relative transition-all overflow-hidden"
    >
      <!-- Corner Brand Accent Dot -->
      <div class="absolute -top-[1px] -left-[1px] w-2.5 h-2.5 rounded-tl-2xl bg-[#E5A93C] z-20 pointer-events-none shadow-[0_0_8px_rgba(229,169,60,0.5)]"></div>

      <!-- STATE 1: UPLOAD DROPZONE VIEW -->
      <div id="upload-view" class="flex flex-col items-center justify-center">
        <div
          id="dropzone"
          tabindex="0"
          role="button"
          aria-label="Upload image to blur background"
          class="w-full min-h-[220px] sm:min-h-[320px] md:min-h-[380px] border-2 border-dashed border-[#cfcdc4] dark:border-[#2e2e33] hover:border-[#E5A93C] dark:hover:border-[#E5A93C] hover:bg-[#efeee8]/50 dark:hover:bg-[#242428]/40 focus:border-[#D49B28] focus:outline-none rounded-xl p-5 sm:p-8 md:p-12 flex flex-col items-center justify-center text-center cursor-pointer transition-all group shadow-xs hover:shadow-[0_0_24px_rgba(229,169,60,0.15)] relative"
        >
          <input
            type="file"
            id="file-input"
            accept="image/jpeg, image/png, image/webp, image/avif"
            class="hidden"
          />

          <!-- Upload Icon with Golden Accent -->
          <div class="w-16 h-16 rounded-xl bg-[#E5A93C]/10 border border-[#E5A93C]/20 flex items-center justify-center text-[#E5A93C] group-hover:scale-105 transition-transform mb-5 shadow-xs">
            <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
          </div>

          <!-- Prominent Callout -->
          <div class="space-y-2 mb-3">
            <p class="text-xl sm:text-2xl font-bold text-[#26251e] dark:text-white">
              Drop your image here, or <span class="text-[#b47818] dark:text-[#E5A93C] underline decoration-2 underline-offset-4 group-hover:text-[#D49B28]">Browse</span>
            </p>
            <p class="text-xs sm:text-sm text-[#5a5852] dark:text-[#a09c92]">
              Supports JPG, PNG, WebP, AVIF up to 25MB • Or paste directly with <kbd class="px-1.5 py-0.5 rounded bg-[#efeee8] dark:bg-[#242428] border border-[#cfcdc4] dark:border-[#3e3e44] text-[11px] font-mono text-[#26251e] dark:text-[#ededed] font-semibold">Ctrl+V</kbd>
            </p>
          </div>
        </div>

        <!-- Sample Photo Row -->
        <div class="mt-4 sm:mt-6 flex flex-wrap items-center justify-center gap-2 sm:gap-3">
          <span class="text-xs sm:text-sm font-medium text-[#5a5852] dark:text-[#a09c92]">Try with a sample:</span>
          <button
            type="button"
            id="sample-portrait-btn"
            class="flex items-center gap-2.5 p-1.5 pr-3.5 rounded-lg bg-[#f7f7f4] dark:bg-[#242428] border border-[#e6e5e0] dark:border-[#2e2e33] hover:border-[#E5A93C] hover:shadow-[0_0_12px_rgba(229,169,60,0.15)] transition-all cursor-pointer group"
          >
            <img
              src="/samples/portrait.jpg"
              alt="Portrait bokeh sample"
              class="w-8 h-8 rounded-md object-cover group-hover:scale-105 transition-transform"
            />
            <div class="text-left">
              <div class="text-xs font-semibold text-[#26251e] dark:text-[#ededed] group-hover:text-[#b47818] dark:group-hover:text-[#E5A93C]">
                Portrait Photo
              </div>
              <div class="text-[10px] text-[#807d72] dark:text-[#a09c92]">Instant DSLR Bokeh</div>
            </div>
          </button>
        </div>

        <!-- Feature Pills Row -->
        <div class="flex flex-wrap items-center justify-center gap-2 mt-6 pt-5 border-t border-[#e6e5e0] dark:border-[#2e2e33] w-full text-xs text-[#5a5852] dark:text-[#a09c92]">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#efeee8]/60 dark:bg-[#242428]/60 border border-[#cfcdc4]/50 dark:border-[#3e3e44]/50 font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            AI Subject Isolation
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#efeee8]/60 dark:bg-[#242428]/60 border border-[#cfcdc4]/50 dark:border-[#3e3e44]/50 font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
            Censor Box Redaction
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#efeee8]/60 dark:bg-[#242428]/60 border border-[#cfcdc4]/50 dark:border-[#3e3e44]/50 font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-500"></span>
            100% In-Browser Privacy
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#efeee8]/60 dark:bg-[#242428]/60 border border-[#cfcdc4]/50 dark:border-[#3e3e44]/50 font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-[#E5A93C]"></span>
            Native Full HD Export
          </span>
        </div>
      </div>

      <!-- STATE 2: INTERACTIVE BLUR STUDIO VIEW (Initially Hidden) -->
      <div id="editor-view" class="hidden flex-col gap-4">
        <!-- Top Toolbar: Mode Selector & Status -->
        <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-3 pb-3 border-b border-[#e6e5e0] dark:border-[#2e2e33]">
          <!-- Mode Selector Tabs: 3 Modes -->
          <div class="flex items-center p-1 bg-[#efeee8] dark:bg-[#242428] rounded-xl border border-[#cfcdc4]/60 dark:border-[#3e3e44]/60 w-full lg:w-auto overflow-x-auto no-scrollbar">
            <button
              type="button"
              id="mode-portrait-btn"
              class="flex-1 sm:flex-initial flex items-center justify-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer bg-white dark:bg-[#1c1c1f] text-[#b47818] dark:text-[#E5A93C] shadow-xs border border-[#D49B28]/30 dark:border-[#E5A93C]/30 shrink-0"
            >
              <span>🎯</span>
              <span>Blur Background</span>
            </button>
            <button
              type="button"
              id="mode-censor-btn"
              class="flex-1 sm:flex-initial flex items-center justify-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-lg text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-all cursor-pointer shrink-0"
            >
              <span>🔲</span>
              <span>Censor Area / Box Blur</span>
            </button>
            <button
              type="button"
              id="mode-entire-btn"
              class="flex-1 sm:flex-initial flex items-center justify-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-lg text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-all cursor-pointer shrink-0"
            >
              <span>🌐</span>
              <span>Full Blur</span>
            </button>
          </div>

          <!-- Status & Metadata Badges -->
          <div class="flex items-center gap-2 self-end lg:self-center">
            <div id="status-pill" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-xs font-medium">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span id="status-text">Ready</span>
            </div>
            <span id="dimensions-badge" class="text-xs px-2.5 py-1 rounded-full bg-[#efeee8] dark:bg-[#242428] text-zinc-600 dark:text-zinc-400 font-mono border border-[#cfcdc4]/50 dark:border-[#3e3e44]/50">
              0 × 0 px
            </span>
          </div>
        </div>

        <!-- CENSOR MODE HELPER BAR (Only visible in censor mode) -->
        <div id="censor-controls-bar" class="hidden items-center justify-between p-2.5 px-3.5 rounded-xl bg-amber-500/10 dark:bg-amber-500/15 border border-[#D49B28]/30 dark:border-[#E5A93C]/30 text-xs text-[#b47818] dark:text-[#E5A93C]">
          <div class="flex items-center gap-2 font-medium">
            <span>💡</span>
            <span>Click & drag across sensitive text, faces, or numbers to draw censor blur boxes.</span>
          </div>
          <div class="flex items-center gap-2">
            <span id="censor-count-badge" class="font-mono text-[11px] px-2 py-0.5 rounded bg-white dark:bg-[#1c1c1f] border border-[#D49B28]/30 dark:border-[#E5A93C]/30 font-semibold">
              0 boxes
            </span>
            <button
              type="button"
              id="censor-undo-btn"
              class="px-2 py-0.5 rounded bg-white dark:bg-[#1c1c1f] border border-zinc-300 dark:border-zinc-700 hover:bg-zinc-50 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 text-[11px] font-medium cursor-pointer transition-all active:scale-95"
            >
              ↶ Undo
            </button>
            <button
              type="button"
              id="censor-clear-btn"
              class="px-2 py-0.5 rounded bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 hover:bg-rose-500/20 text-[11px] font-semibold cursor-pointer transition-all active:scale-95"
            >
              Clear All
            </button>
          </div>
        </div>

        <!-- Interactive Preview Stage with Before/After Split Viewer -->
        <div class="relative w-full rounded-xl overflow-hidden bg-checkerboard dark:bg-[#121212] border border-[#e6e5e0] dark:border-[#2e2e33] flex items-center justify-center min-h-[300px] sm:min-h-[440px] max-h-[580px] select-none shadow-inner">
          <!-- Canvas Container -->
          <div id="canvas-container" class="relative max-w-full max-h-[560px] flex items-center justify-center overflow-hidden touch-none">
            <!-- Main Render Canvas -->
            <canvas id="preview-canvas" class="max-w-full max-h-[560px] object-contain shadow-md block"></canvas>

            <!-- Censor Box Dragging Overlay Indicator -->
            <div
              id="censor-drag-box"
              class="hidden absolute border-2 border-dashed border-[#E5A93C] bg-[#E5A93C]/20 pointer-events-none z-20"
            ></div>

            <!-- Split Divider Line (Active in Split Comparison Mode) -->
            <div
              id="split-divider"
              class="hidden absolute top-0 bottom-0 w-0.5 bg-[#E5A93C] cursor-ew-resize z-20 pointer-events-auto"
              style="left: 50%;"
            >
              <!-- Divider Drag Handle -->
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-white dark:bg-[#1c1c1f] border-2 border-[#E5A93C] shadow-lg flex items-center justify-center text-[#E5A93C] text-xs font-bold pointer-events-none select-none">
                ⬌
              </div>
              <!-- Floating Pill Indicators -->
              <div class="absolute top-3 right-3 px-2 py-0.5 rounded bg-black/75 text-white text-[10px] font-mono whitespace-nowrap pointer-events-none">
                Processed
              </div>
              <div class="absolute top-3 left-3 -translate-x-full px-2 py-0.5 rounded bg-black/75 text-white text-[10px] font-mono whitespace-nowrap pointer-events-none">
                Original
              </div>
            </div>

            <!-- Subject Segmentation Progress Overlay (Non-blocking) -->
            <div
              id="segmentation-banner"
              class="hidden absolute bottom-3 left-1/2 -translate-x-1/2 z-30 px-3.5 py-1.5 rounded-full bg-black/80 backdrop-blur-md border border-[#E5A93C]/40 text-white text-xs font-medium flex items-center gap-2.5 shadow-xl transition-all"
            >
              <div class="w-3.5 h-3.5 border-2 border-[#E5A93C] border-t-transparent rounded-full animate-spin"></div>
              <span id="segmentation-banner-text">Isolating subject for portrait bokeh...</span>
              <div class="w-16 bg-white/20 h-1.5 rounded-full overflow-hidden">
                <div id="segmentation-progress-fill" class="bg-[#E5A93C] h-full w-1/3 transition-all duration-300"></div>
              </div>
            </div>
          </div>

          <!-- Quick Preview Controls (Top-right of Canvas) -->
          <div class="absolute top-3 right-3 z-20 flex items-center gap-1.5">
            <button
              type="button"
              id="split-toggle-btn"
              class="px-2.5 py-1 rounded-lg text-xs font-medium bg-black/70 hover:bg-black/90 text-white backdrop-blur-md border border-white/20 transition-all flex items-center gap-1.5 cursor-pointer shadow-md active:scale-95"
              title="Toggle interactive split comparison slider"
            >
              <svg class="w-3.5 h-3.5 text-[#E5A93C]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <line x1="12" y1="3" x2="12" y2="21"/>
              </svg>
              <span id="split-toggle-text">Split View</span>
            </button>

            <button
              type="button"
              id="hold-original-btn"
              class="px-2.5 py-1 rounded-lg text-xs font-medium bg-black/70 hover:bg-black/90 text-white backdrop-blur-md border border-white/20 transition-all flex items-center gap-1.5 cursor-pointer shadow-md select-none active:scale-95"
              title="Click or hold to view unblurred original photo"
            >
              <svg class="w-3.5 h-3.5 text-[#E5A93C]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              <span>View Original</span>
            </button>
          </div>
        </div>

        <!-- Controls Toolbar: Blur Intensity & Presets -->
        <div id="slider-container" class="p-4 sm:p-5 rounded-xl bg-[#f7f7f4] dark:bg-[#242428] border border-[#e6e5e0] dark:border-[#2e2e33] space-y-4">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <label for="blur-slider" class="text-xs sm:text-sm font-bold text-[#26251e] dark:text-white">
                Blur Intensity
              </label>
              <span id="aperture-label" class="text-xs text-[#5a5852] dark:text-[#a09c92] font-mono">
                (f/2.0 Realistic Bokeh)
              </span>
            </div>
            <div class="flex items-center gap-1.5">
              <span
                id="blur-display-val"
                class="px-2 py-0.5 rounded-md bg-white dark:bg-[#1c1c1f] border border-[#cfcdc4] dark:border-[#3e3e44] text-xs font-mono font-bold text-[#b47818] dark:text-[#E5A93C] shadow-xs"
              >
                12px
              </span>
            </div>
          </div>

          <!-- Range Slider -->
          <div class="space-y-1.5">
            <input
              type="range"
              id="blur-slider"
              min="0"
              max="40"
              step="1"
              value="12"
              class="w-full h-2.5 bg-zinc-300 dark:bg-zinc-700 rounded-lg appearance-none cursor-pointer accent-[#E5A93C]"
            />
            <div class="flex justify-between text-[10px] text-[#807d72] dark:text-[#706e68] font-mono px-0.5">
              <span>0px (Sharp)</span>
              <span>12px (DSLR Default)</span>
              <span>24px (Creamy)</span>
              <span>40px (Ultra)</span>
            </div>
          </div>

          <!-- Quick Presets Row -->
          <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-[#e6e5e0] dark:border-[#2e2e33]/70">
            <span class="text-xs font-medium text-[#5a5852] dark:text-[#a09c92] mr-1">Quick Presets:</span>
            <button
              type="button"
              data-preset="4"
              class="preset-btn px-2.5 py-1 rounded-md text-xs font-medium bg-white dark:bg-[#1c1c1f] text-[#26251e] dark:text-[#ededed] border border-[#cfcdc4] dark:border-[#3e3e44] hover:border-[#E5A93C] hover:text-[#b47818] dark:hover:text-[#E5A93C] transition-all cursor-pointer shadow-xs active:scale-95"
            >
              Subtle (4px)
            </button>
            <button
              type="button"
              data-preset="12"
              class="preset-btn px-2.5 py-1 rounded-md text-xs font-medium bg-amber-500/10 dark:bg-amber-500/15 text-[#b47818] dark:text-[#E5A93C] border border-[#D49B28]/40 dark:border-[#E5A93C]/40 font-semibold transition-all cursor-pointer shadow-xs active:scale-95"
            >
              Realistic Bokeh (12px)
            </button>
            <button
              type="button"
              data-preset="22"
              class="preset-btn px-2.5 py-1 rounded-md text-xs font-medium bg-white dark:bg-[#1c1c1f] text-[#26251e] dark:text-[#ededed] border border-[#cfcdc4] dark:border-[#3e3e44] hover:border-[#E5A93C] hover:text-[#b47818] dark:hover:text-[#E5A93C] transition-all cursor-pointer shadow-xs active:scale-95"
            >
              Portrait Pro (22px)
            </button>
            <button
              type="button"
              data-preset="36"
              class="preset-btn px-2.5 py-1 rounded-md text-xs font-medium bg-white dark:bg-[#1c1c1f] text-[#26251e] dark:text-[#ededed] border border-[#cfcdc4] dark:border-[#3e3e44] hover:border-[#E5A93C] hover:text-[#b47818] dark:hover:text-[#E5A93C] transition-all cursor-pointer shadow-xs active:scale-95"
            >
              Dreamy Blur (36px)
            </button>
          </div>
        </div>

        <!-- Clean Action Dock (Container Safe) -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-3 border-t border-[#e6e5e0] dark:border-[#2e2e33]">
          <!-- Left: Reset Button -->
          <button
            type="button"
            id="reset-btn"
