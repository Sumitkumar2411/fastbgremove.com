<!-- CLIENT-SIDE BLUR & CENSOR ENGINE SCRIPT -->
<script>
  interface CensorBox {
    x: number;
    y: number;
    w: number;
    h: number;
  }

  let originalFile: File | null = null;
  let originalImage: HTMLImageElement | null = null;
  let foregroundImage: HTMLImageElement | null = null;
  let currentMode: 'portrait' | 'censor' | 'entire' = 'portrait';
  let blurRadius: number = 12;
  let splitPercent: number = 50;
  let isSplitActive: boolean = false;
  let isHoldingOriginal: boolean = false;
  let isSegmenting: boolean = false;
  let segmentationDone: boolean = false;
  let isDraggingSplit: boolean = false;
  let censorBoxes: CensorBox[] = [];
  let isDrawingCensor: boolean = false;
  let censorStartX: number = 0;
  let censorStartY: number = 0;
  let censorCurrentX: number = 0;
  let censorCurrentY: number = 0;
  let rafId: number | null = null;

  // DOM Elements
  const uploadView = document.getElementById('upload-view') as HTMLDivElement;
  const editorView = document.getElementById('editor-view') as HTMLDivElement;
  const dropzone = document.getElementById('dropzone') as HTMLDivElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const samplePortraitBtn = document.getElementById('sample-portrait-btn') as HTMLButtonElement;
  const previewCanvas = document.getElementById('preview-canvas') as HTMLCanvasElement;
  const canvasContainer = document.getElementById('canvas-container') as HTMLDivElement;
  const censorDragBox = document.getElementById('censor-drag-box') as HTMLDivElement;
  const censorControlsBar = document.getElementById('censor-controls-bar') as HTMLDivElement;
  const censorCountBadge = document.getElementById('censor-count-badge') as HTMLSpanElement;
  const censorUndoBtn = document.getElementById('censor-undo-btn') as HTMLButtonElement;
  const censorClearBtn = document.getElementById('censor-clear-btn') as HTMLButtonElement;
  const splitDivider = document.getElementById('split-divider') as HTMLDivElement;
  const splitToggleBtn = document.getElementById('split-toggle-btn') as HTMLButtonElement;
  const splitToggleText = document.getElementById('split-toggle-text') as HTMLSpanElement;
  const holdOriginalBtn = document.getElementById('hold-original-btn') as HTMLButtonElement;
  const blurSlider = document.getElementById('blur-slider') as HTMLInputElement;
  const blurDisplayVal = document.getElementById('blur-display-val') as HTMLSpanElement;
  const apertureLabel = document.getElementById('aperture-label') as HTMLSpanElement;
  const modePortraitBtn = document.getElementById('mode-portrait-btn') as HTMLButtonElement;
  const modeCensorBtn = document.getElementById('mode-censor-btn') as HTMLButtonElement;
  const modeEntireBtn = document.getElementById('mode-entire-btn') as HTMLButtonElement;
  const statusPill = document.getElementById('status-pill') as HTMLDivElement;
  const statusText = document.getElementById('status-text') as HTMLSpanElement;
  const dimensionsBadge = document.getElementById('dimensions-badge') as HTMLSpanElement;
  const segmentationBanner = document.getElementById('segmentation-banner') as HTMLDivElement;
  const segmentationBannerText = document.getElementById('segmentation-banner-text') as HTMLSpanElement;
  const segmentationProgressFill = document.getElementById('segmentation-progress-fill') as HTMLDivElement;
  const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;
  const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;
  const exportFormat = document.getElementById('export-format') as HTMLSelectElement;
  const presetButtons = document.querySelectorAll('.preset-btn');

  // Aperture Text Mapping
  function getApertureDescription(radius: number): string {
    if (radius <= 2) return '(f/11 Sharp Focus)';
    if (radius <= 6) return '(f/4.0 Subtle Softness)';
    if (radius <= 14) return '(f/2.0 Realistic Bokeh)';
    if (radius <= 24) return '(f/1.4 Creamy Portrait)';
    return '(f/0.95 Dreamy Max)';
  }

  // Update Status Pill
  function setStatus(text: string, type: 'ready' | 'processing' | 'active' | 'warning' = 'ready') {
    if (!statusText || !statusPill) return;
    statusText.textContent = text;
    statusPill.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium';

    if (type === 'processing') {
      statusPill.classList.add('bg-amber-500/10', 'text-[#b47818]', 'dark:text-[#E5A93C]', 'border', 'border-[#D49B28]/30');
    } else if (type === 'active') {
      statusPill.classList.add('bg-emerald-500/10', 'text-emerald-600', 'dark:text-emerald-400', 'border', 'border-emerald-500/20');
    } else if (type === 'warning') {
      statusPill.classList.add('bg-rose-500/10', 'text-rose-600', 'dark:text-rose-400', 'border', 'border-rose-500/20');
    } else {
      statusPill.classList.add('bg-zinc-100', 'dark:bg-zinc-800', 'text-zinc-600', 'dark:text-zinc-400', 'border', 'border-zinc-200', 'dark:border-zinc-700');
    }
  }

  // Update Mode UI & Tabs Styling
  function updateModeUI() {
    const activeClass = 'flex-1 sm:flex-initial flex items-center justify-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer bg-white dark:bg-[#1c1c1f] text-[#b47818] dark:text-[#E5A93C] shadow-xs border border-[#D49B28]/30 dark:border-[#E5A93C]/30 shrink-0';
    const inactiveClass = 'flex-1 sm:flex-initial flex items-center justify-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-lg text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-all cursor-pointer shrink-0';

    modePortraitBtn.className = currentMode === 'portrait' ? activeClass : inactiveClass;
    modeCensorBtn.className = currentMode === 'censor' ? activeClass : inactiveClass;
    modeEntireBtn.className = currentMode === 'entire' ? activeClass : inactiveClass;

    if (currentMode === 'censor') {
      if (censorControlsBar) {
        censorControlsBar.classList.remove('hidden');
        censorControlsBar.classList.add('flex');
      }
      if (previewCanvas) previewCanvas.style.cursor = 'crosshair';
      updateCensorBadge();
      setStatus('Censor Mode: Drag on image', 'ready');
    } else {
      if (censorControlsBar) {
        censorControlsBar.classList.add('hidden');
        censorControlsBar.classList.remove('flex');
      }
      if (previewCanvas) previewCanvas.style.cursor = 'default';

      if (currentMode === 'portrait') {
        if (segmentationDone) {
          setStatus('Subject Protected (Bokeh)', 'active');
        } else if (isSegmenting) {
          setStatus('AI Isolating Subject...', 'processing');
        } else {
          setStatus('Portrait Mode', 'ready');
        }
      } else {
        setStatus('Full Image Blur', 'ready');
      }
    }
  }

  function updateCensorBadge() {
    if (censorCountBadge) {
      censorCountBadge.textContent = `${censorBoxes.length} box${censorBoxes.length === 1 ? '' : 'es'}`;
    }
  }

  // AI Foreground Segmentation with WebAssembly
  async function runAiSegmentation(file: File | Blob) {
    if (segmentationDone || isSegmenting) return;
    isSegmenting = true;
    updateModeUI();

    if (segmentationBanner) segmentationBanner.classList.remove('hidden');
    if (segmentationProgressFill) segmentationProgressFill.style.width = '20%';
    if (segmentationBannerText) segmentationBannerText.textContent = 'Isolating portrait subject...';

    try {
      const { removeBackground } = await import('@imgly/background-removal');
      const rawBlob = await removeBackground(file, {
        model: 'medium',
        output: {
          format: 'image/png',
          quality: 1.0,
          type: 'foreground'
        },
        progress: (_key: string, current: number, total: number) => {
          if (total > 0 && segmentationProgressFill) {
            const pct = Math.min(95, Math.round((current / total) * 100));
            segmentationProgressFill.style.width = `${pct}%`;
          }
        }
      });

      const fgImg = new Image();
      const fgUrl = URL.createObjectURL(rawBlob);
      fgImg.onload = () => {
        foregroundImage = fgImg;
        segmentationDone = true;
        isSegmenting = false;
        if (segmentationBanner) segmentationBanner.classList.add('hidden');
        updateModeUI();
        queueRender();
      };
      fgImg.onerror = () => {
        throw new Error('Failed to load cutout image');
      };
      fgImg.src = fgUrl;
    } catch (err) {
      console.warn('AI Segmentation error or fallback:', err);
      isSegmenting = false;
      if (segmentationBanner) segmentationBanner.classList.add('hidden');
      setStatus('Fallback: Blurring entire image', 'warning');
      currentMode = 'entire';
      updateModeUI();
      queueRender();
    }
  }

  // Load Image File into State
  function handleImageLoaded(file: File) {
    originalFile = file;
    segmentationDone = false;
    foregroundImage = null;
    censorBoxes = [];

    const reader = new FileReader();
    reader.onload = (e) => {
      const img = new Image();
      img.onload = () => {
        originalImage = img;
        if (dimensionsBadge) {
          dimensionsBadge.textContent = `${img.naturalWidth} × ${img.naturalHeight} px`;
        }

        // Show editor view, hide dropzone
        uploadView.classList.add('hidden');
        editorView.classList.remove('hidden');
        editorView.classList.add('flex');

        // Setup display canvas aspect ratio
        fitCanvasDimensions();
        updateModeUI();
        queueRender();

        // If in portrait mode, initiate client-side AI segmentation
        if (currentMode === 'portrait') {
          runAiSegmentation(file);
        }
      };
      img.src = e.target?.result as string;
    };
    reader.readAsDataURL(file);
  }

  // Calculate & Set Preview Canvas Dimensions
  function fitCanvasDimensions() {
    if (!originalImage || !previewCanvas) return;
    const naturalWidth = originalImage.naturalWidth;
    const naturalHeight = originalImage.naturalHeight;

    const maxPreviewWidth = 1400;
    const maxPreviewHeight = 900;
    let width = naturalWidth;
    let height = naturalHeight;

    if (width > maxPreviewWidth || height > maxPreviewHeight) {
      const ratio = Math.min(maxPreviewWidth / width, maxPreviewHeight / height);
      width = Math.round(width * ratio);
      height = Math.round(height * ratio);
    }

    previewCanvas.width = width;
    previewCanvas.height = height;
  }

  // Queue a canvas render using requestAnimationFrame
  function queueRender() {
    if (rafId) cancelAnimationFrame(rafId);
    rafId = requestAnimationFrame(() => {
      renderScene();
      rafId = null;
    });
  }

  // Core Canvas Rendering Engine
  function renderScene() {
    if (!originalImage || !previewCanvas) return;
    const ctx = previewCanvas.getContext('2d');
    if (!ctx) return;

    const W = previewCanvas.width;
    const H = previewCanvas.height;

    ctx.clearRect(0, 0, W, H);

    // CASE 1: User is holding "View Original" button
    if (isHoldingOriginal) {
      ctx.save();
      ctx.filter = 'none';
      ctx.drawImage(originalImage, 0, 0, W, H);
      ctx.restore();
      return;
    }

    // CASE 2: MODE-SPECIFIC RENDERING
    if (currentMode === 'portrait') {
      // 1. Draw Blurred Background Layer with Edge Bleed
      const bleed = Math.ceil(blurRadius * 2.5);
      ctx.save();
      ctx.beginPath();
      ctx.rect(0, 0, W, H);
      ctx.clip(); // Eliminate edge darkening artifact
      ctx.filter = blurRadius > 0 ? `blur(${blurRadius}px)` : 'none';
      ctx.drawImage(originalImage, -bleed, -bleed, W + bleed * 2, H + bleed * 2);
      ctx.restore();

      // 2. Draw Subject Sharp On Top
      if (foregroundImage) {
        ctx.save();
        ctx.filter = 'none';
        ctx.drawImage(foregroundImage, 0, 0, W, H);
        ctx.restore();
      }
    } else if (currentMode === 'censor') {
      // Draw sharp base image first
      ctx.save();
      ctx.filter = 'none';
      ctx.drawImage(originalImage, 0, 0, W, H);
      ctx.restore();

      // Render each censor blur box
      const censorBlur = Math.max(16, blurRadius > 0 ? blurRadius : 20);
      censorBoxes.forEach((box) => {
        if (box.w <= 0 || box.h <= 0) return;
        ctx.save();
        ctx.beginPath();
        ctx.rect(box.x, box.y, box.w, box.h);
        ctx.clip(); // Clip to the box

        // Draw blurred version inside the clipped box with bleed
        const bleed = Math.ceil(censorBlur * 2.5);
        ctx.filter = `blur(${censorBlur}px)`;
        ctx.drawImage(originalImage!, -bleed, -bleed, W + bleed * 2, H + bleed * 2);

        // Add subtle privacy border around censor box
        ctx.restore();
        ctx.save();
        ctx.strokeStyle = 'rgba(229, 169, 60, 0.4)';
        ctx.lineWidth = 1;
        ctx.strokeRect(box.x + 0.5, box.y + 0.5, box.w - 1, box.h - 1);
        ctx.restore();
      });
    } else {
      // Full image blur mode
      const bleed = Math.ceil(blurRadius * 2.5);
      ctx.save();
      ctx.beginPath();
      ctx.rect(0, 0, W, H);
      ctx.clip();
      ctx.filter = blurRadius > 0 ? `blur(${blurRadius}px)` : 'none';
      ctx.drawImage(originalImage, -bleed, -bleed, W + bleed * 2, H + bleed * 2);
      ctx.restore();
    }

    // CASE 3: Split Comparison Mode Active
    if (isSplitActive) {
      const splitX = Math.round((splitPercent / 100) * W);
      ctx.save();
      ctx.beginPath();
      ctx.rect(0, 0, splitX, H);
      ctx.clip();
      ctx.filter = 'none';
      ctx.drawImage(originalImage, 0, 0, W, H);
      ctx.restore();

      // Update split divider visual position
      if (splitDivider) {
        splitDivider.style.left = `${splitPercent}%`;
      }
    }
  }

  // Download Full Native Resolution Image
  function downloadFullHd() {
    if (!originalImage) return;

    const origW = originalImage.naturalWidth;
    const origH = originalImage.naturalHeight;
    const offscreen = document.createElement('canvas');
    offscreen.width = origW;
    offscreen.height = origH;
    const offCtx = offscreen.getContext('2d');
    if (!offCtx) return;

    const previewW = previewCanvas.width || origW;
    const previewH = previewCanvas.height || origH;
    const scaleFactorX = origW / previewW;
    const scaleFactorY = origH / previewH;
    const fullBlurRadius = Math.round(blurRadius * scaleFactorX);

    if (currentMode === 'portrait') {
      // 1. Draw full-res blurred background with edge bleed
      const bleed = Math.ceil(fullBlurRadius * 2.5);
      offCtx.save();
      offCtx.beginPath();
      offCtx.rect(0, 0, origW, origH);
      offCtx.clip();
      offCtx.filter = fullBlurRadius > 0 ? `blur(${fullBlurRadius}px)` : 'none';
      offCtx.drawImage(originalImage, -bleed, -bleed, origW + bleed * 2, origH + bleed * 2);
      offCtx.restore();

      // 2. Draw full-res sharp foreground
      if (foregroundImage) {
        offCtx.save();
        offCtx.filter = 'none';
        offCtx.drawImage(foregroundImage, 0, 0, origW, origH);
        offCtx.restore();
      }
    } else if (currentMode === 'censor') {
      // 1. Draw sharp full-res image
      offCtx.save();
      offCtx.filter = 'none';
      offCtx.drawImage(originalImage, 0, 0, origW, origH);
      offCtx.restore();

      // 2. Scale each censor box to full resolution and blur
      const censorFullBlur = Math.max(24, Math.round((blurRadius > 0 ? blurRadius : 20) * scaleFactorX));
      const bleed = Math.ceil(censorFullBlur * 2.5);

      censorBoxes.forEach((box) => {
        const sx = Math.round(box.x * scaleFactorX);
        const sy = Math.round(box.y * scaleFactorY);
        const sw = Math.round(box.w * scaleFactorX);
        const sh = Math.round(box.h * scaleFactorY);
        if (sw <= 0 || sh <= 0) return;

        offCtx.save();
        offCtx.beginPath();
        offCtx.rect(sx, sy, sw, sh);
        offCtx.clip();
        offCtx.filter = `blur(${censorFullBlur}px)`;
        offCtx.drawImage(originalImage!, -bleed, -bleed, origW + bleed * 2, origH + bleed * 2);
        offCtx.restore();
      });
    } else {
      // Full image blur
      const bleed = Math.ceil(fullBlurRadius * 2.5);
      offCtx.save();
      offCtx.beginPath();
      offCtx.rect(0, 0, origW, origH);
      offCtx.clip();
      offCtx.filter = fullBlurRadius > 0 ? `blur(${fullBlurRadius}px)` : 'none';
      offCtx.drawImage(originalImage, -bleed, -bleed, origW + bleed * 2, origH + bleed * 2);
      offCtx.restore();
    }

    const format = exportFormat ? exportFormat.value : 'png';
    const mimeType = format === 'jpeg' ? 'image/jpeg' : 'image/png';
    const extension = format === 'jpeg' ? 'jpg' : 'png';

    offscreen.toBlob(
      (blob) => {
        if (!blob) return;
        const link = document.createElement('a');
        link.download = `fastbgremove-${currentMode}-blurred-${Date.now()}.${extension}`;
        link.href = URL.createObjectURL(blob);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        setTimeout(() => URL.revokeObjectURL(link.href), 1000);
      },
      mimeType,
      0.95
    );
  }

  // Reset to Upload View
  function resetStudio() {
    originalFile = null;
    originalImage = null;
    foregroundImage = null;
    segmentationDone = false;
    isSegmenting = false;
    isSplitActive = false;
    censorBoxes = [];
    if (splitDivider) splitDivider.classList.add('hidden');
    if (splitToggleText) splitToggleText.textContent = 'Split View';
    if (editorView) editorView.classList.add('hidden');
    if (uploadView) uploadView.classList.remove('hidden');
    if (fileInput) fileInput.value = '';
    setStatus('Ready', 'ready');
  }

  // Censor Drag Selection Handlers
  function getCanvasCoords(clientX: number, clientY: number) {
    const rect = previewCanvas.getBoundingClientRect();
    const scaleX = previewCanvas.width / rect.width;
    const scaleY = previewCanvas.height / rect.height;
    const x = Math.max(0, Math.min(previewCanvas.width, (clientX - rect.left) * scaleX));
    const y = Math.max(0, Math.min(previewCanvas.height, (clientY - rect.top) * scaleY));
    return { x, y, rect };
  }

  function updateDragBoxDisplay(clientX: number, clientY: number) {
    if (!censorDragBox || !canvasContainer) return;
    const containerRect = canvasContainer.getBoundingClientRect();
    const currentContainerX = clientX - containerRect.left;
    const currentContainerY = clientY - containerRect.top;

    const left = Math.min(censorStartX, currentContainerX);
    const top = Math.min(censorStartY, currentContainerY);
    const width = Math.abs(currentContainerX - censorStartX);
    const height = Math.abs(currentContainerY - censorStartY);

    censorDragBox.style.left = `${left}px`;
    censorDragBox.style.top = `${top}px`;
    censorDragBox.style.width = `${width}px`;
    censorDragBox.style.height = `${height}px`;
  }

  // Event Listeners: Dropzone & File Input
  if (dropzone && fileInput) {
    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput.click();
      }
    });

    fileInput.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.files && target.files[0]) {
        handleImageLoaded(target.files[0]);
      }
    });

    ['dragenter', 'dragover'].forEach((eventName) => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropzone.classList.add('border-[#E5A93C]', 'bg-[#efeee8]/70', 'dark:bg-[#242428]/70');
      });
    });

    ['dragleave', 'drop'].forEach((eventName) => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropzone.classList.remove('border-[#E5A93C]', 'bg-[#efeee8]/70', 'dark:bg-[#242428]/70');
      });
    });

    dropzone.addEventListener('drop', (e) => {
      if (e.dataTransfer?.files && e.dataTransfer.files[0]) {
        handleImageLoaded(e.dataTransfer.files[0]);
      }
    });
  }

  // Sample Portrait Button
  if (samplePortraitBtn) {
    samplePortraitBtn.addEventListener('click', async () => {
      try {
        const response = await fetch('/samples/portrait.jpg');
        const blob = await response.blob();
        const file = new File([blob], 'portrait.jpg', { type: 'image/jpeg' });
        handleImageLoaded(file);
      } catch (err) {
        console.error('Failed to load sample image:', err);
      }
    });
  }

  // Global Paste Handler (Ctrl+V)
  window.addEventListener('paste', (e) => {
    const items = e.clipboardData?.items;
    if (!items) return;
    for (let i = 0; i < items.length; i++) {
      if (items[i].type.startsWith('image/')) {
        const file = items[i].getAsFile();
        if (file) {
          handleImageLoaded(file);
          break;
        }
      }
    }
  });

  // Slider Input Handler (Live Real-Time Blur)
  if (blurSlider) {
    blurSlider.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      blurRadius = parseInt(target.value, 10);
      if (blurDisplayVal) blurDisplayVal.textContent = `${blurRadius}px`;
      if (apertureLabel) apertureLabel.textContent = getApertureDescription(blurRadius);
      queueRender();
    });
  }

  // Quick Preset Buttons
  presetButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const val = parseInt(target.dataset.preset || '12', 10);
      blurRadius = val;
      if (blurSlider) blurSlider.value = val.toString();
      if (blurDisplayVal) blurDisplayVal.textContent = `${val}px`;
      if (apertureLabel) apertureLabel.textContent = getApertureDescription(val);
      queueRender();
    });
  });

  // Mode Tabs Switching
  if (modePortraitBtn) {
    modePortraitBtn.addEventListener('click', () => {
      if (currentMode === 'portrait') return;
      currentMode = 'portrait';
      updateModeUI();

      if (originalFile && !segmentationDone && !isSegmenting) {
        runAiSegmentation(originalFile);
      }
      queueRender();
    });
  }

  if (modeCensorBtn) {
    modeCensorBtn.addEventListener('click', () => {
      if (currentMode === 'censor') return;
      currentMode = 'censor';
      updateModeUI();
      queueRender();
    });
  }

  if (modeEntireBtn) {
    modeEntireBtn.addEventListener('click', () => {
      if (currentMode === 'entire') return;
      currentMode = 'entire';
      updateModeUI();
      queueRender();
    });
  }

  // Censor Actions: Clear & Undo
  if (censorClearBtn) {
    censorClearBtn.addEventListener('click', () => {
      censorBoxes = [];
      updateCensorBadge();
      queueRender();
    });
  }

  if (censorUndoBtn) {
    censorUndoBtn.addEventListener('click', () => {
      censorBoxes.pop();
      updateCensorBadge();
      queueRender();
    });
  }

  // Canvas Mouse & Touch Interactions for Split Slider AND Censor Box Drawing
  if (canvasContainer) {
    canvasContainer.addEventListener('pointerdown', (e) => {
      if (isSplitActive) {
        isDraggingSplit = true;
        handleSplitMove(e.clientX);
        return;
      }

      if (currentMode === 'censor' && previewCanvas) {
        isDrawingCensor = true;
        const coords = getCanvasCoords(e.clientX, e.clientY);
        censorCurrentX = coords.x;
        censorCurrentY = coords.y;

        const containerRect = canvasContainer.getBoundingClientRect();
        censorStartX = e.clientX - containerRect.left;
        censorStartY = e.clientY - containerRect.top;

        if (censorDragBox) {
          censorDragBox.style.left = `${censorStartX}px`;
          censorDragBox.style.top = `${censorStartY}px`;
          censorDragBox.style.width = '0px';
          censorDragBox.style.height = '0px';
          censorDragBox.classList.remove('hidden');
        }
      }
    });

    window.addEventListener('pointermove', (e) => {
      if (isDraggingSplit && isSplitActive) {
        handleSplitMove(e.clientX);
      } else if (isDrawingCensor && currentMode === 'censor') {
        updateDragBoxDisplay(e.clientX, e.clientY);
      }
    });

    window.addEventListener('pointerup', (e) => {
      if (isDraggingSplit) {
        isDraggingSplit = false;
      }

      if (isDrawingCensor && currentMode === 'censor') {
        isDrawingCensor = false;
        if (censorDragBox) censorDragBox.classList.add('hidden');

        const coords = getCanvasCoords(e.clientX, e.clientY);
        const x1 = censorCurrentX;
        const y1 = censorCurrentY;
        const x2 = coords.x;
        const y2 = coords.y;

        const boxX = Math.round(Math.min(x1, x2));
        const boxY = Math.round(Math.min(y1, y2));
        const boxW = Math.round(Math.abs(x2 - x1));
        const boxH = Math.round(Math.abs(y2 - y1));

        // Add box if at least 8x8 pixels
        if (boxW >= 8 && boxH >= 8) {
          censorBoxes.push({ x: boxX, y: boxY, w: boxW, h: boxH });
          updateCensorBadge();
          queueRender();
        }
      }
    });
  }

  function handleSplitMove(clientX: number) {
    if (!isSplitActive) return;
    const rect = previewCanvas.getBoundingClientRect();
    if (rect.width === 0) return;
    const offsetX = clientX - rect.left;
    const pct = Math.max(0, Math.min(100, (offsetX / rect.width) * 100));
    splitPercent = pct;
    queueRender();
  }

  // Split Comparison Slider Toggle
  if (splitToggleBtn) {
    splitToggleBtn.addEventListener('click', () => {
      isSplitActive = !isSplitActive;
      if (isSplitActive) {
        if (splitDivider) splitDivider.classList.remove('hidden');
        if (splitToggleText) splitToggleText.textContent = 'Exit Split';
      } else {
        if (splitDivider) splitDivider.classList.add('hidden');
        if (splitToggleText) splitToggleText.textContent = 'Split View';
      }
      queueRender();
    });
  }

  // Hold to View Original
  if (holdOriginalBtn) {
    const startHolding = () => {
      isHoldingOriginal = true;
      queueRender();
    };
    const stopHolding = () => {
      isHoldingOriginal = false;
      queueRender();
    };

    holdOriginalBtn.addEventListener('mousedown', startHolding);
    holdOriginalBtn.addEventListener('mouseup', stopHolding);
    holdOriginalBtn.addEventListener('mouseleave', stopHolding);
    holdOriginalBtn.addEventListener('touchstart', (e) => {
      e.preventDefault();
      startHolding();
    });
    holdOriginalBtn.addEventListener('touchend', stopHolding);
  }

  // Action Dock Buttons
  if (resetBtn) resetBtn.addEventListener('click', resetStudio);
  if (downloadBtn) downloadBtn.addEventListener('click', downloadFullHd);

  // Resize Listener
  window.addEventListener('resize', () => {
    if (originalImage && !uploadView.classList.contains('hidden')) {
      fitCanvasDimensions();
      queueRender();
    }
  });
</script>
