    </section>

    <!-- SECTION 4: Frequently Asked Questions (FAQ) -->
    <section class="space-y-6 pt-4">
      <div class="text-center space-y-2 mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#E5A93C]/10 border border-[#E5A93C]/20 text-xs font-semibold text-[#b47818] dark:text-[#E5A93C] font-mono">
          <span class="w-1.5 h-1.5 rounded-full bg-[#E5A93C]"></span>
          <span>Help & Instant Answers</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
          Frequently Asked Questions (FAQ)
        </h2>
        <p class="text-sm text-zinc-600 dark:text-[#A7A7A7] max-w-2xl mx-auto">
          Everything you need to know about creating custom cutout stickers, WhatsApp chat stickers, and transparent PNGs directly in your browser.
        </p>
      </div>

      <FaqAccordion items={faqs} />
    </section>
  </article>
</BaseLayout>
