---
import BaseLayout from '../layouts/BaseLayout.astro';
import BgRemover from '../components/BgRemover.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const pageTitle = "Free Photo Sticker Maker Online — Create Custom Cutout & WhatsApp Stickers";
const pageDescription = "Turn any photo into custom cutout stickers with white borders in seconds. 100% free, in-browser background removal with Die-cut, Circle, Square frames, and WhatsApp 512x512 export.";
const canonicalPath = "/sticker-maker";

const appComparison = [
  {
    feature: "App Installation",
    fastbg: "None (Zero storage used)",
    traditional: "Requires 50MB+ download"
  },
  {
    feature: "Privacy",
    fastbg: "100% Local in Browser",
    traditional: "Uploads photos to third-party clouds"
  },
  {
    feature: "Ads & Popups",
    fastbg: "Clean, Zero Interruptions",
    traditional: "Video ads before every export"
  },
  {
    feature: "Quality & Specs",
    fastbg: "True 512x512 with outline",
    traditional: "Downscaled, blurry compression"
  }
];

const stickerDimensions = [
  {
    platform: "WhatsApp Stickers",
    resolution: "512 × 512 px (Square)",
    format: "Transparent PNG / WebP",
    sizeLimit: "< 100 KB per sticker",
    safetyPadding: "16 px safety margin",
    useCase: "Personal chats, WhatsApp sticker packs, community stickers"
  },
  {
    platform: "Discord Custom Stickers",
    resolution: "320 × 320 px (Square)",
    format: "Transparent PNG / APNG",
    sizeLimit: "< 512 KB per sticker",
    safetyPadding: "8 px margin recommended",
    useCase: "Server custom stickers, Nitro emotes, thread reactions"
  },
  {
    platform: "Telegram Stickers",
    resolution: "512 × 512 px (Max)",
    format: "Transparent PNG / WebP",
    sizeLimit: "< 512 KB per sticker",
    safetyPadding: "One side 512px, other ≤ 512px",
    useCase: "Public sticker sets via @Stickers bot, custom emoji packs"
  },
  {
    platform: "Printable Die-Cut Vinyl",
    resolution: "Original HD (300+ DPI)",
    format: "Lossless PNG",
    sizeLimit: "No limit (Full resolution)",
    safetyPadding: "2-4 mm white die-cut bleed",
    useCase: "Cricut, Silhouette vinyl cutters, laptop stickers, merchandise"
  }
];

const faqs = [
  {
    question: "How to convert a photo to a sticker online for free?",
    answer: "Drop any PNG, JPG, or WebP photo into the tool. The client-side engine isolates your subject, applies a custom white outline border, and provides an instant free high-resolution download with no signup required."
  },
  {
    question: "Can I use this as an image to sticker converter online free for WhatsApp?",
    answer: "Yes. FastBgRemove formats stickers to the official 512x512 pixels requirement in transparent PNG format with file sizes safely under 100KB, making them immediately compatible with WhatsApp and Discord chat stickers."
  },
  {
    question: "How do I make custom stickers without installing an app?",
    answer: "FastBgRemove operates 100% inside your web browser. You do not need to download third-party mobile apps or APKs from the Play Store. Everything processes locally on your device for zero-data latency and complete privacy."
  },
  {
    question: "What shapes and border styles are available?",
    answer: "You can select between Die-Cut (silhouette outline), Circle badges, Square frames, and Rounded rectangles, with a customizable stroke thickness slider (0px to 32px) and multi-color swatches."
  },
  {
    question: "Is there an export limit or watermark on downloaded stickers?",
    answer: "No. All photo stickers download in full HD resolution with zero watermarks, zero subscription fees, and unlimited exports."
  }
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "FastBgRemove Online Photo Sticker Maker",
  "url": "https://fastbgremove.com/sticker-maker",
  "applicationCategory": "DesignApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires WebAssembly & HTML5 Canvas support",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": pageDescription,
  "featureList": [
    "Online photo to custom cutout sticker maker",
    "Zero app download (100% in-browser HTML5 Canvas engine)",
    "Automatic client-side background removal",
    "Multiple frame shapes: Die-Cut contour, Circular badge, Square, and Rounded rectangle",
    "Adjustable white die-cut border outline (0-32px)",
    "Draggable text caption studio with custom typography and contrasting stroke",
    "Compliant 512x512 WhatsApp sticker export with 16px safety padding",
    "Full original resolution HD sticker export for vinyl cutting and high-res printing",
    "100% client-side privacy with zero server uploads"
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  structuredData={[softwareSchema, faqSchema]}
>
  <!-- Hero Section & In-Browser Sticker Engine -->
  <BgRemover
    heading="Online Photo Sticker Maker"
    subheading="Create custom cutout stickers with clean white borders instantly. 100% private, free, and optimized for WhatsApp, Discord, or print ready HD PNG."
    defaultMode="sticker"
  />

  <!-- High-Trust Keyword Feature Badges Row -->
  <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 my-6 sm:my-8 max-w-4xl mx-auto px-4">
    <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] text-xs font-semibold text-[#26251e] dark:text-[#ededed] shadow-xs">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
      <span>✂️ Die-Cut Outline</span>
    </div>
    <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] text-xs font-semibold text-[#26251e] dark:text-[#ededed] shadow-xs">
      <span class="w-1.5 h-1.5 rounded-full bg-[#E5A93C]"></span>
      <span>⚪ Circle & Square Frames</span>
    </div>
    <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] text-xs font-semibold text-[#26251e] dark:text-[#ededed] shadow-xs">
      <span class="w-1.5 h-1.5 rounded-full bg-[#25D366]"></span>
      <span>💬 WhatsApp 512x512 Ready</span>
    </div>
    <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] text-xs font-semibold text-[#26251e] dark:text-[#ededed] shadow-xs">
      <span class="w-1.5 h-1.5 rounded-full bg-cyan-500"></span>
      <span>🔒 100% In-Browser Private</span>
    </div>
  </div>

  <!-- Semantic SEO Guide: How It Works & Specs -->
  <section class="mt-14 sm:mt-20 pt-12 border-t border-zinc-200 dark:border-[#232326] max-w-5xl mx-auto px-4">
    <!-- 3-Step Feature Cards -->
    <div class="max-w-3xl mx-auto text-center mb-12 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#E5A93C]/10 border border-[#E5A93C]/20 text-xs font-semibold text-[#b47818] dark:text-[#E5A93C] font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-[#E5A93C]"></span>
        <span>Zero-Lag Canvas 2D Engine</span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
        Convert Any Photo to a Custom Sticker in 3 Steps
      </h2>
      <p class="text-sm sm:text-base text-zinc-600 dark:text-[#A7A7A7] max-w-2xl mx-auto leading-relaxed">
        Create physical sticker pack cutouts, Discord reaction stickers, or WhatsApp chat stickers directly in your browser without Photoshop or Illustrator.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      <div class="p-6 rounded-lg bg-white dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] shadow-xs relative">
        <div class="absolute -top-[1px] -left-[1px] w-2 h-2 rounded-tl-lg bg-[#E5A93C]"></div>
        <div class="w-10 h-10 rounded-md bg-[#E5A93C]/10 border border-[#E5A93C]/20 flex items-center justify-center text-[#E5A93C] font-bold text-sm mb-4">
          01
        </div>
        <h3 class="text-base font-bold text-[#26251e] dark:text-white mb-2">
          Drop or Paste Any Photo
        </h3>
        <p class="text-xs sm:text-sm text-[#5a5852] dark:text-[#a09c92] leading-relaxed">
          Upload selfies, pet portraits, product shots, or illustrations. Our WebAssembly neural engine isolates foreground subjects locally in under 3 seconds.
        </p>
      </div>

      <div class="p-6 rounded-lg bg-white dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] shadow-xs relative">
        <div class="absolute -top-[1px] -left-[1px] w-2 h-2 rounded-tl-lg bg-[#E5A93C]"></div>
        <div class="w-10 h-10 rounded-md bg-[#E5A93C]/10 border border-[#E5A93C]/20 flex items-center justify-center text-[#E5A93C] font-bold text-sm mb-4">
          02
        </div>
        <h3 class="text-base font-bold text-[#26251e] dark:text-white mb-2">
          Pick Shape, Border & Caption
        </h3>
        <p class="text-xs sm:text-sm text-[#5a5852] dark:text-[#a09c92] leading-relaxed">
          Switch between Die-Cut contour, Circular badge, or Rounded frames. Adjust outline thickness (0-32px), select swatch colors, and stamp anchored text captions.
        </p>
      </div>

      <div class="p-6 rounded-lg bg-white dark:bg-[#1c1c1f] border border-[#e6e5e0] dark:border-[#2e2e33] shadow-xs relative">
        <div class="absolute -top-[1px] -left-[1px] w-2 h-2 rounded-tl-lg bg-[#E5A93C]"></div>
        <div class="w-10 h-10 rounded-md bg-[#E5A93C]/10 border border-[#E5A93C]/20 flex items-center justify-center text-[#E5A93C] font-bold text-sm mb-4">
          03
        </div>
        <h3 class="text-base font-bold text-[#26251e] dark:text-white mb-2">
          Download 512×512 or HD
        </h3>
        <p class="text-xs sm:text-sm text-[#5a5852] dark:text-[#a09c92] leading-relaxed">
          One-click download as an official 512×512 WhatsApp sticker with 16px safety padding, or export the lossless Full HD PNG for vinyl cutting and high-res print.
        </p>
      </div>
    </div>

    <!-- SPECS & WORKFLOW COMPARISON SECTION: Why Make Stickers Online vs Mobile Apps -->
    <div class="max-w-3xl mx-auto text-center mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#25D366]/10 border border-[#25D366]/20 text-xs font-semibold text-[#128C7E] dark:text-[#25D366] font-mono mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-[#25D366]"></span>
        <span>The Smarter Way to Make Stickers</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">
        Why Make Stickers Online vs Mobile Apps
      </h2>
      <p class="text-xs sm:text-sm text-zinc-500 dark:text-[#A7A7A7] mt-1.5">
        See how fastbgremove.com delivers superior speed, privacy, and output quality compared to traditional Play Store & App Store sticker apps.
      </p>
    </div>

    <div class="w-full overflow-x-auto rounded-lg border border-[#e6e5e0] dark:border-[#2e2e33] bg-white dark:bg-[#1c1c1f] shadow-xs relative mb-16">
      <div class="absolute -top-[1px] -left-[1px] w-2.5 h-2.5 rounded-tl-lg bg-[#E5A93C]"></div>
      <table class="w-full text-left text-sm border-collapse font-sans">
        <thead>
          <tr class="border-b border-[#e6e5e0] dark:border-[#2e2e33] bg-[#f7f7f4] dark:bg-[#121212]">
            <th class="p-3.5 sm:p-4 font-semibold text-[#26251e] dark:text-white w-1/3">Feature</th>
            <th class="p-3.5 sm:p-4 font-bold text-[#26251e] dark:text-white bg-[#E5A93C]/10 dark:bg-[#E5A93C]/15 border-x border-[#e6e5e0] dark:border-[#2e2e33] w-1/3">
              <div class="flex items-center gap-1.5">
                <span>FastBgRemove (In-Browser)</span>
                <span class="text-[10px] font-mono uppercase px-1.5 py-0.5 rounded bg-[#E5A93C] text-black font-extrabold">Best</span>
              </div>
            </th>
            <th class="p-3.5 sm:p-4 font-semibold text-[#807d72] dark:text-[#a09c92] w-1/3">Traditional Sticker Apps</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#e6e5e0] dark:divide-[#2e2e33]">
          {appComparison.map((row) => (
            <tr class="hover:bg-[#f7f7f4]/80 dark:hover:bg-[#242428]/40 transition-colors">
              <td class="p-3.5 sm:p-4 font-semibold text-[#26251e] dark:text-[#ededed]">
                {row.feature}
              </td>
              <td class="p-3.5 sm:p-4 font-semibold text-[#26251e] dark:text-white bg-[#E5A93C]/5 dark:bg-[#E5A93C]/10 border-x border-[#e6e5e0] dark:border-[#2e2e33]">
                <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-medium">
                  <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span>{row.fastbg}</span>
                </div>
              </td>
              <td class="p-3.5 sm:p-4 text-[#807d72] dark:text-[#a09c92]">
                <div class="flex items-center gap-2 text-zinc-500 dark:text-zinc-400">
                  <svg class="w-4 h-4 shrink-0 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                  </svg>
                  <span>{row.traditional}</span>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Official Sticker Dimension Specification Table -->
    <div class="max-w-3xl mx-auto text-center mb-8">
      <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-white">
        Official Sticker Dimension & Format Guide
      </h3>
      <p class="text-xs sm:text-sm text-zinc-500 dark:text-[#A7A7A7] mt-1.5">
        Recommended canvas dimensions, file size limits, and safety padding rules for major messaging apps and print workflows.
      </p>
    </div>

    <div class="w-full overflow-x-auto rounded-lg border border-[#e6e5e0] dark:border-[#2e2e33] bg-white dark:bg-[#1c1c1f] shadow-xs relative mb-16">
      <div class="absolute -top-[1px] -left-[1px] w-2.5 h-2.5 rounded-tl-lg bg-[#E5A93C]"></div>
      <table class="w-full text-left text-sm border-collapse font-sans">
        <thead>
          <tr class="border-b border-[#e6e5e0] dark:border-[#2e2e33] bg-[#f7f7f4] dark:bg-[#121212]">
            <th class="p-3.5 sm:p-4 font-semibold text-[#26251e] dark:text-white">Platform / Target</th>
            <th class="p-3.5 sm:p-4 font-bold text-[#26251e] dark:text-white bg-[#E5A93C]/10 dark:bg-[#E5A93C]/15 border-x border-[#e6e5e0] dark:border-[#2e2e33]">Resolution</th>
            <th class="p-3.5 sm:p-4 font-semibold text-[#26251e] dark:text-white">Format</th>
            <th class="p-3.5 sm:p-4 font-semibold text-[#26251e] dark:text-white">Size Limit</th>
            <th class="p-3.5 sm:p-4 font-semibold text-[#807d72] dark:text-[#a09c92]">Safety Margin</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#e6e5e0] dark:divide-[#2e2e33]">
          {stickerDimensions.map((spec) => (
            <tr class="hover:bg-[#f7f7f4]/80 dark:hover:bg-[#242428]/40 transition-colors">
              <td class="p-3.5 sm:p-4 font-semibold text-[#26251e] dark:text-[#ededed]">
                <div>{spec.platform}</div>
                <div class="text-[11px] text-[#807d72] dark:text-[#706e68] font-normal mt-0.5">{spec.useCase}</div>
              </td>
              <td class="p-3.5 sm:p-4 text-[#26251e] dark:text-[#ededed] bg-[#E5A93C]/5 dark:bg-[#E5A93C]/10 border-x border-[#e6e5e0] dark:border-[#2e2e33] font-mono font-semibold text-xs sm:text-sm">
                {spec.resolution}
              </td>
              <td class="p-3.5 sm:p-4 text-[#5a5852] dark:text-[#a09c92] font-mono text-xs">{spec.format}</td>
              <td class="p-3.5 sm:p-4 text-[#5a5852] dark:text-[#a09c92] font-mono text-xs">{spec.sizeLimit}</td>
              <td class="p-3.5 sm:p-4 text-[#5a5852] dark:text-[#a09c92] text-xs">{spec.safetyPadding}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Targeted FAQ Section with JSON-LD Schema -->
    <div class="max-w-3xl mx-auto space-y-6 pt-4">
      <div class="text-center space-y-2 mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">
          Frequently Asked Questions
        </h2>
        <p class="text-sm text-zinc-600 dark:text-[#A7A7A7]">
          Everything you need to know about creating custom cutout stickers and WhatsApp stickers online.
        </p>
      </div>

      <FaqAccordion items={faqs} />
    </div>
  </section>
</BaseLayout>
