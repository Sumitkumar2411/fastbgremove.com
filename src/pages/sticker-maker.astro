                <td class="p-3.5 sm:p-4 font-semibold text-[#26251e] dark:text-white bg-[#E5A93C]/5 dark:bg-[#E5A93C]/10 border-x border-[#e6e5e0] dark:border-[#2e2e33]">
                  <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400">
                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    <span>{row.fastbg}</span>
                  </div>
                </td>
                <td class="p-3.5 sm:p-4 text-[#807d72] dark:text-[#a09c92]">
                  <div class="flex items-center gap-1.5 text-zinc-500 dark:text-zinc-400">
                    <svg class="w-3.5 h-3.5 shrink-0 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <line x1="18" y1="6" x2="6" y2="18"/>
                      <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                    <span>{row.photoroom}</span>
                  </div>
                </td>
                <td class="p-3.5 sm:p-4 text-[#807d72] dark:text-[#a09c92]">
                  <div class="flex items-center gap-1.5 text-zinc-500 dark:text-zinc-400">
                    <svg class="w-3.5 h-3.5 shrink-0 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <line x1="18" y1="6" x2="6" y2="18"/>
                      <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                    <span>{row.kapwing}</span>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
