              <th class="p-3.5 sm:p-4 font-bold text-[#26251e] dark:text-white bg-[#E5A93C]/10 dark:bg-[#E5A93C]/15 border-x border-[#e6e5e0] dark:border-[#2e2e33] w-1/3">
                <div class="flex items-center gap-1.5">
                  <span>FastBgRemove Studio</span>
                  <span class="text-[10px] font-mono uppercase px-1.5 py-0.5 rounded bg-[#E5A93C] text-black font-extrabold">Winner</span>
                </div>
              </th>
              <th class="p-3.5 sm:p-4 font-semibold text-[#807d72] dark:text-[#a09c92] w-1/5">Photoroom</th>
